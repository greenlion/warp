SET SESSION use_secondary_engine = FORCED;
SELECT c.id, c.name, o.id AS oid, o.amount FROM c LEFT JOIN o ON o.c_id = c.id ORDER BY c.id, o.id;
id	name	oid	amount
1	ann	10	15
1	ann	11	250
2	bob	12	99
3	cy	NULL	NULL
4	dee	NULL	NULL
EXPLAIN SELECT c.id, c.name, o.id AS oid, o.amount FROM c LEFT JOIN o ON o.c_id = c.id;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	c	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using secondary engine RAPID
1	SIMPLE	o	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using where; Using join buffer (hash join); Using secondary engine RAPID
Warnings:
Note	1003	/* select#1 */ select `test`.`c`.`id` AS `id`,`test`.`c`.`name` AS `name`,`test`.`o`.`id` AS `oid`,`test`.`o`.`amount` AS `amount` from `test`.`c` left join `test`.`o` on((`test`.`o`.`c_id` = `test`.`c`.`id`)) where true
SET SESSION use_secondary_engine = DEFAULT;
ALTER TABLE c SECONDARY_UNLOAD;
ALTER TABLE o SECONDARY_UNLOAD;
ALTER TABLE p SECONDARY_UNLOAD;
DROP TABLE queries, c, o, p;
