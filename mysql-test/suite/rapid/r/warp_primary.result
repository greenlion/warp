5	500	312500.00	2024-01-06	n995
6	500	312625.00	2024-01-07	n996
7	500	312750.00	2024-01-08	n997
8	500	312875.00	2024-01-09	n998
9	500	313000.00	2024-01-10	n999
SELECT COUNT(*), SUM(id), SUM(amount) FROM w WHERE d >= '2024-06-01' AND grp IN (1, 3, 5);
COUNT(*)	SUM(id)	SUM(amount)
