#
# A WARP table with the secondary engine RAPID: SECONDARY_ENGINE at CREATE
# and with ALTER TABLE (which does not copy the table), SECONDARY_LOAD,
# queries in the secondary engine, changes through the binary log,
# SECONDARY_UNLOAD.
#
SET SESSION cte_max_recursion_depth = 100000;
CREATE TABLE w (id INT PRIMARY KEY, grp INT, name VARCHAR(20), amount DECIMAL(10,2), d DATE)
ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO w WITH RECURSIVE seq(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM seq WHERE x < 5000)
SELECT x, x % 10, CONCAT('n', x), x / 4, DATE_ADD('2024-01-01', INTERVAL x % 300 DAY) FROM seq;
# the attribute is a change of the data dictionary only
ALTER TABLE w SECONDARY_ENGINE = RAPID, ALGORITHM = INSTANT;
SHOW CREATE TABLE w;
Table	Create Table
w	CREATE TABLE `w` (
  `id` int NOT NULL,
  `grp` int DEFAULT NULL,
  `name` varchar(20) COLLATE utf8mb4_bin DEFAULT NULL,
  `amount` decimal(10,2) DEFAULT NULL,
  `d` date DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin SECONDARY_ENGINE=RAPID
ALTER TABLE w SECONDARY_LOAD;
# in the secondary engine
SET SESSION use_secondary_engine = FORCED;
EXPLAIN SELECT grp, COUNT(*) AS n, SUM(amount) AS s, MIN(d) AS first_d, MAX(name) AS last_name FROM w GROUP BY grp ORDER BY grp;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	w	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using temporary; Using filesort; Using secondary engine RAPID
Warnings:
Note	1003	/* select#1 */ select `test`.`w`.`grp` AS `grp`,count(0) AS `n`,sum(`test`.`w`.`amount`) AS `s`,min(`test`.`w`.`d`) AS `first_d`,max(`test`.`w`.`name`) AS `last_name` from `test`.`w` group by `test`.`w`.`grp` order by `test`.`w`.`grp`
SELECT grp, COUNT(*) AS n, SUM(amount) AS s, MIN(d) AS first_d, MAX(name) AS last_name FROM w GROUP BY grp ORDER BY grp;
grp	n	s	first_d	last_name
