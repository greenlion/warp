# changes of the WARP table come through the binary log
INSERT INTO w VALUES (6001, 1, 'new', 1000.50, '2025-01-01'), (6002, 3, 'new2', 0.25, '2025-01-02');
UPDATE w SET amount = amount + 1 WHERE grp = 5;
DELETE FROM w WHERE id BETWEEN 10 AND 19;
BEGIN;
INSERT INTO w VALUES (7001, 1, 'rolled back', 1, '2025-01-01');
ROLLBACK;
SET SESSION use_secondary_engine = FORCED;
SELECT grp, COUNT(*) AS n, SUM(amount) AS s, MIN(d) AS first_d, MAX(name) AS last_name FROM w GROUP BY grp ORDER BY grp;
