#
# A TIMESTAMP is a point in time.  The rows that ALTER TABLE ...
# SECONDARY_LOAD copies and the rows that come through the binary log
# must be the same points in time, whatever the time zone of the session
# that loads the table or reads it: the secondary engine returns what
# the table returns.
#
CREATE TABLE t (id INT PRIMARY KEY, ts TIMESTAMP NULL, ts6 TIMESTAMP(6) NULL, dt DATETIME)
SECONDARY_ENGINE RAPID;
# loaded by a session of another time zone than the server
SET SESSION time_zone = '-07:00';
INSERT INTO t VALUES (1, '2024-06-15 10:30:45', '2024-06-15 10:30:45.123456', '2024-06-15 10:30:45'),
(2, NULL, NULL, NULL);
ALTER TABLE t SECONDARY_LOAD;
# through the binary log, written by sessions of three time zones
INSERT INTO t VALUES (3, '2025-12-25 23:59:59', '2025-12-25 23:59:59.000001', '2025-12-25 23:59:59');
SET SESSION time_zone = '+00:00';
INSERT INTO t VALUES (4, '2025-12-25 23:59:59', '2025-12-25 23:59:59.999999', '2025-12-25 23:59:59');
SET SESSION time_zone = DEFAULT;
INSERT INTO t VALUES (5, '2025-12-25 23:59:59', '2025-12-25 23:59:59.5', '2025-12-25 23:59:59');
UPDATE t SET ts = '2001-02-03 04:05:06' WHERE id = 1;
SET SESSION time_zone = DEFAULT;
SELECT id, ts, ts6, dt, UNIX_TIMESTAMP(ts) AS seconds, UNIX_TIMESTAMP(ts6) AS seconds6 FROM r_secondary ORDER BY id;
id	ts	ts6	dt	seconds	seconds6
1	2001-02-03 04:05:06	2024-06-15 20:30:45.123456	2024-06-15 10:30:45	981162306	1718472645.123456
2	NULL	NULL	NULL	NULL	NULL
3	2025-12-26 09:59:59	2025-12-26 09:59:59.000001	2025-12-25 23:59:59	1766732399	1766732399.000001
4	2025-12-26 02:59:59	2025-12-26 02:59:59.999999	2025-12-25 23:59:59	1766707199	1766707199.999999
5	2025-12-25 23:59:59	2025-12-25 23:59:59.500000	2025-12-25 23:59:59	1766696399	1766696399.500000
SELECT COUNT(*) AS different_rows FROM
((SELECT * FROM r_primary EXCEPT SELECT * FROM r_secondary) UNION ALL
(SELECT * FROM r_secondary EXCEPT SELECT * FROM r_primary)) d;
different_rows
0
DROP TABLE r_primary, r_secondary;
SET SESSION time_zone = '+00:00';
SELECT id, ts, ts6, dt, UNIX_TIMESTAMP(ts) AS seconds, UNIX_TIMESTAMP(ts6) AS seconds6 FROM r_secondary ORDER BY id;
id	ts	ts6	dt	seconds	seconds6
1	2001-02-03 01:05:06	2024-06-15 17:30:45.123456	2024-06-15 10:30:45	981162306	1718472645.123456
2	NULL	NULL	NULL	NULL	NULL
3	2025-12-26 06:59:59	2025-12-26 06:59:59.000001	2025-12-25 23:59:59	1766732399	1766732399.000001
4	2025-12-25 23:59:59	2025-12-25 23:59:59.999999	2025-12-25 23:59:59	1766707199	1766707199.999999
5	2025-12-25 20:59:59	2025-12-25 20:59:59.500000	2025-12-25 23:59:59	1766696399	1766696399.500000
SELECT COUNT(*) AS different_rows FROM
((SELECT * FROM r_primary EXCEPT SELECT * FROM r_secondary) UNION ALL
(SELECT * FROM r_secondary EXCEPT SELECT * FROM r_primary)) d;
different_rows
0
DROP TABLE r_primary, r_secondary;
SET SESSION time_zone = '-07:00';
SELECT id, ts, ts6, dt, UNIX_TIMESTAMP(ts) AS seconds, UNIX_TIMESTAMP(ts6) AS seconds6 FROM r_secondary ORDER BY id;
id	ts	ts6	dt	seconds	seconds6
1	2001-02-02 18:05:06	2024-06-15 10:30:45.123456	2024-06-15 10:30:45	981162306	1718472645.123456
2	NULL	NULL	NULL	NULL	NULL
3	2025-12-25 23:59:59	2025-12-25 23:59:59.000001	2025-12-25 23:59:59	1766732399	1766732399.000001
4	2025-12-25 16:59:59	2025-12-25 16:59:59.999999	2025-12-25 23:59:59	1766707199	1766707199.999999
5	2025-12-25 13:59:59	2025-12-25 13:59:59.500000	2025-12-25 23:59:59	1766696399	1766696399.500000
SELECT COUNT(*) AS different_rows FROM
((SELECT * FROM r_primary EXCEPT SELECT * FROM r_secondary) UNION ALL
(SELECT * FROM r_secondary EXCEPT SELECT * FROM r_primary)) d;
different_rows
0
DROP TABLE r_primary, r_secondary;
# a constant that is compared with the column, in the time zone of the server
SET SESSION time_zone = DEFAULT;
SET SESSION use_secondary_engine = FORCED;
SELECT id FROM t WHERE ts = '2025-12-25 23:59:59' ORDER BY id;
id
5
SELECT id FROM t WHERE ts < '2024-01-01 00:00:00' ORDER BY id;
id
1
SET SESSION use_secondary_engine = OFF;
SELECT id FROM t WHERE ts = '2025-12-25 23:59:59' ORDER BY id;
id
5
SELECT id FROM t WHERE ts < '2024-01-01 00:00:00' ORDER BY id;
id
1
SET SESSION use_secondary_engine = DEFAULT;
ALTER TABLE t SECONDARY_UNLOAD;
DROP TABLE t;
