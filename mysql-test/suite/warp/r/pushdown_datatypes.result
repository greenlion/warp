INSERT INTO i SELECT * FROM w;
# BIT values of up to 64 bits are stored as they are, zero bytes included
SELECT id, b+0, bw+0, b64+0 FROM w ORDER BY id;
id	b+0	bw+0	b64+0
1	1	1000	0
2	255	1048575	18446744073709551615
3	10	65	9223372036854775808
4	NULL	NULL	NULL
5	5	5	9223372036854775807
6	6	0	9007199254740993
7	1	1	9007199254740992
SELECT COUNT(*) AS bit_rows_differ FROM (SELECT id, b+0 x, bw+0 y, b64+0 z FROM w EXCEPT ALL SELECT id, b+0, bw+0, b64+0 FROM i) a;
bit_rows_differ
0
