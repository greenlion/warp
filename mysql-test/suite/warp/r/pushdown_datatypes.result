#
# Conditions on every data type that WARP supports.  Every condition
# (the six comparison operators and <=>, BETWEEN, IN, IS NULL, IS NOT
# NULL, with the constant on either side) is also run against an
# identical InnoDB table and the results must match, whether or not
# the condition is pushed down to FastBit.  The EXPLAIN output shows
# which ones are: a condition that FastBit evaluates has no Filter in
# the plan.
#
CREATE TABLE w (
id INT,
ti TINYINT, uti TINYINT UNSIGNED, si SMALLINT, usi SMALLINT UNSIGNED,
mi MEDIUMINT, umi MEDIUMINT UNSIGNED, i INT, ui INT UNSIGNED,
bi BIGINT, ubi BIGINT UNSIGNED,
f FLOAT, d DOUBLE, dc DECIMAL(12,3), dcb DECIMAL(40,10), y YEAR,
dt DATE, tm TIME(3), dtm DATETIME(3), ts TIMESTAMP NULL,
c CHAR(8), vc VARCHAR(20), tx TEXT, en ENUM('x', 'y', 'z'),
st SET('a', 'b', 'c'), b BIT(8), bw BIT(20), b64 BIT(64), js JSON
) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE i LIKE w;
ALTER TABLE i ENGINE=InnoDB;
