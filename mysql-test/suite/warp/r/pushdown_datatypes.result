#
# GEOMETRY is not supported in a WARP table, nothing about it is pushed
# down: the geometry values of other tables and the geometry functions
# are evaluated by MySQL.
#
CREATE TABLE gw (id INT, p POINT) ENGINE=WARP;
ERROR 42000: The storage engine for the table doesn't support GEOMETRY
CREATE TABLE geo (id INT, p POINT) ENGINE=InnoDB;
INSERT INTO geo VALUES (1, ST_GeomFromText('POINT(1 2)')), (2, ST_GeomFromText('POINT(0 0)')), (5, ST_GeomFromText('POINT(5 5)')), (7, NULL);
8 geometry conditions checked, 0 mismatches
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE vc = ST_AsText(ST_GeomFromText('POINT(1 1)'));
EXPLAIN
-> Aggregate: count(0)  
    -> Filter: (w.vc = <cache>(st_astext(st_geomfromtext('POINT(1 1)'))))  
        -> Table scan on w  

Warnings:
Note	1003	/* select#1 */ select count(0) AS `COUNT(*)` from `test`.`w` where (`test`.`w`.`vc` = <cache>(st_astext(st_geomfromtext('POINT(1 1)'))))
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE ST_X(ST_GeomFromText(CONCAT('POINT(', i, ' 1)'))) > 1;
EXPLAIN
-> Aggregate: count(0)  
    -> Filter: (st_x(st_geomfromtext(concat('POINT(',w.i,' 1)'))) > 1)  
        -> Table scan on w  

Warnings:
Note	1003	/* select#1 */ select count(0) AS `COUNT(*)` from `test`.`w` where (st_x(st_geomfromtext(concat('POINT(',`test`.`w`.`i`,' 1)'))) > 1)
DROP TABLE geo;
