# SHOW CREATE VIEW gives a statement that makes the same view
SHOW CREATE VIEW mv_self;
View	Create View	character_set_client	collation_connection
mv_self	CREATE MATERIALIZED VIEW `mv_self` (`first_id`, `second_id`, `region`) ENGINE=ENGINE REFRESH MANUAL AS select `a`.`id` AS `id`,`b`.`id` AS `id`,`a`.`region` AS `region` from (`test`.`cust` `a` join `test`.`cust` `b` on(((`a`.`region` = `b`.`region`) and (`a`.`id` < `b`.`id`))))	utf8mb4	utf8mb4_0900_ai_ci
DROP MATERIALIZED VIEW mv_left;
# mv_left: 5 rows, 0 differ from the defining SELECT
SHOW CREATE VIEW mv_left;
View	Create View	character_set_client	collation_connection
mv_left	CREATE MATERIALIZED VIEW `mv_left` (`cid`, `uname`, `oid`, `dbl`, `sku`, `qty`) ENGINE=ENGINE REFRESH MANUAL AS select `c`.`id` AS `cid`,upper(`c`.`name`) AS `uname`,`o`.`id` AS `oid`,(`o`.`amount` * 2) AS `dbl`,`i`.`sku` AS `sku`,coalesce(`i`.`qty`,0) AS `qty` from ((`test`.`cust` `c` left join `test`.`ord` `o` on((`o`.`cust_id` = `c`.`id`))) left join `test`.`item` `i` on((`i`.`ord_id` = `o`.`id`))) where (`c`.`region` in ('eu','us'))	utf8mb4	utf8mb4_0900_ai_ci
DROP MATERIALIZED VIEW mv_inner, mv_left, mv_right, mv_self;
SHOW TABLES;
Tables_in_test
cust
item
ord
DROP TABLE cust, ord, item;
