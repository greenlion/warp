1	ann	11	4.25
2	bobby	12	100.00
3	cy	16	2.00
4	NULL	13	7.00
5	eve	15	9.99
# mv_inner: 6 rows, 0 differ from the defining SELECT
SELECT * FROM mv_left ORDER BY cid, oid, sku;
cid	uname	oid	dbl	sku	qty
1	ANN	10	31.00	nut	3
1	ANN	11	8.50	bolt	7
2	BOBBY	12	200.00	nut	1
3	CY	16	4.00	NULL	0
4	NULL	13	14.00	NULL	0
5	EVE	15	19.98	gear	2
# mv_left: 6 rows, 0 differ from the defining SELECT
SELECT * FROM mv_right ORDER BY cid, oid;
oid	placed	cid	region
10	2026-01-01	1	eu
11	2026-01-02	1	eu
12	2026-02-01	2	us
16	2026-04-02	3	us
13	NULL	4	us
15	2026-04-01	5	eu
# mv_right: 6 rows, 0 differ from the defining SELECT
SELECT * FROM mv_self ORDER BY first_id, second_id;
first_id	second_id	region
1	5	eu
2	3	us
2	4	us
3	4	us
# mv_self: 4 rows, 0 differ from the defining SELECT
# REFRESH of an emptied join
DELETE FROM ord;
REFRESH MATERIALIZED VIEW mv_inner;
REFRESH MATERIALIZED VIEW mv_left;
SELECT COUNT(*) FROM mv_inner;
COUNT(*)
0
SELECT * FROM mv_left ORDER BY cid;
cid	uname	oid	dbl	sku	qty
1	ANN	NULL	NULL	NULL	0
2	BOBBY	NULL	NULL	NULL	0
3	CY	NULL	NULL	NULL	0
