#
# TIMESTAMP values are stored in UTC, as MySQL stores them: the rows
# that are written in one time zone are the same ones in another one.
#
SET SESSION time_zone = '+05:00';
SET SESSION explicit_defaults_for_timestamp = 1;
CREATE TABLE w (id INT NOT NULL, ts TIMESTAMP NULL, ts3 TIMESTAMP(3) NULL, dt DATETIME, KEY ts_idx (ts), KEY ts3_idx (ts3)) ENGINE=WARP;
CREATE TABLE i (id INT NOT NULL, ts TIMESTAMP NULL, ts3 TIMESTAMP(3) NULL, dt DATETIME, KEY ts_idx (ts), KEY ts3_idx (ts3)) ENGINE=InnoDB;
INSERT INTO w VALUES
(1,'2024-02-29 12:30:45','2024-02-29 12:30:45.123','2024-02-29 12:30:45'),
(2,'1970-01-01 05:00:01','2000-01-01 05:00:00.001','1970-01-01 05:00:01'),
(3,NULL,NULL,NULL),
(4,'2000-01-01 00:00:01','2024-02-29 12:30:45.122','2000-01-01 00:00:01'),
(5,'2038-01-19 08:14:07','2024-02-29 12:30:45.124','2038-01-19 08:14:07'),
(6,'2024-02-29 12:30:45','2024-02-29 12:30:45.123','2024-02-29 12:30:45'),
(7,'2000-01-01 05:00:00','2000-01-01 00:00:00.999','2000-01-01 05:00:00');
INSERT INTO i SELECT * FROM w;
# the values come back in the time zone of the session
SELECT id, ts, ts3 FROM w ORDER BY id;
id	ts	ts3
1	2024-02-29 12:30:45	2024-02-29 12:30:45.123
2	1970-01-01 05:00:01	2000-01-01 05:00:00.001
3	NULL	NULL
4	2000-01-01 00:00:01	2024-02-29 12:30:45.122
5	2038-01-19 08:14:07	2024-02-29 12:30:45.124
6	2024-02-29 12:30:45	2024-02-29 12:30:45.123
7	2000-01-01 05:00:00	2000-01-01 00:00:00.999
SELECT id, UNIX_TIMESTAMP(ts) FROM w ORDER BY id;
id	UNIX_TIMESTAMP(ts)
1	1709191845
2	1
3	NULL
4	946666801
5	2147483647
6	1709191845
7	946684800
SET SESSION time_zone = '-08:00';
SELECT id, ts, ts3 FROM w ORDER BY id;
id	ts	ts3
1	2024-02-28 23:30:45	2024-02-28 23:30:45.123
2	1969-12-31 16:00:01	1999-12-31 16:00:00.001
3	NULL	NULL
4	1999-12-31 11:00:01	2024-02-28 23:30:45.122
5	2038-01-18 19:14:07	2024-02-28 23:30:45.124
6	2024-02-28 23:30:45	2024-02-28 23:30:45.123
7	1999-12-31 16:00:00	1999-12-31 11:00:00.999
SELECT id, UNIX_TIMESTAMP(ts) FROM w ORDER BY id;
id	UNIX_TIMESTAMP(ts)
1	1709191845
2	1
3	NULL
4	946666801
5	2147483647
6	1709191845
7	946684800
SET SESSION time_zone = '+00:00';
SELECT id, ts FROM w WHERE id IN (1, 5) ORDER BY id;
id	ts
1	2024-02-29 07:30:45
5	2038-01-19 03:14:07
# the same rows as InnoDB with every time zone
SET SESSION time_zone = '+00:00';
SET SESSION time_zone = '+05:00';
SET SESSION time_zone = '-08:00';
SET SESSION time_zone = '+13:45';
# compared
# a join of TIMESTAMP columns, and of a TIMESTAMP with a DATETIME
SET SESSION time_zone = '+05:00';
CREATE TABLE d (k TIMESTAMP NULL, v INT) ENGINE=WARP;
INSERT INTO d VALUES ('2024-02-29 12:30:45', 1), ('2000-01-01 00:00:01', 2), (NULL, 3);
CREATE TABLE di SELECT * FROM d;
SELECT d.v, GROUP_CONCAT(w.id ORDER BY w.id) FROM d JOIN w ON w.ts = d.k GROUP BY d.v ORDER BY d.v;
v	GROUP_CONCAT(w.id ORDER BY w.id)
1	1,6
2	4
SELECT d.v, GROUP_CONCAT(w.id ORDER BY w.id) FROM di d JOIN i w ON w.ts = d.k GROUP BY d.v ORDER BY d.v;
v	GROUP_CONCAT(w.id ORDER BY w.id)
1	1,6
2	4
SELECT d.v, GROUP_CONCAT(w.id ORDER BY w.id) FROM d JOIN w ON w.dt = d.k GROUP BY d.v ORDER BY d.v;
v	GROUP_CONCAT(w.id ORDER BY w.id)
1	1,6
2	4
SELECT d.v, GROUP_CONCAT(w.id ORDER BY w.id) FROM di d JOIN i w ON w.dt = d.k GROUP BY d.v ORDER BY d.v;
v	GROUP_CONCAT(w.id ORDER BY w.id)
1	1,6
2	4
# updates and deletes
UPDATE w SET ts = '2024-03-01 00:00:00' WHERE ts = '2024-02-29 12:30:45';
UPDATE i SET ts = '2024-03-01 00:00:00' WHERE ts = '2024-02-29 12:30:45';
DELETE FROM w WHERE ts > '2030-01-01';
DELETE FROM i WHERE ts > '2030-01-01';
SELECT (SELECT GROUP_CONCAT(CONCAT(id, ts) ORDER BY id) FROM w) = (SELECT GROUP_CONCAT(CONCAT(id, ts) ORDER BY id) FROM i) AS same;
same
1
DROP TABLE w, i, d, di;
