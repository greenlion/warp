#
# The statements of materialized views in the binary log: the statement
# of the user, and no row of the view
#
call mtr.add_suppression("MY-015655");
CREATE TABLE t1 (id INT PRIMARY KEY, g INT, v INT);
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30);
RESET BINARY LOGS AND GTIDS;
CREATE MATERIALIZED VIEW mv_j ENGINE=InnoDB REFRESH MANUAL AS
SELECT id, v FROM t1 WHERE g = 1;
CREATE MATERIALIZED VIEW mv_w ENGINE=WARP REFRESH MANUAL AS
SELECT id, v FROM t1;
CREATE MATERIALIZED VIEW mv_a ENGINE=InnoDB REFRESH MANUAL AS
SELECT g, SUM(v) AS s FROM t1 GROUP BY g;
CREATE MATERIALIZED VIEW mv_aw ENGINE=WARP REFRESH MANUAL AS
SELECT COUNT(*) AS c FROM t1;
CREATE MATERIALIZED VIEW IF NOT EXISTS mv_j AS SELECT id FROM t1;
Warnings:
Note	1050	Table 'mv_j' already exists
INSERT INTO t1 VALUES (4, 1, 40);
REFRESH MATERIALIZED VIEW mv_j;
REFRESH MATERIALIZED VIEW mv_w;
REFRESH MATERIALIZED VIEW mv_a;
REFRESH MATERIALIZED VIEW mv_aw;
ALTER MATERIALIZED VIEW mv_j REFRESH SYNCHRONOUS;
# Statements that fail are not logged
CREATE MATERIALIZED VIEW mv_bad AS SELECT id FROM t1 LIMIT 1;
ERROR HY000: The definition of the materialized view is not supported: LIMIT.
REFRESH MATERIALIZED VIEW t1;
ERROR HY000: 'test.t1' is not a materialized view.
DELETE FROM mv_j;
ERROR HY000: Table 'test.mv_j' is the storage of a materialized view and cannot be modified directly.
SELECT * FROM mv_j ORDER BY id;
id	v
1	10
2	20
4	40
SELECT * FROM mv_w ORDER BY id;
id	v
1	10
2	20
3	30
4	40
SELECT * FROM mv_a ORDER BY g;
g	s
1	70
2	30
SELECT * FROM mv_aw;
c
4
DROP MATERIALIZED VIEW mv_j, mv_w;
DROP MATERIALIZED VIEW IF EXISTS mv_a, mv_aw, no_such;
Warnings:
Note	6585	'test.no_such' is not a materialized view.
# The only rows are the row of t1; the views are statements
include/rpl/deprecated/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
binlog.000001	#	Query	#	#	use `test`; CREATE MATERIALIZED VIEW mv_j ENGINE=InnoDB REFRESH MANUAL AS
SELECT id, v FROM t1 WHERE g = 1
binlog.000001	#	Query	#	#	use `test`; CREATE MATERIALIZED VIEW mv_w ENGINE=WARP REFRESH MANUAL AS
SELECT id, v FROM t1
binlog.000001	#	Query	#	#	use `test`; CREATE MATERIALIZED VIEW mv_a ENGINE=InnoDB REFRESH MANUAL AS
SELECT g, SUM(v) AS s FROM t1 GROUP BY g
binlog.000001	#	Query	#	#	use `test`; CREATE MATERIALIZED VIEW mv_aw ENGINE=WARP REFRESH MANUAL AS
SELECT COUNT(*) AS c FROM t1
binlog.000001	#	Query	#	#	use `test`; CREATE MATERIALIZED VIEW IF NOT EXISTS mv_j AS SELECT id FROM t1
binlog.000001	#	Query	#	#	BEGIN
binlog.000001	#	Table_map	#	#	table_id: # (test.t1)
binlog.000001	#	Write_rows	#	#	table_id: # flags: STMT_END_F USE_SQL_FOREIGN_KEY_F
binlog.000001	#	Xid	#	#	COMMIT /* XID */
binlog.000001	#	Query	#	#	use `test`; REFRESH MATERIALIZED VIEW mv_j
binlog.000001	#	Query	#	#	use `test`; REFRESH MATERIALIZED VIEW mv_w
binlog.000001	#	Query	#	#	use `test`; REFRESH MATERIALIZED VIEW mv_a
binlog.000001	#	Query	#	#	use `test`; REFRESH MATERIALIZED VIEW mv_aw
binlog.000001	#	Query	#	#	use `test`; ALTER MATERIALIZED VIEW mv_j REFRESH SYNCHRONOUS
binlog.000001	#	Query	#	#	use `test`; DROP MATERIALIZED VIEW mv_j, mv_w
