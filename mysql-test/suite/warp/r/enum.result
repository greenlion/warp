#
# ENUM columns.  Every query is also run against an InnoDB table and the
# results must match.
#
# Regression test: reading an ENUM column crashed the server, or gave the
# wrong values, because the result of a scan kept a pointer to the
# dictionary of a table that was already closed.
#
# collation utf8mb4_bin
16 queries checked, 0 mismatches
# changes
UPDATE w SET e = 'c' WHERE id IN (1, 2);
UPDATE i SET e = 'c' WHERE id IN (1, 2);
DELETE FROM w WHERE id = 5;
DELETE FROM i WHERE id = 5;
INSERT INTO w VALUES (9, 'dd', 'y', 'w');
INSERT INTO i VALUES (9, 'dd', 'y', 'w');
SELECT id, e, f FROM w ORDER BY id;
id	e	f
1	c	x
2	c	NULL
3	c	y
4	a	y
6	B	x
7	c	NULL
8	dd	y
9	dd	y
SELECT id, e, f FROM i ORDER BY id;
id	e	f
1	c	x
2	c	NULL
3	c	y
4	a	y
6	B	x
7	c	NULL
8	dd	y
9	dd	y
SELECT e, COUNT(*) FROM w GROUP BY e ORDER BY e;
e	COUNT(*)
a	1
B	1
c	4
dd	2
SELECT e, COUNT(*) FROM i GROUP BY e ORDER BY e;
e	COUNT(*)
a	1
B	1
c	4
dd	2
DROP TABLE w, i;
