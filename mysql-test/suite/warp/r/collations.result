# Conditions in another collation than the one of the column are evaluated by
# MySQL, and strings that are not in the pool
10 conditions checked, 0 mismatches
# The conditions that FastBit evaluates have no Filter in the plan, the others do
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE cs = 'a';
EXPLAIN
-> Aggregate: count(0)  
    -> Table scan on w  

EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE cs BETWEEN 'a' AND 'b';
EXPLAIN
-> Aggregate: count(0)  
    -> Table scan on w  

EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE csn IN ('a', 'b', 'c');
EXPLAIN
-> Aggregate: count(0)  
    -> Table scan on w  

EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE 'B' > csc;
EXPLAIN
-> Aggregate: count(0)  
    -> Table scan on w  

EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE l >= 'ä' AND lb < 'b';
EXPLAIN
-> Aggregate: count(0)  
    -> Table scan on w  

EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE cs COLLATE utf8mb4_0900_ai_ci = 'A';
EXPLAIN
-> Aggregate: count(0)  
    -> Filter: ((w.cs collate utf8mb4_0900_ai_ci) = 'A')  
        -> Table scan on w  

EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE cs < '中';
EXPLAIN
-> Aggregate: count(0)  
    -> Table scan on w  

# MySQL can not convert the constant to the character set of the column
SELECT COUNT(*) FROM w WHERE l = '中';
ERROR HY000: Cannot convert string '\xE4\xB8\xAD' from utf8mb4 to latin1
#
# Indexes on columns of these collations: lookups and ranges are
# compared in the collation of the column
#
CREATE TABLE wk (
id INT,
cs VARCHAR(20) COLLATE utf8mb4_0900_as_cs,
l VARCHAR(20) CHARACTER SET latin1 COLLATE latin1_general_cs NULL,
KEY (cs),
KEY (l, id)
) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO wk SELECT id, cs, IF(id % 7 = 0, NULL, l) FROM w;
CREATE TABLE ik LIKE wk;
ALTER TABLE ik ENGINE=InnoDB;
INSERT INTO ik SELECT * FROM wk;
180 index reads checked, 0 mismatches
# A join that looks up the rows of wk by the value of another table
SELECT COUNT(*) = (SELECT COUNT(*) FROM pool JOIN ik ON ik.cs = pool.s COLLATE utf8mb4_0900_as_cs)
AS join_matches FROM pool JOIN wk FORCE INDEX (cs) ON wk.cs = pool.s COLLATE utf8mb4_0900_as_cs;
join_matches
1
#
# The collations that WARP can not compare like MySQL are refused:
# case insensitive collations, binary strings and character sets in
# which a character may have a 0 byte
#
CREATE TABLE bad (v VARCHAR(10) COLLATE utf8mb4_0900_ai_ci) ENGINE=WARP;
ERROR HY000: Table storage engine for 'Unsupported character set or collation for column (only case sensitive and binary collations of character sets without NUL bytes are supported): v' doesn't have this option
CREATE TABLE bad (v VARCHAR(10) CHARACTER SET latin1 COLLATE latin1_swedish_ci) ENGINE=WARP;
ERROR HY000: Table storage engine for 'Unsupported character set or collation for column (only case sensitive and binary collations of character sets without NUL bytes are supported): v' doesn't have this option
CREATE TABLE bad (v VARCHAR(10) CHARACTER SET utf16 COLLATE utf16_bin) ENGINE=WARP;
ERROR HY000: Table storage engine for 'Unsupported character set or collation for column (only case sensitive and binary collations of character sets without NUL bytes are supported): v' doesn't have this option
CREATE TABLE bad (v VARBINARY(10)) ENGINE=WARP;
ERROR HY000: Table storage engine for 'Unsupported character set or collation for column (only case sensitive and binary collations of character sets without NUL bytes are supported): v' doesn't have this option
CREATE TABLE good (a VARCHAR(10) CHARACTER SET ascii COLLATE ascii_bin,
b TEXT COLLATE utf8mb4_0900_as_cs,
c CHAR(5) CHARACTER SET latin1 COLLATE latin1_general_cs) ENGINE=WARP;
INSERT INTO good VALUES ('x', 'Ab', 'Äb'), ('X', 'ab', 'äb');
SELECT * FROM good WHERE a = 'X';
a	b	c
X	ab	äb
SELECT * FROM good WHERE c > 'Äb' ORDER BY a;
a	b	c
X	ab	äb
SELECT * FROM good WHERE b = 'ab';
a	b	c
X	ab	äb
DROP TABLE w, i, wk, ik, good, pool;
