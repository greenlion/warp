DROP TABLE r_on, r_on2, r_off, r_i;
SET SESSION warp_parallel_aggregation = ON;
SET SESSION warp_semi_key_pushdown = OFF;
# the engine makes the rows of the temporary table distinct
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM a_w a WHERE a.k IN (SELECT /*+ QB_NAME(sq) SEMIJOIN(@sq MATERIALIZATION) */ b.k FROM b_w b WHERE b.v > 3);
EXPLAIN
-> Aggregate: count(0)  (cost=995722 rows=1)
    -> Nested loop inner join  (cost=301780 rows=3.01e+6)
        -> Table scan on a  (cost=308 rows=3006)
        -> Single-row index lookup on <subquery2> using <auto_distinct_key> (k = a.k)  (cost=539..539 rows=1)
            -> Materialize with deduplication  (cost=539..539 rows=1002)
                -> Filter: (b.k is not null)  (cost=308 rows=1002)
                    -> Table scan on b, with parallel aggregation  (cost=308 rows=1002)

SET SESSION warp_semi_key_pushdown = DEFAULT;
SET SESSION warp_parallel_aggregation = DEFAULT;
SET SESSION warp_parallel_join_min_rows = DEFAULT;
DROP TABLE queries, a_w, b_w, a_i, b_i;
