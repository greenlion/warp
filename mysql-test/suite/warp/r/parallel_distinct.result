#
# The scan below the temporary table of a semijoin (EXISTS, IN) that removes
# the duplicates returns the distinct rows, made in parallel by the engine
# (warp_parallel_aggregation).  Every query is run against the WARP tables and
# InnoDB copies, with the engine's distinct and the keys of the outer table on
# and off.
#
SET SESSION warp_parallel_join_min_rows = 0;
SET SESSION cte_max_recursion_depth = 100000;
CREATE TABLE a_w (id INT, k INT, s VARCHAR(8), dd DECIMAL(10,2), n INT NULL, d DATE) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE b_w (k INT, s VARCHAR(8), dd DECIMAL(10,2), n INT NULL, v INT, d DATE) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO a_w WITH RECURSIVE x(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM x WHERE i < 3000)
SELECT i, i % 800, CONCAT('s', i % 300), (i % 90) / 4, IF(i % 7 = 0, NULL, i % 120), DATE_ADD('2021-01-01', INTERVAL i % 60 DAY) FROM x;
INSERT INTO b_w WITH RECURSIVE x(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM x WHERE i < 40000)
SELECT i % 1000, CONCAT('s', i % 400), (i % 100) / 4, IF(i % 5 = 0, NULL, i % 150), i % 11, DATE_ADD('2021-01-01', INTERVAL i % 80 DAY) FROM x;
CREATE TABLE a_i LIKE a_w;
CREATE TABLE b_i LIKE b_w;
ALTER TABLE a_i ENGINE=InnoDB;
ALTER TABLE b_i ENGINE=InnoDB;
INSERT INTO a_i SELECT * FROM a_w;
INSERT INTO b_i SELECT * FROM b_w;
CREATE TABLE queries (i INT, q TEXT);
INSERT INTO queries VALUES
(1, 'SELECT COUNT(*), SUM(a.id) FROM a_@ a WHERE a.k IN (SELECT /*+ QB_NAME(sq) SEMIJOIN(@sq MATERIALIZATION) */ b.k FROM b_@ b WHERE b.v > 3)'),
(2, 'SELECT COUNT(*), SUM(a.id) FROM a_@ a WHERE a.s IN (SELECT /*+ QB_NAME(sq) SEMIJOIN(@sq MATERIALIZATION) */ b.s FROM b_@ b WHERE b.v < 5)'),
(3, 'SELECT COUNT(*), SUM(a.id) FROM a_@ a WHERE a.dd IN (SELECT /*+ QB_NAME(sq) SEMIJOIN(@sq MATERIALIZATION) */ b.dd FROM b_@ b WHERE b.v = 2)'),
(4, 'SELECT COUNT(*), SUM(a.id) FROM a_@ a WHERE a.n IN (SELECT /*+ QB_NAME(sq) SEMIJOIN(@sq MATERIALIZATION) */ b.n FROM b_@ b WHERE b.v > 6)'),
(5, 'SELECT COUNT(*), SUM(a.id) FROM a_@ a WHERE (a.k, a.s) IN (SELECT /*+ QB_NAME(sq) SEMIJOIN(@sq MATERIALIZATION) */ b.k, b.s FROM b_@ b WHERE b.v = 1)'),
(6, 'SELECT COUNT(*), SUM(a.id) FROM a_@ a WHERE a.d >= ''2021-02-01'' AND EXISTS (SELECT /*+ QB_NAME(sq) SEMIJOIN(@sq MATERIALIZATION) */ 1 FROM b_@ b WHERE b.k = a.k AND b.d < b.d + INTERVAL 1 DAY AND b.v > 8)'),
(7, 'SELECT COUNT(*), SUM(a.id) FROM a_@ a WHERE a.k IN (SELECT /*+ QB_NAME(sq) SEMIJOIN(@sq MATERIALIZATION) */ b.k FROM b_@ b WHERE b.k < b.v * 100)'),
(8, 'SELECT COUNT(*), SUM(a.id) FROM a_@ a WHERE a.k IN (SELECT /*+ QB_NAME(sq) SEMIJOIN(@sq MATERIALIZATION) */ b.k FROM b_@ b WHERE b.v = 99)'),
(9, 'SELECT COUNT(*) FROM a_@ a JOIN (SELECT DISTINCT b.k, b.s FROM b_@ b WHERE b.v < 3) x ON x.k = a.k AND x.s = a.s');
