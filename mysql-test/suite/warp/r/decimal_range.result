#
# Comparisons of DECIMAL columns with constants.  WARP stores a DECIMAL
# as text, so the order of the text is not the order of the numbers
# ('10.50' < '9.00', negative values).  Every comparison is also run
# against an InnoDB table and the results must match.
#
CREATE TABLE w (id INT, a DECIMAL(10,2) NOT NULL, b DECIMAL(10,2) NULL,
c DECIMAL(30,10) NULL, d DECIMAL(5,0) NOT NULL, e DECIMAL(10,4) NOT NULL) ENGINE=WARP;
CREATE TABLE i LIKE w;
ALTER TABLE i ENGINE=InnoDB;
INSERT INTO w VALUES
(1, 9.00, 9.00, 9.0000000001, 9, 9.5),
(2, 10.50, 10.50, 10.5, 10, 10.5),
(3, -5.25, -5.25, -5.25, -5, 0),
(4, 100.00, 100.00, 100, 100, 100.0001),
(5, 1.00, NULL, NULL, 1, 1),
(6, 0.00, 0.00, 0, 0, 0),
(7, -0.01, -0.01, -0.0000000001, 0, 0.0001),
(8, -100.00, -100.00, -99999999999999999999.9999999999, -100, 5),
(9, 99999999.99, 99999999.99, 99999999999999999999.9999999999, 99999, 999999.9999),
(10, 5.00, 5.00, 5, 5, 5), (11, 20.00, 20.00, 20, 20, 20);
INSERT INTO i SELECT * FROM w;
comparisons checked: 1440, mismatches: 0
# The conditions that FastBit evaluates have no Filter in the plan, the others do
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE a BETWEEN 5 AND 20.5;
EXPLAIN
-> Aggregate: count(0)  (cost=1.67 rows=1)
    -> Table scan on w  (cost=1.33 rows=1.44)

EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE b > -5.25 AND c <> 10;
EXPLAIN
-> Aggregate: count(0)  (cost=2.23 rows=1)
    -> Table scan on w  (cost=1.33 rows=3.9)

EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE 5 < d;
EXPLAIN
-> Aggregate: count(0)  (cost=2.33 rows=1)
    -> Table scan on w  (cost=1.33 rows=4.33)

EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE a < 9.5e0;
EXPLAIN
-> Aggregate: count(0)  (cost=2.33 rows=1)
    -> Table scan on w  (cost=1.33 rows=4.33)

EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE a NOT BETWEEN 5 AND 20;
EXPLAIN
-> Aggregate: count(0)  (cost=4 rows=1)
    -> Filter: (w.a not between 5 and 20)  (cost=1.33 rows=11.6)
        -> Table scan on w  (cost=1.33 rows=13)

EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE a IN (5, 10);
EXPLAIN
-> Aggregate: count(0)  (cost=1.93 rows=1)
    -> Filter: (w.a in (5,10))  (cost=1.33 rows=2.6)
        -> Table scan on w  (cost=1.33 rows=13)

# a double constant makes MySQL compare doubles, not exact decimals
CREATE TABLE wf (id INT, f DECIMAL(30,20) NOT NULL) ENGINE=WARP;
CREATE TABLE inf LIKE wf;
ALTER TABLE inf ENGINE=InnoDB;
INSERT INTO wf VALUES (1, 0.1), (2, 0.10000000000000000001), (3, 0.2);
INSERT INTO inf SELECT * FROM wf;
SELECT id FROM wf WHERE f = 0.1e0 ORDER BY id;
id
1
SELECT id FROM inf WHERE f = 0.1e0 ORDER BY id;
id
1
SELECT id FROM wf WHERE f > 0.1e0 ORDER BY id;
id
2
3
SELECT id FROM inf WHERE f > 0.1e0 ORDER BY id;
id
2
3
SELECT id FROM wf WHERE f = 0.1 ORDER BY id;
id
1
SELECT id FROM inf WHERE f = 0.1 ORDER BY id;
id
1
SELECT id FROM wf WHERE f > 0.1 ORDER BY id;
id
2
3
SELECT id FROM inf WHERE f > 0.1 ORDER BY id;
id
2
3
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM wf WHERE f > 0.1e0;
EXPLAIN
-> Aggregate: count(0)  (cost=0.896 rows=1)
    -> Table scan on wf  (cost=0.512 rows=1.67)

DROP TABLE wf, inf;
# combined with other conditions, NULL tests and OR
SELECT id FROM w WHERE b > 5 AND a < 100 AND d <> 10 ORDER BY id;
id
1
11
SELECT id FROM i WHERE b > 5 AND a < 100 AND d <> 10 ORDER BY id;
id
1
11
SELECT id FROM w WHERE b IS NULL OR c BETWEEN -6 AND 6 ORDER BY id;
id
3
5
6
7
10
SELECT id FROM i WHERE b IS NULL OR c BETWEEN -6 AND 6 ORDER BY id;
id
3
5
6
7
10
SELECT id FROM w WHERE b IS NOT NULL AND b >= 9 ORDER BY id;
id
1
2
4
9
11
SELECT id FROM i WHERE b IS NOT NULL AND b >= 9 ORDER BY id;
id
1
2
4
9
11
# after an update
UPDATE w SET a = 7.77, c = 7.7 WHERE id IN (2, 4);
UPDATE i SET a = 7.77, c = 7.7 WHERE id IN (2, 4);
DELETE FROM w WHERE id = 11;
DELETE FROM i WHERE id = 11;
SELECT id FROM w WHERE a BETWEEN 5 AND 9 ORDER BY id;
id
1
2
4
10
SELECT id FROM i WHERE a BETWEEN 5 AND 9 ORDER BY id;
id
1
2
4
10
SELECT id FROM w WHERE c > 7.7 ORDER BY id;
id
1
9
SELECT id FROM i WHERE c > 7.7 ORDER BY id;
id
1
9
DROP TABLE w, i;
