SET SESSION warp_adjust_table_stats_for_joins = DEFAULT;
SET SESSION optimizer_switch = DEFAULT;
# the scans are limited to the keys (Warp_semi_key_scans grows), and no
# condition that FastBit can not parse was made by the queries of the test
SET SESSION warp_semi_key_pushdown = ON;
# join with a CTE: 1
# both operands of the UNION ALL: 1
# conditions that FastBit could not parse: 0
SET SESSION warp_semi_key_pushdown = DEFAULT;
DROP TABLE queries, f_w, d_w, c_w, w_w, f_i, d_i, c_i, w_i;
