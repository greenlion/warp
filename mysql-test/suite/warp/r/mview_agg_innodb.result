View	Create View	character_set_client	collation_connection
mv_grp	CREATE MATERIALIZED VIEW `mv_grp` (`region`, `cnt`, `cnt_qty`, `sum_qty`, `avg_price`, `min_price`, `max_day`, `avg_qty`) ENGINE=ENGINE REFRESH MANUAL AS select `test`.`sales`.`region` AS `region`,count(0) AS `cnt`,count(`test`.`sales`.`qty`) AS `cnt_qty`,sum(`test`.`sales`.`qty`) AS `sum_qty`,avg(`test`.`sales`.`price`) AS `avg_price`,min(`test`.`sales`.`price`) AS `min_price`,max(`test`.`sales`.`day`) AS `max_day`,avg(`test`.`sales`.`qty`) AS `avg_qty` from `test`.`sales` group by `test`.`sales`.`region`	utf8mb4	utf8mb4_0900_ai_ci
DROP MATERIALIZED VIEW mv_grp;
