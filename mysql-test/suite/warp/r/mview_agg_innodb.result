# What a table cannot hold
CREATE MATERIALIZED VIEW mv_bad AS
SELECT region, COUNT(*) FROM sales GROUP BY region HAVING COUNT(*) > 1;
ERROR HY000: The definition of the materialized view is not supported: HAVING (a table cannot hide groups).
CREATE MATERIALIZED VIEW mv_bad AS
SELECT region, COUNT(*) FROM sales GROUP BY region WITH ROLLUP;
ERROR HY000: The definition of the materialized view is not supported: GROUP BY with ROLLUP, CUBE or GROUPING SETS (a table cannot hold super-aggregate rows).
CREATE MATERIALIZED VIEW mv_bad AS
SELECT id, region, COUNT(*) FROM sales GROUP BY id;
ERROR HY000: The definition of the materialized view is not supported: column `sales`.`region` must be a GROUP BY expression or inside an aggregate function.
CREATE MATERIALIZED VIEW mv_bad AS
SELECT DISTINCT region, COUNT(*) FROM sales GROUP BY region, qty;
ERROR HY000: The definition of the materialized view is not supported: SELECT DISTINCT with GROUP BY or aggregate functions.
CREATE MATERIALIZED VIEW mv_bad AS
SELECT region, SUM(qty) OVER (PARTITION BY region) FROM sales;
ERROR HY000: The definition of the materialized view is not supported: window functions.
# Changes of the base tables are seen after REFRESH
INSERT INTO sales VALUES (8, 4, 'eu', 10, 2.00, '2026-02-01'),
(9, 1, 'za', NULL, NULL, NULL);
UPDATE sales SET qty = 4, region = 'us' WHERE id = 1;
UPDATE sales SET price = NULL WHERE id = 6;
DELETE FROM sales WHERE id IN (4, 5);
UPDATE prod SET kind = 'c' WHERE id = 2;
INSERT INTO nothing VALUES (1, NULL), (2, 5);
