#
# Aggregates over the join of the engine with decimal, string and date
# columns, expressions, CASE, LIKE, YEAR() and residual conditions are made
# by the engine.  Every query is run against the WARP tables with the
# aggregation on and off, and against InnoDB copies.
#
SET SESSION warp_parallel_join_min_rows = 0;
SET SESSION cte_max_recursion_depth = 100000;
CREATE TABLE f_w (id INT, k INT, g INT, dt DATE, p DECIMAL(12,2), q DECIMAL(5,2) NULL, c CHAR(1), s VARCHAR(20) NULL, n INT NULL) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE d_w (k INT, nm VARCHAR(30), t VARCHAR(10), r DECIMAL(6,3), j INT, yy DATE) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE e_w (j INT, z VARCHAR(10), w DECIMAL(8,2)) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO f_w WITH RECURSIVE s(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 6000)
SELECT i, 1 + i % 600, i % 7, DATE_ADD('1993-01-01', INTERVAL (i * 7) % 2000 DAY), (i * 37) % 10007 / 100 + 0.01,
IF(i % 5 = 0, NULL, (i % 11) / 100), CHAR(65 + i % 4), IF(i % 6 = 0, NULL, CONCAT('s', i % 13)), IF(i % 4 = 0, NULL, i % 9) FROM s;
INSERT INTO d_w WITH RECURSIVE s(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 1500)
SELECT 1 + i % 500, CONCAT(IF(i % 6 = 0, 'special ', 'x '), IF(i % 4 = 0, 'requests', 'none'), i), CONCAT('t', i % 5),
(i % 997) / 7, 1 + i % 120, DATE_ADD('1992-01-01', INTERVAL i DAY) FROM s;
