CREATE TABLE f_i LIKE f_w;
CREATE TABLE d_i LIKE d_w;
CREATE TABLE e_i LIKE e_w;
ALTER TABLE f_i ENGINE=InnoDB;
ALTER TABLE d_i ENGINE=InnoDB;
ALTER TABLE e_i ENGINE=InnoDB;
INSERT INTO f_i SELECT * FROM f_w;
INSERT INTO d_i SELECT * FROM d_w;
INSERT INTO e_i SELECT * FROM e_w;
CREATE TABLE queries (i INT, q TEXT);
INSERT INTO queries VALUES
(1, 'SELECT d.t, SUM(f.p) a1, SUM(f.p * (1 - f.q)) a2, COUNT(*) a3, MIN(f.p) a4, MAX(f.p) a5 FROM f_# f JOIN d_# d ON f.k = d.k GROUP BY d.t'),
(2, 'SELECT f.c, d.t, SUM(f.p * d.r) a1, SUM(f.p - d.r * 2 + 1) a2, AVG(f.p) a3 FROM f_# f JOIN d_# d ON f.k = d.k GROUP BY f.c, d.t'),
(3, 'SELECT YEAR(f.dt) AS y, d.t, SUM(f.p) a1 FROM f_# f JOIN d_# d ON f.k = d.k GROUP BY YEAR(f.dt), d.t'),
(4, 'SELECT YEAR(f.dt) AS y, SUM(CASE WHEN d.t = ''t1'' THEN f.p ELSE 0 END) a1, SUM(CASE WHEN d.t = ''t1'' THEN 1 ELSE 0 END) a2, SUM(CASE WHEN f.c IN (''A'',''B'') THEN f.p * 2 ELSE 0 END) a3 FROM f_# f JOIN d_# d ON f.k = d.k GROUP BY YEAR(f.dt)'),
(5, 'SELECT SUM(CASE WHEN d.t LIKE ''t1%'' OR d.t LIKE ''t2'' THEN f.p ELSE 0 END) a1, SUM(CASE WHEN d.t NOT LIKE ''t1%'' THEN 1 ELSE 0 END) a2 FROM f_# f JOIN d_# d ON f.k = d.k'),
(6, 'SELECT d.nm, f.c, COUNT(*) FROM f_# f JOIN d_# d ON f.k = d.k WHERE d.nm LIKE ''special%requests%'' GROUP BY d.nm, f.c'),
(7, 'SELECT f.s, COUNT(*) a1, COUNT(f.s) a2, MIN(f.s) a3, MAX(d.nm) a4, SUM(f.n) a5 FROM f_# f JOIN d_# d ON f.k = d.k GROUP BY f.s'),
(8, 'SELECT f.g, SUM(f.p) a1 FROM f_# f JOIN d_# d ON f.k = d.k WHERE f.dt >= ''1994-01-01'' AND f.dt < ''1996-01-01'' AND d.r BETWEEN 10 AND 100 GROUP BY f.g'),
(9, 'SELECT f.g, SUM(f.p) a1 FROM f_# f JOIN d_# d ON f.k = d.k WHERE (d.t = ''t1'' AND f.p > 50) OR (d.t = ''t2'' AND f.p < 20) GROUP BY f.g'),
(10, 'SELECT f.g, SUM(f.p) a1, COUNT(d.r) a2, SUM(d.r) a3, MAX(d.nm) a4 FROM f_# f LEFT JOIN d_# d ON f.k = d.k AND d.t = ''t3'' GROUP BY f.g'),
(11, 'SELECT d.t, e.z, SUM(f.p * e.w) a1, COUNT(*) a2 FROM f_# f JOIN d_# d ON f.k = d.k JOIN e_# e ON d.j = e.j GROUP BY d.t, e.z'),
(12, 'SELECT f.id, SUM(f.p) a1, d.nm FROM f_# f JOIN d_# d ON f.k = d.k WHERE f.id < 300 GROUP BY f.id, d.nm'),
(13, 'SELECT f.q, COUNT(*) a1, SUM(f.q) a2, MIN(f.q) a3 FROM f_# f JOIN d_# d ON f.k = d.k GROUP BY f.q'),
(14, 'SELECT MAX(d.yy) a1, MIN(f.dt) a2, COUNT(DISTINCT d.t) a3 FROM f_# f JOIN d_# d ON f.k = d.k'),
(15, 'SELECT f.g, SUM(f.p) / SUM(d.r) a1 FROM f_# f JOIN d_# d ON f.k = d.k GROUP BY f.g HAVING SUM(f.p) > 1000'),
(16, 'SELECT d.t, SUM(IF(f.n IS NULL, 1, 0)) a1, SUM(-f.p) a2, SUM(NOT (f.p > 40)) a3 FROM f_# f JOIN d_# d ON f.k = d.k GROUP BY d.t ORDER BY d.t');
