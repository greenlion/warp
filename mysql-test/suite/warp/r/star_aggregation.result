keys: a key that has several rows in the dimension: 8 rows
keys: NULL group values and a NULL key in the dimension: 6 rows
keys: no row passes: 1 rows
SET SESSION warp_star_aggregation = OFF;
DROP TABLE f, d1, d2, d3, fi, d1i, d2i, d3i;
