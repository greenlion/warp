v_nk: 6 rows, 0 missing, 0 extra
v_agg: 5 rows, 0 missing, 0 extra
v_e_warp: 6 rows, 0 missing, 0 extra
# the two points in time that are 02:30 in the time zone of the server:
# a change of one of them is a change of that one
SET SESSION time_zone = '+00:00';
UPDATE k SET v = 21 WHERE ts = '2023-10-29 01:30:00';
UPDATE nk SET v = 101 WHERE ts = '2023-10-29 00:30:00.123';
UPDATE e SET ts = '2023-10-29 01:30:00.5' WHERE id = 1;
v_e: 6 rows, 0 missing, 0 extra
v_k: 5 rows, 0 missing, 0 extra
v_nk: 6 rows, 0 missing, 0 extra
v_agg: 5 rows, 0 missing, 0 extra
v_e_warp: 6 rows, 0 missing, 0 extra
UPDATE k SET ts = '2023-10-29 01:45:00' WHERE ts = '2023-10-29 00:30:00';
UPDATE nk SET ts = '2023-10-29 00:30:00.123' WHERE v = 200;
v_e: 6 rows, 0 missing, 0 extra
v_k: 5 rows, 0 missing, 0 extra
v_nk: 6 rows, 0 missing, 0 extra
v_agg: 4 rows, 0 missing, 0 extra
v_e_warp: 6 rows, 0 missing, 0 extra
DELETE FROM k WHERE ts = '2023-10-29 01:30:00';
DELETE FROM nk WHERE ts = '2023-10-29 00:30:00.123' AND v = 101;
DELETE FROM e WHERE id = 2;
v_e: 5 rows, 0 missing, 0 extra
v_k: 4 rows, 0 missing, 0 extra
v_nk: 5 rows, 0 missing, 0 extra
v_agg: 4 rows, 0 missing, 0 extra
v_e_warp: 5 rows, 0 missing, 0 extra
# an expression that depends on the time zone has the value of UTC, when
# the view is filled and when it is maintained, whatever the time zone
# of the session that creates the view or writes the rows
SET SESSION time_zone = '-07:00';
INSERT INTO e VALUES (7, '2025-12-25 20:00:00', 7);
SET SESSION time_zone = '+00:00';
