#
# Every kind of partitioning: the rows go to their partitions, and every
# condition gives the rows that InnoDB gives
#
CREATE TABLE w (id INT, d DATE, k INT, s VARCHAR(10), v DECIMAL(8,2), KEY (k), KEY (d))
ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin PARTITION BY RANGE (YEAR(d)) (PARTITION p2019 VALUES LESS THAN (2020), PARTITION p2020 VALUES LESS THAN (2021), PARTITION p2021 VALUES LESS THAN (2022), PARTITION pmax VALUES LESS THAN MAXVALUE);
CREATE TABLE i (id INT, d DATE, k INT, s VARCHAR(10), v DECIMAL(8,2), KEY (k), KEY (d))
ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin PARTITION BY RANGE (YEAR(d)) (PARTITION p2019 VALUES LESS THAN (2020), PARTITION p2020 VALUES LESS THAN (2021), PARTITION p2021 VALUES LESS THAN (2022), PARTITION pmax VALUES LESS THAN MAXVALUE);
INSERT INTO w SELECT * FROM src;
INSERT INTO i SELECT * FROM src;
# PARTITION BY RANGE (YEAR(d)) (PARTITION p2019 VALUES LESS THAN (2020), PARTITION p2020 VALUES LESS THAN (2021), PARTITION p2021 VALUES LESS THAN (2022), PARTITION pmax VALUES LESS THAN MAXVALUE)
SELECT PARTITION_NAME, SUBPARTITION_NAME, TABLE_ROWS FROM information_schema.PARTITIONS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 'w' ORDER BY PARTITION_ORDINAL_POSITION, SUBPARTITION_ORDINAL_POSITION;
PARTITION_NAME	SUBPARTITION_NAME	TABLE_ROWS
p2019	NULL	364
p2020	NULL	366
p2021	NULL	365
pmax	NULL	1905
# the rows of every partition are the ones InnoDB puts there
14 conditions checked, 0 mismatches
# a join, and updates that move rows to other partitions
UPDATE w SET d = DATE_ADD(d, INTERVAL 400 DAY), k = k + 1, s = CONCAT('b', id % 11) WHERE id % 9 = 0;
UPDATE i SET d = DATE_ADD(d, INTERVAL 400 DAY), k = k + 1, s = CONCAT('b', id % 11) WHERE id % 9 = 0;
DELETE FROM w WHERE id % 10 = 3;
DELETE FROM i WHERE id % 10 = 3;
DROP TABLE w, i;
CREATE TABLE w (id INT, d DATE, k INT, s VARCHAR(10), v DECIMAL(8,2), KEY (k), KEY (d))
ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin PARTITION BY RANGE COLUMNS (d, k) (PARTITION a VALUES LESS THAN ('2020-01-01', 10), PARTITION b VALUES LESS THAN ('2021-06-01', 0), PARTITION c VALUES LESS THAN (MAXVALUE, MAXVALUE));
CREATE TABLE i (id INT, d DATE, k INT, s VARCHAR(10), v DECIMAL(8,2), KEY (k), KEY (d))
ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin PARTITION BY RANGE COLUMNS (d, k) (PARTITION a VALUES LESS THAN ('2020-01-01', 10), PARTITION b VALUES LESS THAN ('2021-06-01', 0), PARTITION c VALUES LESS THAN (MAXVALUE, MAXVALUE));
