#
# DROP PARTITION removes the data directory of the partition, ADD
# PARTITION creates an empty one, TRUNCATE PARTITION empties one
#
# the data directories of w
w#p#p2019.data
w#p#p2020.data
w#p#p2021.data
w#p#pmax.data
ALTER TABLE w DROP PARTITION p2019;
w#p#p2020.data
w#p#p2021.data
w#p#pmax.data
SELECT COUNT(*), MIN(d) FROM w;
COUNT(*)	MIN(d)
2122	2020-01-01
ALTER TABLE w ALGORITHM=INPLACE, DROP PARTITION p2020, pmax;
w#p#p2021.data
SELECT COUNT(*), MIN(d), MAX(d) FROM w;
COUNT(*)	MIN(d)	MAX(d)
365	2021-01-01	2021-12-31
