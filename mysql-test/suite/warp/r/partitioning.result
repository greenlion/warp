#
# Partitioned WARP tables (PARTITION BY ...).  Every partition, and every
# subpartition, is stored like a WARP table in its own data directory
# (<table>#p#<partition>.data, <table>#p#<partition>#sp#<sub>.data).
# DROP PARTITION removes the directories of the partition, ADD PARTITION
# (RANGE, LIST) creates empty ones and TRUNCATE PARTITION empties them,
# without reading the other partitions.  The other changes of the
# partitioning copy the table.  The results are compared with identical
# InnoDB tables.
#
SET SESSION cte_max_recursion_depth = 100000;
CREATE TABLE src (id INT, d DATE, k INT, s VARCHAR(10), v DECIMAL(8,2))
ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO src WITH RECURSIVE seq(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM seq WHERE x < 3000)
SELECT x, DATE_ADD('2019-01-01', INTERVAL x DAY), x % 37, CONCAT(CHAR(97 + x % 5), x % 11),
x / 7 FROM seq;
