v_left: 10 rows, 0 missing, 0 extra
v_where: 10 rows, 0 missing, 0 extra
v_uniq: 5 rows, 0 missing, 0 extra
v_mixed: 3 rows, 0 missing, 0 extra
v_nokey: 7 rows, 0 missing, 0 extra
v_rootnokey: 3 rows, 0 missing, 0 extra
v_agg: 5 rows, 0 missing, 0 extra
# binlog_row_image=MINIMAL: the before image of a table without a
# PRIMARY KEY has every column, the after image the changed ones
SET SESSION binlog_row_image = MINIMAL;
UPDATE c SET name = 'min' WHERE id = 4 LIMIT 1;
UPDATE o SET amount = amount + 1 WHERE c_id = 4;
DELETE FROM c WHERE id = 3;
INSERT INTO c VALUES (5, 'eve', NULL);
SET SESSION binlog_row_image = FULL;
