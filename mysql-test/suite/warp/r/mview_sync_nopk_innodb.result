SHOW CREATE TABLE v_inner;
Table	Create Table
v_inner	CREATE TABLE `v_inner` (
  `cid` int DEFAULT NULL,
  `name` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL,
  `oid` int DEFAULT NULL,
  `amount` int DEFAULT NULL,
  `f` float DEFAULT NULL,
  `mv$pk0_2` varchar(10) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL /*!80023 INVISIBLE */,
  `mv$pk1_1` int DEFAULT NULL /*!80023 INVISIBLE */,
  KEY `mv$ix_pk0` (`cid`,`name`,`mv$pk0_2`),
  KEY `mv$ix_pk1` (`oid`,`mv$pk1_1`,`amount`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SHOW CREATE TABLE v_uniq;
Table	Create Table
v_uniq	CREATE TABLE `v_uniq` (
  `id` int DEFAULT NULL,
  `x` int DEFAULT NULL,
  `name` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL,
  `mv$pk1_0` int DEFAULT NULL /*!80023 INVISIBLE */,
  `mv$pk1_2` varchar(10) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL /*!80023 INVISIBLE */,
  KEY `mv$ix_pk0` (`id`),
  KEY `mv$ix_pk1` (`mv$pk1_0`,`name`,`mv$pk1_2`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
