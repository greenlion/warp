#
# zstd compression of FastBit column data files
#
SET SESSION cte_max_recursion_depth = 100000;
SET SESSION group_concat_max_len = 100000000;
SELECT @@global.warp_compression, @@global.warp_compression_level;
@@global.warp_compression	@@global.warp_compression_level
1	3
# Level range
SET GLOBAL warp_compression_level = 0;
Warnings:
Warning	1292	Truncated incorrect warp_compression_level value: '0'
SELECT @@global.warp_compression_level;
@@global.warp_compression_level
1
SET GLOBAL warp_compression_level = 100;
Warnings:
Warning	1292	Truncated incorrect warp_compression_level value: '100'
SELECT @@global.warp_compression_level;
@@global.warp_compression_level
19
SET GLOBAL warp_compression_level = 3;
# One table written uncompressed, one compressed
SET GLOBAL warp_compression = OFF;
CREATE TABLE tp (id INT, k INT, s VARCHAR(30), d DATE, n INT NULL) ENGINE=WARP
DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO tp WITH RECURSIVE seq(x) AS
(SELECT 1 UNION ALL SELECT x + 1 FROM seq WHERE x < 20000)
SELECT x, x % 100, CONCAT('value-', x % 211), DATE_ADD('2010-01-01', INTERVAL x % 3000 DAY),
IF(x % 5 = 0, NULL, x % 17)
FROM seq;
# Reading creates the string offset files, keep them uncompressed too
SELECT COUNT(*), SUM(LENGTH(s)) FROM tp;
COUNT(*)	SUM(LENGTH(s))
20000	169552
SET GLOBAL warp_compression = ON;
CREATE TABLE tc LIKE tp;
INSERT INTO tc SELECT * FROM tp;
SELECT COUNT(*), SUM(LENGTH(s)) FROM tc;
COUNT(*)	SUM(LENGTH(s))
20000	169552
tp: 0 compressed, 13 plain
tc: 13 compressed, 0 plain
# Both tables hold the same data
compressed and uncompressed tables are identical
SELECT COUNT(*) FROM tc WHERE k = 42;
COUNT(*)
200
SELECT COUNT(*) FROM tc WHERE s = 'value-7';
COUNT(*)
95
SELECT COUNT(*) FROM tc WHERE n IS NULL;
COUNT(*)
4000
SELECT COUNT(*) FROM tc WHERE d BETWEEN '2012-01-01' AND '2012-12-31';
COUNT(*)
2562
# Appending to an uncompressed table keeps its existing files plain
INSERT INTO tp VALUES (20001, 1, 'appended', '2024-01-01', 1);
SELECT COUNT(*) FROM tp;
COUNT(*)
20001
tp: 0 compressed, 13 plain
# Small inserts into the compressed table
INSERT INTO tc VALUES (30000 + 1, 1, 'small', '2024-01-01', NULL);
INSERT INTO tc VALUES (30000 + 2, 2, 'small', '2024-01-01', NULL);
INSERT INTO tc VALUES (30000 + 3, 3, 'small', '2024-01-01', NULL);
INSERT INTO tc VALUES (30000 + 4, 4, 'small', '2024-01-01', NULL);
INSERT INTO tc VALUES (30000 + 5, 5, 'small', '2024-01-01', NULL);
INSERT INTO tc VALUES (30000 + 6, 6, 'small', '2024-01-01', NULL);
INSERT INTO tc VALUES (30000 + 7, 7, 'small', '2024-01-01', NULL);
INSERT INTO tc VALUES (30000 + 8, 8, 'small', '2024-01-01', NULL);
INSERT INTO tc VALUES (30000 + 9, 9, 'small', '2024-01-01', NULL);
INSERT INTO tc VALUES (30000 + 10, 10, 'small', '2024-01-01', NULL);
SELECT COUNT(*), SUM(s = 'small') FROM tc;
COUNT(*)	SUM(s = 'small')
20010	10
# OPTIMIZE TABLE converts files to the current format
OPTIMIZE TABLE tp;
Table	Op	Msg_type	Msg_text
test.tp	optimize	status	OK
tp: 13 compressed, 0 plain
SELECT COUNT(*), SUM(id), SUM(LENGTH(s)) FROM tp;
COUNT(*)	SUM(id)	SUM(LENGTH(s))
20001	200030001	169560
SET GLOBAL warp_compression = OFF;
OPTIMIZE TABLE tc;
Table	Op	Msg_type	Msg_text
test.tc	optimize	status	OK
tc: 0 compressed, 13 plain
SELECT COUNT(*), SUM(id), SUM(LENGTH(s)) FROM tc;
COUNT(*)	SUM(id)	SUM(LENGTH(s))
20010	200310055	169602
SET GLOBAL warp_compression = ON;
# Compressed data survives a restart
OPTIMIZE TABLE tc;
Table	Op	Msg_type	Msg_text
test.tc	optimize	status	OK
# restart
tc: 13 compressed, 0 plain
SELECT COUNT(*), SUM(id), SUM(LENGTH(s)), COUNT(n) FROM tc;
COUNT(*)	SUM(id)	SUM(LENGTH(s))	COUNT(n)
20010	200310055	169602	16000
SELECT COUNT(*) FROM tc WHERE s = 'value-7';
COUNT(*)
95
DROP TABLE tp, tc;
SET GLOBAL warp_compression = DEFAULT;
SET GLOBAL warp_compression_level = DEFAULT;
