#
# A constant that is an expression (0.06 - 0.01, 12 * 2, -5) is the number that it
# has: the condition is pushed down to FastBit like one with a literal.  Every
# condition is run against the WARP table and an InnoDB copy.
#
CREATE TABLE t_w (id INT, i INT, u INT UNSIGNED, b BIGINT, d DECIMAL(10,2), f DOUBLE, ti TINYINT, n INT NULL, v VARCHAR(10)) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO t_w WITH RECURSIVE x(k) AS (SELECT 1 UNION ALL SELECT k + 1 FROM x WHERE k < 400)
SELECT k, (k % 41) - 20, k % 37, (k - 200) * 1000003, ((k % 61) - 30) / 4, ((k % 53) - 26) / 3, (k % 17) - 8, IF(k % 7 = 0, NULL, (k % 29) - 14), CONCAT('s', k % 9) FROM x;
CREATE TABLE t_i LIKE t_w;
ALTER TABLE t_i ENGINE=InnoDB;
INSERT INTO t_i SELECT * FROM t_w;
CREATE TABLE preds (i INT, p VARCHAR(200));
INSERT INTO preds VALUES
(1, 'd BETWEEN 0.06 - 0.01 AND 0.06 + 0.01'), (2, 'd BETWEEN 1 - 5 AND 2 + 3'), (3, 'i < 12 * 2'), (4, 'i > -5'), (5, 'i >= -(5)'),
(6, 'i < 3 - 10'), (7, 'i = 2 * 3 - 4'), (8, 'i IN (5, -5)'), (9, 'i IN (-5, 5)'), (10, 'i IN (-7, -5)'), (11, 'i IN (-5, 5, 0)'),
(12, 'i IN (1 + 1, 2 * 2, -3)'), (13, 'u < 10 + 5'), (14, 'u > 40 - 10'), (15, 'b < 1000 * 1000'), (16, 'b > -(1000 * 1000)'),
(17, 'f < 1.5 + 1.5'), (18, 'f >= -2.5 * 2'), (19, 'd < 5.25 * 2'), (20, 'd >= 1.1 + 1.1'), (21, 'd = 0.25 + 0.25'), (22, 'd <> 1.0 + 0.5'),
(23, 'ti BETWEEN -1 - 1 AND 1 + 1'), (24, 'ti NOT IN (1 + 1, -3)'), (25, 'n > 5 - 10'), (26, 'n IN (3, -3)'), (27, 'n BETWEEN 2 * -1 AND 2'),
(28, '5 - 3 > i'), (29, '-5 < i AND i < 10 / 2'), (30, 'i < 10 DIV 3'), (31, 'i < 7 MOD 4'), (32, 'd > ABS(-2) / 4'),
(33, 'i < 100 OR d > 2 + 2'), (34, 'NOT (i < 3 + 2)'), (35, 'i < (SELECT 5)'), (36, 'i < RAND() * 0 + 5'), (37, 'v = CONCAT(''s'', 3)'),
(38, 'f < 1.0e1 / 4'), (39, 'u < 4294967295 - 4294967290'), (40, 'b < 9223372036854775807 - 9223372036854775800');
# d BETWEEN 0.06 - 0.01 AND 0.06 + 0.01: 0 rows, same as InnoDB: 1
# d BETWEEN 1 - 5 AND 2 + 3: 243 rows, same as InnoDB: 1
# i < 12 * 2: 400 rows, same as InnoDB: 1
# i > -5: 241 rows, same as InnoDB: 1
# i >= -(5): 251 rows, same as InnoDB: 1
# i < 3 - 10: 129 rows, same as InnoDB: 1
# i = 2 * 3 - 4: 10 rows, same as InnoDB: 1
# i IN (5, -5): 20 rows, same as InnoDB: 1
# i IN (-5, 5): 20 rows, same as InnoDB: 1
# i IN (-7, -5): 20 rows, same as InnoDB: 1
# i IN (-5, 5, 0): 30 rows, same as InnoDB: 1
# i IN (1 + 1, 2 * 2, -3): 30 rows, same as InnoDB: 1
# u < 10 + 5: 164 rows, same as InnoDB: 1
# u > 40 - 10: 60 rows, same as InnoDB: 1
# b < 1000 * 1000: 200 rows, same as InnoDB: 1
# b > -(1000 * 1000): 201 rows, same as InnoDB: 1
# f < 1.5 + 1.5: 274 rows, same as InnoDB: 1
# f >= -2.5 * 2: 313 rows, same as InnoDB: 1
# d < 5.25 * 2: 400 rows, same as InnoDB: 1
# d >= 1.1 + 1.1: 132 rows, same as InnoDB: 1
# d = 0.25 + 0.25: 7 rows, same as InnoDB: 1
# d <> 1.0 + 0.5: 394 rows, same as InnoDB: 1
# ti BETWEEN -1 - 1 AND 1 + 1: 119 rows, same as InnoDB: 1
# ti NOT IN (1 + 1, -3): 353 rows, same as InnoDB: 1
# n > 5 - 10: 223 rows, same as InnoDB: 1
# n IN (3, -3): 24 rows, same as InnoDB: 1
# n BETWEEN 2 * -1 AND 2: 60 rows, same as InnoDB: 1
# 5 - 3 > i: 219 rows, same as InnoDB: 1
# -5 < i AND i < 10 / 2: 90 rows, same as InnoDB: 1
# i < 10 DIV 3: 229 rows, same as InnoDB: 1
# i < 7 MOD 4: 229 rows, same as InnoDB: 1
# d > ABS(-2) / 4: 170 rows, same as InnoDB: 1
# i < 100 OR d > 2 + 2: 400 rows, same as InnoDB: 1
# NOT (i < 3 + 2): 151 rows, same as InnoDB: 1
# i < (SELECT 5): 249 rows, same as InnoDB: 1
# i < RAND() * 0 + 5: 249 rows, same as InnoDB: 1
# v = CONCAT('s', 3): 45 rows, same as InnoDB: 1
# f < 1.0e1 / 4: 267 rows, same as InnoDB: 1
# u < 4294967295 - 4294967290: 54 rows, same as InnoDB: 1
# b < 9223372036854775807 - 9223372036854775800: 200 rows, same as InnoDB: 1
# the conditions with a constant that is an expression are not left to MySQL
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM t_w WHERE d BETWEEN 0.06 - 0.01 AND 0.06 + 0.01 AND i < 12 * 2;
EXPLAIN
-> Aggregate: count(0)  (cost=44.6 rows=1)
    -> Table scan on t_w  (cost=41.2 rows=14.9)

Warnings:
Note	1003	/* select#1 */ select count(0) AS `COUNT(*)` from `test`.`t_w` where ((`test`.`t_w`.`d` between <cache>((0.06 - 0.01)) and <cache>((0.06 + 0.01))) and (`test`.`t_w`.`i` < <cache>((12 * 2))))
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM t_w WHERE i IN (5, -5);
EXPLAIN
-> Aggregate: count(0)  (cost=59.7 rows=1)
    -> Table scan on t_w  (cost=41.2 rows=80.4)

Warnings:
Note	1003	/* select#1 */ select count(0) AS `COUNT(*)` from `test`.`t_w` where (`test`.`t_w`.`i` in (5,<cache>(-(5))))
DROP TABLE t_w, t_i, preds;
