# A SYNCHRONOUS view is used only while the WARP_MVIEW daemon keeps it
# current (the daemon is not loaded here)
CREATE MATERIALIZED VIEW v6 AS
SELECT p_name, COUNT(*) AS n FROM part GROUP BY p_name;
SELECT p_name, COUNT(*) FROM part GROUP BY p_name;
# not rewritten
# The privileges of the user: SELECT on the view too
CREATE DATABASE mvr;
CREATE TABLE mvr.t (id INT PRIMARY KEY, g INT, v INT);
INSERT INTO mvr.t VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30);
CREATE MATERIALIZED VIEW mvr.tv REFRESH MANUAL AS
SELECT g, SUM(v) AS s FROM mvr.t GROUP BY g;
CREATE USER mvr_user;
GRANT SELECT ON mvr.t TO mvr_user;
SET SESSION mview_rewrite_use_manual_views = ON;
SET SESSION mview_rewrite_trace = ON;
SELECT g, SUM(v) FROM mvr.t GROUP BY g;
g	SUM(v)
1	30
2	30
Warnings:
Note	1105	mview_rewrite: view `mvr`.`tv`: no SELECT privilege on the view
GRANT SELECT ON mvr.tv TO mvr_user;
SELECT g, SUM(v) FROM mvr.t GROUP BY g;
g	SUM(v)
1	30
2	30
