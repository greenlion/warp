SELECT o_custkey, COUNT(*) FROM orders GROUP BY o_custkey;
# not rewritten
SET SESSION mview_rewrite_use_manual_views = ON;
SELECT o_custkey, COUNT(*) FROM orders GROUP BY o_custkey;
# rewritten
SELECT `v5`.`mv$g0` AS `o_custkey`, CAST(COALESCE(SUM(`v5`.`mv$count`),0) AS SIGNED) AS `COUNT(*)` FROM `test`.`v5` `v5` GROUP BY `v5`.`mv$g0`
