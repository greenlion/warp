Note	1105	mview_rewrite: view `mvr`.`tv`: matches: SELECT `tv`.`mv$g0` AS `g`, `tv`.`mv$s1` AS `SUM(v)` FROM `mvr`.`tv` `tv`
Note	1105	Query 'SELECT g, SUM(v) FROM mvr.t GROUP BY g' rewritten to 'SELECT `tv`.`mv$g0` AS `g`, `tv`.`mv$s1` AS `SUM(v)` FROM `mvr`.`tv` `tv`' by a query rewrite plugin
# without SELECT on the base table the statement fails as before
REVOKE SELECT ON mvr.t FROM mvr_user;
SELECT g, SUM(v) FROM mvr.t GROUP BY g;
ERROR 42000: SELECT command denied to user 'mvr_user'@'localhost' for table 't'
DROP USER mvr_user;
DROP DATABASE mvr;
# A view that is dropped or created again is not used any more
DROP MATERIALIZED VIEW v5;
SELECT o_orderstatus, COUNT(*) FROM orders GROUP BY o_orderstatus;
# not rewritten
CREATE MATERIALIZED VIEW v5 REFRESH MANUAL AS
SELECT o_orderstatus, COUNT(*) AS n FROM orders WHERE o_custkey > 3
GROUP BY o_orderstatus;
SELECT o_orderstatus, COUNT(*) FROM orders GROUP BY o_orderstatus;
# not rewritten
SELECT o_orderstatus, COUNT(*) FROM orders WHERE o_custkey > 3 GROUP BY o_orderstatus;
# rewritten
SELECT `v5`.`mv$g0` AS `o_orderstatus`, `v5`.`mv$count` AS `COUNT(*)` FROM `test`.`v5` `v5`
SELECT o_orderstatus, COUNT(*) FROM orders WHERE o_custkey > 5 GROUP BY o_orderstatus;
# not rewritten
# REFRESH: the new contents are used
INSERT INTO orders VALUES (1000, 9, 'F', 1.00, '2026-01-01');
REFRESH MATERIALIZED VIEW v5;
SELECT o_orderstatus, COUNT(*) FROM orders WHERE o_custkey > 3 GROUP BY o_orderstatus;
# rewritten
SELECT `v5`.`mv$g0` AS `o_orderstatus`, `v5`.`mv$count` AS `COUNT(*)` FROM `test`.`v5` `v5`
#
# A WARP view stores strings in binary collations: its string columns
# do not stand for columns of other collations
#
CREATE TABLE tw (id INT PRIMARY KEY, name VARCHAR(10), v INT)
DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
INSERT INTO tw VALUES (1, 'a', 1), (2, 'A', 2), (3, 'b', 3);
CREATE MATERIALIZED VIEW vw ENGINE=WARP REFRESH MANUAL AS
SELECT name, COUNT(*) AS n, SUM(v) AS s FROM tw GROUP BY name;
SELECT name, COUNT(*) FROM tw GROUP BY name;
# not rewritten
SELECT COUNT(*), SUM(v) FROM tw;
# rewritten
SELECT CAST(COALESCE(SUM(`vw`.`mv$count`),0) AS SIGNED) AS `COUNT(*)`, SUM(`vw`.`mv$s1`) AS `SUM(v)` FROM `test`.`vw` `vw`
#
# The filter tree: the views it leaves out
#
SELECT COUNT(*) FROM nation;
COUNT(*)
5
SET SESSION mview_rewrite_use_filter_tree = OFF;
SELECT COUNT(*) FROM nation;
COUNT(*)
5
SET SESSION mview_rewrite_use_filter_tree = ON;
# views tested with the filter tree: 0, without: 0
DROP MATERIALIZED VIEW v2, v3, v4, v5, v6, vw;
DROP TABLE lineitem, orders, part, customer, nation, tw;
