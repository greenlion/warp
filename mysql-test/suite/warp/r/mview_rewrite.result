# outer joins, subqueries, locking reads
SELECT o_custkey, COUNT(*) FROM orders LEFT JOIN lineitem ON l_orderkey = o_orderkey GROUP BY o_custkey;
# not rewritten
SELECT o_custkey, COUNT(*) FROM orders WHERE o_custkey IN (SELECT c_custkey FROM customer) GROUP BY o_custkey;
# not rewritten
SELECT o_custkey, COUNT(*) FROM orders GROUP BY o_custkey LIMIT 1 FOR UPDATE;
