SET SESSION mview_rewrite_trace = OFF;
# INSERT ... SELECT is not rewritten, with or without WITH
CREATE TABLE copy (k INT, n INT);
INSERT INTO copy WITH t AS (SELECT o_custkey, COUNT(*) AS n FROM orders GROUP BY o_custkey) SELECT * FROM t;
SELECT COUNT(*), SUM(n) FROM copy;
COUNT(*)	SUM(n)
30	200
DROP TABLE copy;
DROP MATERIALIZED VIEW by_cust;
DROP MATERIALIZED VIEW by_nation;
DROP TABLE returned, orders, customer;
