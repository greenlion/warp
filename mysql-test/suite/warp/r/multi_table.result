#
# Joins and multi-table UPDATE / DELETE (positioned reads by rowid).
# The same statements are run against InnoDB and the results compared.
#
# Nested loop joins between two WARP tables are covered by
# warp.nested_loop_join, so the joins between WARP tables use a hash
# join and the multi-table statements join with InnoDB.
#
SET SESSION cte_max_recursion_depth = 100000;
SET SESSION group_concat_max_len = 1000000;
CREATE TABLE wf (id INT, k INT, s VARCHAR(20), n INT NULL) ENGINE=WARP
DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE wd (id INT, tag VARCHAR(10)) ENGINE=WARP
DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO wf WITH RECURSIVE seq(x) AS
(SELECT 1 UNION ALL SELECT x + 1 FROM seq WHERE x < 5000)
SELECT x, x % 50, CONCAT('row', x), x % 7 FROM seq;
INSERT INTO wd WITH RECURSIVE seq(x) AS
(SELECT 10 UNION ALL SELECT x + 10 FROM seq WHERE x < 5000)
SELECT x, CONCAT('t', x % 7) FROM seq;
CREATE TABLE inf ENGINE=InnoDB SELECT * FROM wf;
CREATE TABLE ind ENGINE=InnoDB SELECT * FROM wd;
ALTER TABLE ind ADD INDEX (id);
# Hash joins between WARP tables
SELECT /*+ BNL(f, d) */ COUNT(*), SUM(f.k) FROM wf f JOIN wd d ON f.id = d.id WHERE d.tag = 't3';
COUNT(*)	SUM(f.k)
72	1440
SELECT COUNT(*), SUM(f.k) FROM inf f JOIN ind d ON f.id = d.id WHERE d.tag = 't3';
COUNT(*)	SUM(f.k)
72	1440
SELECT /*+ BNL(f, d) */ d.tag, COUNT(*) FROM wf f JOIN wd d ON f.id = d.id GROUP BY d.tag ORDER BY d.tag;
tag	COUNT(*)
t0	71
t1	71
t2	72
t3	72
t4	71
t5	71
t6	72
SELECT d.tag, COUNT(*) FROM inf f JOIN ind d ON f.id = d.id GROUP BY d.tag ORDER BY d.tag;
tag	COUNT(*)
t0	71
t1	71
t2	72
t3	72
t4	71
t5	71
t6	72
# Joins between WARP and InnoDB tables
SELECT COUNT(*), SUM(f.k) FROM wf f JOIN ind d ON f.id = d.id WHERE d.tag = 't3';
COUNT(*)	SUM(f.k)
72	1440
SELECT COUNT(*), SUM(f.k) FROM ind d STRAIGHT_JOIN wf f ON f.id = d.id WHERE d.tag = 't3';
COUNT(*)	SUM(f.k)
72	1440
# Multi-table UPDATE
UPDATE wf f JOIN ind d ON f.id = d.id SET f.s = d.tag, f.n = NULL WHERE d.tag = 't3';
UPDATE inf f JOIN ind d ON f.id = d.id SET f.s = d.tag, f.n = NULL WHERE d.tag = 't3';
# Multi-table DELETE
DELETE f FROM wf f JOIN ind d ON f.id = d.id WHERE d.tag = 't5';
DELETE f FROM inf f JOIN ind d ON f.id = d.id WHERE d.tag = 't5';
SELECT COUNT(*), SUM(s = 't3'), SUM(n IS NULL) FROM wf;
COUNT(*)	SUM(s = 't3')	SUM(n IS NULL)
4929	72	72
SELECT COUNT(*), SUM(s = 't3'), SUM(n IS NULL) FROM inf;
COUNT(*)	SUM(s = 't3')	SUM(n IS NULL)
4929	72	72
WARP and InnoDB contents are identical
# Rolled back multi-table UPDATE leaves the table unchanged
BEGIN;
UPDATE wf f JOIN ind d ON f.id = d.id SET f.s = 'rolled' WHERE d.tag = 't1';
SELECT SUM(s = 'rolled') FROM wf;
SUM(s = 'rolled')
71
ROLLBACK;
SELECT SUM(s = 'rolled') FROM wf;
SUM(s = 'rolled')
0
DROP TABLE wf, wd, inf, ind;
