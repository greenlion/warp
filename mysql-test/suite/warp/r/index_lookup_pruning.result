#
# An index lookup of one integer value only opens the partitions whose
# values of the column contain it (their smallest and largest values are
# kept for every version of a partition), and the lookups of a statement
# use the partitions that they opened again.
#
SET SESSION cte_max_recursion_depth = 300000;
CREATE TABLE t (id INT, k INT, v VARCHAR(10), KEY (id), KEY (k)) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
# partitions of 64000 rows: id 1..64000, 64001..128000, ...
INSERT INTO t WITH RECURSIVE seq(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM seq WHERE x < 200000)
SELECT x, x % 7, CONCAT('v', x) FROM seq;
SELECT * FROM t FORCE INDEX (id) WHERE id = 1;
id	k	v
1	1	v1
SELECT * FROM t FORCE INDEX (id) WHERE id = 100000;
id	k	v
100000	5	v100000
SELECT * FROM t FORCE INDEX (id) WHERE id = 200000;
id	k	v
200000	3	v200000
# values that no partition has
SELECT * FROM t FORCE INDEX (id) WHERE id = 0;
id	k	v
SELECT * FROM t FORCE INDEX (id) WHERE id = 999999;
id	k	v
SELECT * FROM t FORCE INDEX (id) WHERE id = -5;
id	k	v
SELECT * FROM t FORCE INDEX (id) WHERE id IN (0, 3, 999999, 128001, 199999, -1) ORDER BY id;
id	k	v
3	3	v3
128001	6	v128001
199999	2	v199999
# a value that every partition has
SELECT COUNT(*) FROM t FORCE INDEX (k) WHERE k = 3;
COUNT(*)
28572
SELECT COUNT(*) FROM t;
COUNT(*)
200000
# new rows: the partition changed, its range is found again
INSERT INTO t VALUES (999999, 1, 'new'), (-5, 2, 'neg');
SELECT * FROM t FORCE INDEX (id) WHERE id = 999999;
id	k	v
999999	1	new
SELECT * FROM t FORCE INDEX (id) WHERE id = -5;
id	k	v
-5	2	neg
DELETE FROM t WHERE id = 100000;
SELECT * FROM t FORCE INDEX (id) WHERE id = 100000;
id	k	v
# a lookup for every row of another table (a dependent subquery)
CREATE TABLE o (id INT) ENGINE=WARP;
INSERT INTO o VALUES (1), (64000), (64001), (100000), (128000), (128001), (200000), (200001), (999999), (-5);
SELECT o.id, (SELECT v FROM t FORCE INDEX (id) WHERE t.id = o.id) AS v FROM o ORDER BY o.id;
id	v
-5	neg
1	v1
64000	v64000
64001	v64001
100000	NULL
128000	v128000
128001	v128001
200000	v200000
200001	NULL
999999	new
SELECT o.id FROM o WHERE EXISTS (SELECT 1 FROM t FORCE INDEX (id) WHERE t.id = o.id AND t.k >= 0) ORDER BY o.id;
id
-5
1
64000
64001
128000
128001
200000
999999
# in a transaction, with rows that it wrote
BEGIN;
INSERT INTO t VALUES (777777, 0, 'trx');
SELECT o.id, (SELECT v FROM t FORCE INDEX (id) WHERE t.id = o.id + 577776) AS v FROM o WHERE o.id IN (200001, 1) ORDER BY o.id;
id	v
1	NULL
200001	trx
SELECT * FROM t FORCE INDEX (id) WHERE id = 777777;
id	k	v
777777	0	trx
ROLLBACK;
SELECT * FROM t FORCE INDEX (id) WHERE id = 777777;
id	k	v
DROP TABLE t, o;
