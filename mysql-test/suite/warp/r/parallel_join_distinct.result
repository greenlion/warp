#
# The join that the engine makes (warp_parallel_hash_join) is read for the
# distinct values of columns of one of its tables only: the subquery of IN
# that MySQL materializes without duplicates, the materialized subquery of
# a semijoin, SELECT DISTINCT in a derived table.  The engine returns a row
# of that table in one row of the join, not in every row that it is joined
# to (TPC-DS query 14: 100 million rows of the join for 16 thousand items).
# Every query is run against the WARP tables (suffix w) and against InnoDB
# copies of them (suffix i) and the rows are compared.
#
call mtr.add_suppression("MY-015655");
SET SESSION warp_parallel_join_min_rows = 0;
SET SESSION warp_parallel_min_rows = 1;
SET SESSION cte_max_recursion_depth = 10000;
CREATE TABLE f_w (k INT, d INT) ENGINE=WARP;
CREATE TABLE a_w (id INT, g INT) ENGINE=WARP;
CREATE TABLE b_w (id INT, g INT, v INT) ENGINE=WARP;
CREATE TABLE o_w (x INT, y INT) ENGINE=WARP;
INSERT INTO a_w WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 200) SELECT n, n % 7 FROM s;
INSERT INTO b_w WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 300) SELECT n, n % 10, IF(n % 13 = 0, NULL, n % 50) FROM s;
INSERT INTO f_w WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 5000) SELECT n % 150, n % 5 FROM s;
INSERT INTO o_w WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 400) SELECT n, n % 60 FROM s;
INSERT INTO o_w VALUES (NULL, NULL), (1000, 1000);
CREATE TABLE f_i ENGINE=InnoDB SELECT * FROM f_w;
CREATE TABLE a_i ENGINE=InnoDB SELECT * FROM a_w;
CREATE TABLE b_i ENGINE=InnoDB SELECT * FROM b_w;
CREATE TABLE o_i ENGINE=InnoDB SELECT * FROM o_w;
# optimizer_switch: semijoin=off,subquery_to_derived=off
SET SESSION optimizer_switch = 'semijoin=off,subquery_to_derived=off';
# case 1: the subquery of IN returns a column of the last table of the join
210:31380
EXPLAIN FORMAT=TREE SELECT COUNT(*), SUM(x) FROM o_w WHERE x IN (SELECT b.id FROM f_w f, a_w a, b_w b WHERE f.k = a.id AND a.g = b.g);
EXPLAIN
-> Aggregate: count(0), sum(o_w.x)
    -> Filter: <in_optimizer>(o_w.x,o_w.x in (select #2))
        -> Table scan on o_w
        -> Select #2 (subquery in condition; run only once)
            -> Filter: ((o_w.x = `<materialized_subquery>`.id))
                -> Limit: 1 row(s)
                    -> Index lookup on <materialized_subquery> using <auto_distinct_key> (id = o_w.x)
                        -> Materialize with deduplication
                            -> Nested loop inner join
                                -> Nested loop inner join
                                    -> Table scan on f, with parallel hash join (distinct rows of b)
                                    -> Table scan on a, joined by the parallel hash join
                                -> Table scan on b, joined by the parallel hash join

Warnings:
Note	1003	/* select#1 */ select count(0) AS `COUNT(*)`,sum(`test`.`o_w`.`x`) AS `SUM(x)` from `test`.`o_w` where <in_optimizer>(`test`.`o_w`.`x`,`test`.`o_w`.`x` in ( <materialize> (/* select#2 */ select `b`.`id` from `test`.`f_w` `f` join `test`.`a_w` `a` join `test`.`b_w` `b` where ((`f`.`k` = `a`.`id`) and (`b`.`g` = `a`.`g`)) ), <primary_index_lookup>(`test`.`o_w`.`x` in <temporary table> on <auto_distinct_key> where ((`test`.`o_w`.`x` = `<materialized_subquery>`.`id`)))))
# case 2: a nullable column, conditions on the tables
238:47314
EXPLAIN FORMAT=TREE SELECT COUNT(*), SUM(x) FROM o_w WHERE y IN (SELECT b.v FROM f_w f, a_w a, b_w b WHERE f.k = a.id AND a.g = b.g AND f.d = 1);
EXPLAIN
-> Aggregate: count(0), sum(o_w.x)
    -> Filter: <in_optimizer>(o_w.y,o_w.y in (select #2))
        -> Table scan on o_w
        -> Select #2 (subquery in condition; run only once)
            -> Filter: ((o_w.y = `<materialized_subquery>`.v))
                -> Limit: 1 row(s)
                    -> Index lookup on <materialized_subquery> using <auto_distinct_key> (v = o_w.y)
                        -> Materialize with deduplication
                            -> Nested loop inner join
                                -> Nested loop inner join
                                    -> Table scan on f, with parallel hash join (distinct rows of b)
                                    -> Table scan on a, joined by the parallel hash join
                                -> Table scan on b, joined by the parallel hash join

