#
# Comparisons of BIGINT and BIGINT UNSIGNED columns with constants that
# can not be represented exactly as a double (magnitude 2^53 or more),
# and negated IN / BETWEEN.  Every comparison is also run against InnoDB.
#
# Regression test: such comparisons used to be evaluated by FastBit in
# double precision, unsigned constants above 2^63-1 were sent as
# negative numbers, and NOT IN / NOT BETWEEN were pushed down as IN /
# BETWEEN.  FastBit now compares 64-bit integers exactly for =, !=,
# <, <=, >, >=, BETWEEN and IN.
#
CREATE TABLE w (id INT, b BIGINT, u BIGINT UNSIGNED) ENGINE=WARP;
CREATE TABLE i LIKE w;
ALTER TABLE i ENGINE=InnoDB;
INSERT INTO w VALUES
(1, -9223372036854775808, 0), (2, -9223372036854775807, 1),
(3, -9223372036854775806, 2),
(4, 9223372036854775807, 18446744073709551615),
(5, 9223372036854775806, 18446744073709551614),
(6, 9007199254740992, 9007199254740992), (7, 9007199254740993, 9007199254740993),
(8, 9007199254740994, 9007199254740994), (9, -9007199254740993, 9223372036854775808),
(10, 0, 9223372036854775807), (11, 12345, 12345), (12, NULL, NULL);
INSERT INTO i SELECT * FROM w;
96 single comparisons checked, 0 mismatches
# Lists, ranges and negations
WHERE b BETWEEN 9007199254740992 AND 9007199254740993: ids 6,7
WHERE b IN (-9223372036854775808, 9007199254740993): ids 1,7
WHERE b NOT IN (-9223372036854775808, 9007199254740993): ids 2,3,4,5,6,8,9,10,11
WHERE u IN (18446744073709551615, 9223372036854775808): ids 4,9
WHERE u BETWEEN 9223372036854775807 AND 18446744073709551614: ids 5,9,10
WHERE b = 9007199254740993 OR b = 0: ids 7,10
WHERE b IN (1, 2, 12345): ids 11
WHERE b IN (12345, 0): ids 10,11
WHERE u NOT IN (0, 1): ids 3,4,5,6,7,8,9,10,11
WHERE b NOT IN (12345, 0): ids 1,2,3,4,5,6,7,8,9
WHERE b NOT BETWEEN 0 AND 20000: ids 1,2,3,4,5,6,7,8,9
WHERE b IN (9007199254740993): ids 7
WHERE u = 9223372036854775808 OR u = 0: ids 1,9
WHERE b IN (-9223372036854775808, 9223372036854775807, 0): ids 1,4,10
# Comparisons with such constants are pushed down, NOT IN is
# evaluated by MySQL
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE b = 9007199254740993;
EXPLAIN
-> Aggregate: count(0)  
    -> Table scan on w  

Warnings:
Note	1003	/* select#1 */ select count(0) AS `COUNT(*)` from `test`.`w` where (`test`.`w`.`b` = 9007199254740993)
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE u IN (0, 18446744073709551615);
EXPLAIN
-> Aggregate: count(0)  
    -> Table scan on w  

Warnings:
Note	1003	/* select#1 */ select count(0) AS `COUNT(*)` from `test`.`w` where (`test`.`w`.`u` in (0,18446744073709551615))
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE b > 9007199254740993;
EXPLAIN
-> Aggregate: count(0)  
    -> Table scan on w  

Warnings:
Note	1003	/* select#1 */ select count(0) AS `COUNT(*)` from `test`.`w` where (`test`.`w`.`b` > 9007199254740993)
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE u BETWEEN 9223372036854775807 AND 18446744073709551614;
EXPLAIN
-> Aggregate: count(0)  
    -> Table scan on w  

Warnings:
Note	1003	/* select#1 */ select count(0) AS `COUNT(*)` from `test`.`w` where (`test`.`w`.`u` between 9223372036854775807 and 18446744073709551614)
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE b NOT IN (1, 2);
EXPLAIN
-> Aggregate: count(0)  
    -> Filter: (w.b not in (1,2))  
        -> Table scan on w  

Warnings:
Note	1003	/* select#1 */ select count(0) AS `COUNT(*)` from `test`.`w` where (`test`.`w`.`b` not in (1,2))
DROP TABLE w, i;
# Many rows clustered around values that are equal as doubles
SET SESSION cte_max_recursion_depth = 100000;
CREATE TABLE w (id INT, b BIGINT, u BIGINT UNSIGNED) ENGINE=WARP;
CREATE TABLE i LIKE w;
ALTER TABLE i ENGINE=InnoDB;
INSERT INTO w WITH RECURSIVE s(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM s WHERE x < 30000)
SELECT x,
CASE x % 3 WHEN 0 THEN 9007199254740992 + (x % 1000) - 500
WHEN 1 THEN 9223372036854775807 - (x % 2000)
ELSE -9223372036854775808 + (x % 777) END,
18446744073709551615 - (x % 5000)
FROM s;
INSERT INTO i SELECT * FROM w;
WHERE b > 9007199254740993: rows:sum(id) = 14980:225942490
WHERE b >= 9007199254740992: rows:sum(id) = 15000:226232500
WHERE b <= 9007199254740991: rows:sum(id) = 15000:223782500
WHERE b BETWEEN 9007199254740990 AND 9007199254740995: rows:sum(id) = 60:900030
WHERE b > 9223372036854775000: rows:sum(id) = 4035:58116105
WHERE b >= 9223372036854774000 AND b < 9223372036854775807: rows:sum(id) = 9035:134647640
WHERE b BETWEEN -9223372036854775808 AND -9223372036854775800: rows:sum(id) = 117:1727856
WHERE u > 18446744073709550000: rows:sum(id) = 9690:128974830
WHERE u BETWEEN 18446744073709547000 AND 18446744073709547010: rows:sum(id) = 66:1129260
WHERE u < 18446744073709551615 AND b > 0: rows:sum(id) = 19996:299930000
DROP TABLE w, i;
