INSERT INTO i SELECT * FROM w;
# Number of partition directories
partitions: 4
SELECT COUNT(*), SUM(id), MIN(id), MAX(id) FROM w;
COUNT(*)	SUM(id)	MIN(id)	MAX(id)
200020	20006100210	1	300020
SELECT COUNT(*), SUM(id), MIN(id), MAX(id) FROM i;
COUNT(*)	SUM(id)	MIN(id)	MAX(id)
200020	20006100210	1	300020
SELECT COUNT(*) FROM w WHERE k = 999;
COUNT(*)
200
SELECT COUNT(*) FROM i WHERE k = 999;
COUNT(*)
200
SELECT COUNT(*) FROM w WHERE s = 'str-7' AND d >= '2005-01-01';
COUNT(*)
250
SELECT COUNT(*) FROM i WHERE s = 'str-7' AND d >= '2005-01-01';
COUNT(*)
250
SELECT COUNT(*) FROM w WHERE id BETWEEN 63990 AND 64010;
COUNT(*)
21
WARP and InnoDB contents are identical
# Updates and deletes across partitions
UPDATE w SET k = -1 WHERE id % 50000 = 0;
DELETE FROM w WHERE id BETWEEN 63995 AND 64005;
SELECT COUNT(*), SUM(k = -1) FROM w;
COUNT(*)	SUM(k = -1)
200009	4
DROP TABLE w, i;
