SELECT 'only in WARP', x.* FROM (SELECT id, c_tiny, c_utiny, c_small, c_med, c_int, c_uint, c_big, c_ubig, c_dec, c_dec_nn, c_bigdec, c_dec0, c_udec, c_float, c_double, c_char, c_varchar, c_varchar_nn, c_utf8, HEX(c_bin), HEX(c_varbin), c_text, HEX(c_blob), c_enum, c_set, c_date, c_time, c_datetime, c_ts, c_year, HEX(c_bit), c_json FROM t_w EXCEPT SELECT id, c_tiny, c_utiny, c_small, c_med, c_int, c_uint, c_big, c_ubig, c_dec, c_dec_nn, c_bigdec, c_dec0, c_udec, c_float, c_double, c_char, c_varchar, c_varchar_nn, c_utf8, HEX(c_bin), HEX(c_varbin), c_text, HEX(c_blob), c_enum, c_set, c_date, c_time, c_datetime, c_ts, c_year, HEX(c_bit), c_json FROM t_i) x;
