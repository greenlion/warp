# a join with a lookup for every row
SELECT a.id, b.c_dec, b.c_varchar FROM t_i a JOIN t_w b ON b.id = a.id ORDER BY a.id;
id	c_dec	c_varchar
1	-99999.99	hello world
2	NULL	NULL
3	99999.99	
4	0.00	 lead and trail 
5	5.50	five
# a derived table that is materialized
SELECT d.id, d.amount FROM (SELECT id, c_dec AS amount FROM t_w UNION ALL
SELECT id, c_dec_nn FROM t_w) d ORDER BY d.id, d.amount;
id	amount
1	-99999.99
1	0.00
2	NULL
2	12345.67
3	-0.01
3	99999.99
4	0.00
4	0.10
5	5.05
5	5.50
# rows that are updated and deleted are read by the scan
UPDATE t_w SET c_dec = c_dec + 1, c_varchar = CONCAT(c_varchar, '!') WHERE id IN (1, 4);
UPDATE t_w SET c_dec = NULL, c_varchar_nn = 'was five' WHERE id = 5;
UPDATE t_w SET c_dec = 1.23 WHERE id = 2;
DELETE FROM t_w WHERE id = 3;
SELECT id, c_dec, c_dec_nn, c_varchar, c_varchar_nn FROM t_w ORDER BY id;
id	c_dec	c_dec_nn	c_varchar	c_varchar_nn
1	-99998.99	0.00	hello world!	
2	1.23	12345.67	NULL	not null
4	1.00	0.10	 lead and trail !	0.50
5	NULL	5.05	five	was five
# more rows than one partition of the tail, with NULLs
SET SESSION cte_max_recursion_depth = 100000;
CREATE TABLE t_n (id INT NOT NULL, d DECIMAL(7,2), s VARCHAR(20), dnn DECIMAL(15,3) NOT NULL) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO t_n
WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 50000)
SELECT n, IF(n % 7 = 0, NULL, (n % 1000) - 500 + (n % 100) / 100),
IF(n % 5 = 0, NULL, CONCAT('s', n % 13)), n / 8 - 3000 FROM seq;
SELECT COUNT(*), COUNT(d), SUM(d), MIN(d), MAX(d), COUNT(s), COUNT(DISTINCT s), MIN(s), MAX(s),
SUM(dnn), MIN(dnn), MAX(dnn) FROM t_n;
COUNT(*)	COUNT(d)	SUM(d)	MIN(d)	MAX(d)	COUNT(s)	COUNT(DISTINCT s)	MIN(s)	MAX(s)	SUM(dnn)	MIN(dnn)	MAX(dnn)
50000	42858	-356.71	-500.00	499.99	40000	13	s0	s9	6253125.000	-2999.875	3250.000
SELECT COUNT(*), SUM(x.d), SUM(x.dnn), COUNT(x.s) FROM (SELECT id, d, s, dnn FROM t_n UNION ALL SELECT id, d, s, dnn FROM t_n) x
WHERE x.id % 3 = 0;
COUNT(*)	SUM(x.d)	SUM(x.dnn)	COUNT(x.s)
33332	428.86	4168583.250	26666
