SET time_zone = '+00:00';
DROP TABLE IF EXISTS t_w, t_i;
CREATE TABLE t_i (
id INT NOT NULL PRIMARY KEY,
c_tiny TINYINT, c_utiny TINYINT UNSIGNED, c_small SMALLINT, c_med MEDIUMINT,
c_int INT, c_uint INT UNSIGNED, c_big BIGINT, c_ubig BIGINT UNSIGNED,
c_dec DECIMAL(7,2), c_dec_nn DECIMAL(7,2) NOT NULL, c_bigdec DECIMAL(38,10),
c_dec0 DECIMAL(10,0), c_udec DECIMAL(12,4) UNSIGNED,
c_float FLOAT, c_double DOUBLE,
c_char CHAR(10), c_varchar VARCHAR(100), c_varchar_nn VARCHAR(20) NOT NULL,
c_utf8 VARCHAR(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_as_cs,
c_bin BINARY(4), c_varbin VARBINARY(20), c_text TEXT, c_blob BLOB,
c_enum ENUM('a','b','c'), c_set SET('x','y','z'),
c_date DATE, c_time TIME, c_datetime DATETIME(3), c_ts TIMESTAMP NULL, c_year YEAR,
c_bit BIT(12), c_json JSON
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
Warnings:
Warning	1681	UNSIGNED for decimal and floating point data types is deprecated and support for it will be removed in a future release.
