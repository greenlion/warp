#
# The engine joins WARP tables itself (warp_parallel_hash_join): hash tables
# are made of the smaller tables and the partitions of the largest one are
# probed.  The result must be what MySQL gives.  Every query is run against
# the WARP tables (suffix w) and against InnoDB copies of them (suffix i) and
# a checksum of the rows is compared.
#
SET SESSION warp_parallel_join_min_rows = 0;
SET SESSION cte_max_recursion_depth = 10000;
SET SESSION join_buffer_size = 2048;
SET SESSION optimizer_switch = 'subquery_to_derived=on';
CREATE TABLE f_w (id INT, k1 INT, k2 INT, k3 BIGINT, u INT UNSIGNED, t TINYINT, s VARCHAR(10), n INT NULL, v INT)
ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE d1_w (k INT, a VARCHAR(8), b INT, kk INT NULL) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE d2_w (k BIGINT, c VARCHAR(8), flag INT, k1 INT) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE d3_w (x INT, y INT, z VARCHAR(8)) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE d4_w (m INT, w INT) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO f_w WITH RECURSIVE s(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM s WHERE x < 3000)
SELECT x, 1 + x % 40, 1 + x % 25, 1 + x % 17, x % 9, x % 5, CONCAT('s', x % 11), IF(x % 7 = 0, NULL, x % 13), x % 100 FROM s;
INSERT INTO d1_w WITH RECURSIVE s(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM s WHERE x < 45)
SELECT x, CONCAT('A', x % 4), x % 6, IF(x % 10 = 0, NULL, 1 + x % 20) FROM s;
INSERT INTO d1_w VALUES (3, 'dup', 99, 3), (3, 'dup2', 98, 4);
INSERT INTO d2_w WITH RECURSIVE s(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM s WHERE x < 20)
SELECT x, CONCAT('C', x % 3), x % 2, 1 + x % 40 FROM s;
INSERT INTO d3_w WITH RECURSIVE s(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM s WHERE x < 60)
SELECT 1 + x % 40, 1 + x % 25, CONCAT('Z', x % 5) FROM s;
INSERT INTO d4_w VALUES (0, 10), (1, 11), (2, 12), (3, 13), (4, 14), (NULL, 15);
CREATE TABLE f_i LIKE f_w;
CREATE TABLE d1_i LIKE d1_w;
CREATE TABLE d2_i LIKE d2_w;
CREATE TABLE d3_i LIKE d3_w;
CREATE TABLE d4_i LIKE d4_w;
ALTER TABLE f_i ENGINE=InnoDB;
ALTER TABLE d1_i ENGINE=InnoDB;
ALTER TABLE d2_i ENGINE=InnoDB;
ALTER TABLE d3_i ENGINE=InnoDB;
ALTER TABLE d4_i ENGINE=InnoDB;
INSERT INTO f_i SELECT * FROM f_w;
INSERT INTO d1_i SELECT * FROM d1_w;
INSERT INTO d2_i SELECT * FROM d2_w;
INSERT INTO d3_i SELECT * FROM d3_w;
INSERT INTO d4_i SELECT * FROM d4_w;
# case 1: star, two dimensions, one key matches several rows
1260:2706144905499
EXPLAIN FORMAT=TREE SELECT f.id, d1.a, d1.b, d2.c FROM f_w f JOIN d1_w d1 ON f.k1 = d1.k JOIN d2_w d2 ON f.k2 = d2.k WHERE d2.flag = 1;
EXPLAIN
-> Nested loop inner join
    -> Nested loop inner join
        -> Table scan on f, with parallel hash join
        -> Table scan on d2, joined by the parallel hash join
    -> Table scan on d1, joined by the parallel hash join

Warnings:
Note	1003	/* select#1 */ select `f`.`id` AS `id`,`d1`.`a` AS `a`,`d1`.`b` AS `b`,`d2`.`c` AS `c` from `test`.`f_w` `f` join `test`.`d1_w` `d1` join `test`.`d2_w` `d2` where ((`d1`.`k` = `f`.`k1`) and (`d2`.`flag` = 1) and (`f`.`k2` = `d2`.`k`))
# case 2: filters on dimensions, a dimension with a condition on both sides
195:413706298965
EXPLAIN FORMAT=TREE SELECT f.id, d1.a, d2.c FROM f_w f, d1_w d1, d2_w d2 WHERE f.k1 = d1.k AND f.k2 = d2.k AND d1.b > 2 AND d2.c = 'C1' AND f.v < 50;
EXPLAIN
-> Nested loop inner join
    -> Nested loop inner join
        -> Table scan on f, with parallel hash join
        -> Table scan on d2, joined by the parallel hash join
    -> Table scan on d1, joined by the parallel hash join

Warnings:
Note	1003	/* select#1 */ select `f`.`id` AS `id`,`d1`.`a` AS `a`,`d2`.`c` AS `c` from `test`.`f_w` `f` join `test`.`d1_w` `d1` join `test`.`d2_w` `d2` where ((`d2`.`c` = 'C1') and (`d1`.`k` = `f`.`k1`) and (`f`.`k2` = `d2`.`k`) and (`d1`.`b` > 2) and (`f`.`v` < 50))
# case 3: snowflake: a dimension of a dimension
1575:3337764591399
EXPLAIN FORMAT=TREE SELECT f.id, d1.a, d2.c FROM f_w f JOIN d1_w d1 ON f.k1 = d1.k JOIN d2_w d2 ON d1.kk = d2.k WHERE d2.flag = 0;
EXPLAIN
-> Nested loop inner join
    -> Nested loop inner join
        -> Table scan on f, with parallel hash join
        -> Table scan on d1, joined by the parallel hash join
    -> Table scan on d2, joined by the parallel hash join

Warnings:
Note	1003	/* select#1 */ select `f`.`id` AS `id`,`d1`.`a` AS `a`,`d2`.`c` AS `c` from `test`.`f_w` `f` join `test`.`d1_w` `d1` join `test`.`d2_w` `d2` where ((`f`.`k1` = `d1`.`k`) and (`d2`.`flag` = 0) and (`d1`.`kk` = `d2`.`k`))
# case 4: a derived table with a key on a column of a joined table (IN with GROUP BY and HAVING)
1170:2524356949313
EXPLAIN FORMAT=TREE SELECT f.id, d1.a, d1.b FROM f_w f, d1_w d1 WHERE f.k1 = d1.k AND d1.k IN (SELECT x FROM d3_w GROUP BY x HAVING COUNT(*) >= 2) AND f.v < 70;
EXPLAIN
-> Nested loop inner join
    -> Nested loop inner join
        -> Table scan on f, with parallel hash join
        -> Table scan on d1, joined by the parallel hash join
    -> Covering index lookup on derived_1_2 using <auto_key0> (Name_exp_1 = f.k1)
        -> Materialize
            -> Filter: (count(0) >= 2)
                -> Table scan on <temporary>
                    -> Aggregate using temporary table
                        -> Table scan on d3_w, with parallel aggregation

Warnings:
Note	1003	/* select#1 */ select `f`.`id` AS `id`,`d1`.`a` AS `a`,`d1`.`b` AS `b` from `test`.`f_w` `f` join `test`.`d1_w` `d1` join (/* select#2 */ select `test`.`d3_w`.`x` AS `Name_exp_1` from `test`.`d3_w` group by `test`.`d3_w`.`x` having (count(0) >= 2)) `derived_1_2` where ((`d1`.`k` = `f`.`k1`) and (`derived_1_2`.`Name_exp_1` = `f`.`k1`) and (`f`.`v` < 70))
# case 5: a derived table that matches nothing, and one with NULLs in its key
0:0
EXPLAIN FORMAT=TREE SELECT f.id, d1.a FROM f_w f, d1_w d1 WHERE f.k1 = d1.k AND d1.kk IN (SELECT kk FROM d1_w GROUP BY kk HAVING COUNT(*) > 1000);
EXPLAIN
-> Nested loop inner join
    -> Nested loop inner join
        -> Table scan on f, with parallel hash join
        -> Table scan on d1, joined by the parallel hash join
    -> Covering index lookup on derived_1_2 using <auto_key0> (Name_exp_1 = d1.kk)
        -> Materialize
            -> Filter: (count(0) > 1000)
                -> Table scan on <temporary>
                    -> Aggregate using temporary table
                        -> Table scan on d1_w, with parallel aggregation

Warnings:
