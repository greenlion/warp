# case 24: a LEFT JOIN with a condition of the WHERE clause on the inner table
1800:3864456740923
EXPLAIN FORMAT=TREE SELECT f.id, d2.c FROM f_w f LEFT JOIN d2_w d2 ON f.k2 = d2.k WHERE d2.flag = 0 OR d2.c IS NULL;
EXPLAIN
-> Filter: ((d2.flag = 0) or (d2.c is null))
    -> Nested loop left join
        -> Table scan on f, with parallel hash join
        -> Table scan on d2, joined by the parallel hash join

Warnings:
Note	1003	/* select#1 */ select `f`.`id` AS `id`,`d2`.`c` AS `c` from `test`.`f_w` `f` left join `test`.`d2_w` `d2` on((`f`.`k2` = `d2`.`k`)) where ((`d2`.`flag` = 0) or (`d2`.`c` is null))
# the join is done by the engine: the tables of the join are replaced by one scan
EXPLAIN FORMAT=TREE SELECT f.id, d1.a, d2.c FROM f_w f JOIN d1_w d1 ON f.k1 = d1.k JOIN d2_w d2 ON f.k2 = d2.k WHERE d2.flag = 1;
EXPLAIN
-> Nested loop inner join
    -> Nested loop inner join
        -> Table scan on f, with parallel hash join
        -> Table scan on d2, joined by the parallel hash join
    -> Table scan on d1, joined by the parallel hash join

Warnings:
Note	1003	/* select#1 */ select `f`.`id` AS `id`,`d1`.`a` AS `a`,`d2`.`c` AS `c` from `test`.`f_w` `f` join `test`.`d1_w` `d1` join `test`.`d2_w` `d2` where ((`d1`.`k` = `f`.`k1`) and (`d2`.`flag` = 1) and (`f`.`k2` = `d2`.`k`))
SET SESSION warp_parallel_hash_join = 0;
EXPLAIN FORMAT=TREE SELECT f.id, d1.a, d2.c FROM f_w f JOIN d1_w d1 ON f.k1 = d1.k JOIN d2_w d2 ON f.k2 = d2.k WHERE d2.flag = 1;
EXPLAIN
-> Inner hash join (d1.k = f.k1)
    -> Table scan on d1
    -> Hash
        -> Inner hash join (f.k2 = d2.k)
            -> Table scan on f
            -> Hash
                -> Table scan on d2

Warnings:
Note	1003	/* select#1 */ select `f`.`id` AS `id`,`d1`.`a` AS `a`,`d2`.`c` AS `c` from `test`.`f_w` `f` join `test`.`d1_w` `d1` join `test`.`d2_w` `d2` where ((`d1`.`k` = `f`.`k1`) and (`d2`.`flag` = 1) and (`f`.`k2` = `d2`.`k`))
SET SESSION warp_parallel_hash_join = 1;
# rows that a transaction can not see are not joined
BEGIN;
DELETE FROM f_w WHERE id % 2 = 0;
DELETE FROM f_i WHERE id % 2 = 0;
