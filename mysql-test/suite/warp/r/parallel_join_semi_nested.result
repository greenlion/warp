#
# The subquery of a semi of a join that the engine makes
# (warp_parallel_hash_join) has joins and aggregations of its own.  Only
# the tables of the join that is being made are read by the scans of the
# tables while the subquery is read: the join and the aggregation of the
# subquery are made by the engine too.  They were not: the nested loop that
# stands for a join of the engine scanned its inner table for every row
# (TPC-DS query 23 with subquery_to_derived=on did not end), and the
# aggregation that the engine had replaced returned no group (the same
# query without the switch lost the rows of its subquery).
# Every query is run with the join and the aggregation of the engine on
# and off, with subquery_to_derived on and off, and against InnoDB copies.
#
SET @save_rows = @@global.warp_partition_max_rows;
SET GLOBAL warp_partition_max_rows = 64000;
SET SESSION warp_parallel_join_min_rows = 0;
SET SESSION warp_parallel_min_rows = 0;
Warnings:
Warning	1292	Truncated incorrect warp_parallel_min_rows value: '0'
SET SESSION cte_max_recursion_depth = 400000;
CREATE TABLE f_w (id INT, k INT NULL, cid INT NULL, v INT, flag INT) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE d_w (id INT, flag INT) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE c_w (cid INT, w INT) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO f_w WITH RECURSIVE s(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 199999)
SELECT i, IF(i % 1000 = 0, NULL, i % 20000), IF(i % 500 = 0, NULL, i % 3000), i % 97, i % 3 FROM s;
INSERT INTO d_w VALUES (0, 1), (1, 0), (2, 1);
INSERT INTO c_w WITH RECURSIVE s(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 2999)
SELECT i, i % 2 FROM s;
CREATE TABLE f_i LIKE f_w;
CREATE TABLE d_i LIKE d_w;
CREATE TABLE c_i LIKE c_w;
ALTER TABLE f_i ENGINE=InnoDB;
ALTER TABLE d_i ENGINE=InnoDB;
ALTER TABLE c_i ENGINE=InnoDB;
INSERT INTO f_i SELECT * FROM f_w;
INSERT INTO d_i SELECT * FROM d_w;
INSERT INTO c_i SELECT * FROM c_w;
CREATE TABLE queries (i INT, q TEXT) ENGINE=InnoDB;
INSERT INTO queries VALUES
(1, 'WITH best AS (SELECT c.cid, SUM(f2.v) s FROM f_# f2, c_# c WHERE f2.cid = c.cid GROUP BY c.cid HAVING SUM(f2.v) > 3300) SELECT COUNT(*) cnt, SUM(f.v) s FROM f_# f, d_# d WHERE f.flag = d.id AND d.flag = 1 AND f.cid IN (SELECT /*+ SEMIJOIN(MATERIALIZATION) */ cid FROM best)'),
(2, 'WITH best AS (SELECT c.cid, f2.v FROM f_# f2, c_# c WHERE f2.cid = c.cid AND c.w = 1 AND f2.v = 5) SELECT COUNT(*) cnt, SUM(f.v) s FROM f_# f, d_# d WHERE f.flag = d.id AND d.flag = 1 AND f.cid IN (SELECT /*+ SEMIJOIN(MATERIALIZATION) */ cid FROM best)'),
(3, 'WITH best AS (SELECT c.cid, SUM(f2.v) s FROM f_# f2, c_# c WHERE f2.cid = c.cid GROUP BY c.cid HAVING SUM(f2.v) > 0.98 * (SELECT MAX(s) FROM (SELECT SUM(f3.v) s FROM f_# f3, c_# c3 WHERE f3.cid = c3.cid AND c3.w = 1 GROUP BY c3.cid) m)) SELECT COUNT(*) cnt, SUM(f.v) s FROM f_# f, d_# d WHERE f.flag = d.id AND d.flag = 1 AND f.cid IN (SELECT /*+ SEMIJOIN(MATERIALIZATION) */ cid FROM best)'),
(4, 'WITH best AS (SELECT f2.cid, COUNT(*) n FROM f_# f2 GROUP BY f2.cid HAVING COUNT(*) > 66) SELECT COUNT(*) cnt, SUM(f.v) s FROM f_# f, d_# d WHERE f.flag = d.id AND d.flag = 1 AND f.cid IN (SELECT /*+ SEMIJOIN(MATERIALIZATION) */ cid FROM best)');
# subquery_to_derived: 0
