#
# Binary strings (BINARY, VARBINARY and BLOB) are stored like VARCHAR.
# Their bytes may be anything, NUL included, so WARP writes them encoded
# (0x00 as 0x01 0x01, 0x01 as 0x01 0x02) and decodes them when they are
# read.  The encoding keeps the order and the equality of the strings, so
# the comparisons of BINARY and VARBINARY columns with constants are
# pushed down and compared in the binary collation (byte by byte, the
# spaces at the end count).  Every value and every condition is checked
# against an identical InnoDB table.
#
SET SESSION cte_max_recursion_depth = 100000;
CREATE TABLE pool (k INT, s VARBINARY(20)) ENGINE=InnoDB;
INSERT INTO pool VALUES
(1, x''),
(2, x'00'),
(3, x'0000'),
(4, x'01'),
(5, x'0100'),
(6, x'0001'),
(7, x'0101'),
(8, x'02'),
(9, x'0102'),
(10, x'010101'),
(11, x'20'),
(12, x'61'),
(13, x'6120'),
(14, x'6100'),
(15, x'610001'),
(16, x'41'),
(17, x'62'),
(18, x'616263'),
(19, x'61626300'),
(20, x'7f'),
(21, x'80'),
(22, x'ff'),
(23, x'ffff'),
(24, x'ff00'),
(25, x'c3a9'),
(26, x'0a0d09'),
(27, x'22'),
(28, x'2c'),
(29, x'27'),
(30, x'5c'),
(31, x'00ff01fe02');
CREATE TABLE w (
id INT,
vb VARBINARY(20),
b BINARY(6),
vbn VARBINARY(20) NULL,
bl BLOB,
p INT
) ENGINE=WARP;
INSERT INTO w WITH RECURSIVE seq(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM seq WHERE x < 3000)
SELECT x, pool.s, LEFT(pool.s, 6), IF(x % 5 = 0, NULL, pool.s),
REPEAT(pool.s, 1 + x % 3), x % 100
FROM seq JOIN pool ON pool.k = 1 + (x * 7) % 31;
CREATE TABLE i LIKE w;
ALTER TABLE i ENGINE=InnoDB;
INSERT INTO i SELECT * FROM w;
# The values are read back as they were written
SELECT COUNT(*), COUNT(vbn), COUNT(DISTINCT vb), COUNT(DISTINCT b), SUM(LENGTH(bl)) FROM w;
COUNT(*)	COUNT(vbn)	COUNT(DISTINCT vb)	COUNT(DISTINCT b)	SUM(LENGTH(bl))
3000	2400	31	25	10654
SELECT (SELECT BIT_XOR(CRC32(CONCAT_WS('|', id, HEX(vb), HEX(b), IFNULL(HEX(vbn), 'N'), HEX(bl), p))) FROM w) =
(SELECT BIT_XOR(CRC32(CONCAT_WS('|', id, HEX(vb), HEX(b), IFNULL(HEX(vbn), 'N'), HEX(bl), p))) FROM i)
AS same_values;
same_values
1
SELECT HEX(vb), LENGTH(vb), HEX(b), LENGTH(b) FROM w WHERE id < 40 GROUP BY vb, b ORDER BY vb, b;
HEX(vb)	LENGTH(vb)	HEX(b)	LENGTH(b)
	0	000000000000	6
