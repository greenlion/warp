#
# A division by a constant in the argument of an aggregate: the engine
# aggregates it (alone and above its join) when every quotient is exact
# in the scale of the division (/ 2, / 4, / 100, / 0.5, / 2.5, / -2), as
# x * (10^n / c).  Any other division (/ 3, / 7.0, / 1.5, / a column) is
# left to MySQL.  Every query is run against the WARP tables with the
# aggregation on and off, and against InnoDB copies.  (TPC-DS query 4:
# SUM(((a - b - c) + d) / 2) over customer x sales x date_dim.)
#
SET SESSION warp_parallel_join_min_rows = 0;
SET SESSION warp_parallel_min_rows = 0;
Warnings:
Warning	1292	Truncated incorrect warp_parallel_min_rows value: '0'
SET SESSION cte_max_recursion_depth = 100000;
CREATE TABLE f_w (id INT, k INT, g INT, p DECIMAL(7,2), q DECIMAL(7,2) NULL, n INT NULL, x DECIMAL(12,5)) ENGINE=WARP;
CREATE TABLE d_w (k INT, t VARCHAR(10), r DECIMAL(6,3)) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO f_w WITH RECURSIVE s(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 6000)
SELECT i, 1 + i % 600, i % 7, (i * 37) % 10007 / 100 - 30.01, IF(i % 5 = 0, NULL, (i * 13) % 9973 / 100),
IF(i % 4 = 0, NULL, i % 9 - 3), (i * 7919) % 100003 / 100000 FROM s;
INSERT INTO d_w WITH RECURSIVE s(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 500)
SELECT i, CONCAT('t', i % 5), (i % 997) / 7 FROM s;
