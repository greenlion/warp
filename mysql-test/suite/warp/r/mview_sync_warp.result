# updates: across the WHERE, of a join column, of a group, of a key
UPDATE wo SET amount = 50 WHERE id = 11;
UPDATE wo SET c_id = 4 WHERE id = 12;
UPDATE wc SET region = 'south' WHERE id = 1;
UPDATE wc SET id = 40 WHERE id = 4;
UPDATE io SET amount = 50 WHERE id = 11;
UPDATE io SET c_id = 4 WHERE id = 12;
UPDATE ic SET id = 40 WHERE id = 4;
