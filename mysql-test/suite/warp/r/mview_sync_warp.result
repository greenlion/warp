# a transaction that is rolled back changes nothing
BEGIN;
INSERT INTO wo VALUES (99, 1, 1);
DELETE FROM io;
Warnings:
Warning	6414	Combining the storage engines InnoDB and WARP is deprecated, but the statement or transaction updates both the InnoDB table test.io and the WARP table test.wo.
ROLLBACK;
# everything goes
DELETE FROM wo;
DELETE FROM io;
