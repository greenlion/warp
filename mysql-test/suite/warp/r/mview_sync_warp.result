#
# WARP_MVIEW daemon with the WARP engine: views stored in WARP, base
# tables in WARP, and both mixed with InnoDB.  A short test: the full
# coverage of the daemon is in the InnoDB tests (mview_sync_join_*,
# mview_sync_agg_*).
#
call mtr.add_suppression("WARP_MVIEW");
CREATE TABLE wc (id INT NOT NULL, name VARCHAR(20), region VARCHAR(10), PRIMARY KEY (id)) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE wo (id INT NOT NULL, c_id INT, amount INT, PRIMARY KEY (id)) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE ic (id INT NOT NULL, name VARCHAR(20), region VARCHAR(10), PRIMARY KEY (id)) ENGINE=InnoDB;
CREATE TABLE io (id INT NOT NULL, c_id INT, amount INT, PRIMARY KEY (id)) ENGINE=InnoDB;
INSERT INTO wc VALUES (1, 'ann', 'north'), (2, 'bob', 'south'), (3, 'cy', NULL);
INSERT INTO wo VALUES (10, 1, 15), (11, 1, 250), (12, 2, 99);
INSERT INTO ic SELECT * FROM wc;
INSERT INTO io SELECT * FROM wo;
# WARP views over WARP tables
CREATE MATERIALIZED VIEW ww_left ENGINE=WARP AS SELECT c.id AS cid, c.name, o.id AS oid, o.amount FROM wc c LEFT JOIN wo o ON o.c_id = c.id;
CREATE MATERIALIZED VIEW ww_where ENGINE=WARP AS SELECT c.id AS cid, o.id AS oid, o.amount FROM wc c LEFT JOIN wo o ON o.c_id = c.id WHERE o.amount IS NULL OR o.amount < 100;
CREATE MATERIALIZED VIEW ww_cnt ENGINE=WARP AS SELECT COUNT(*) AS n, SUM(amount) AS s FROM wo;
CREATE MATERIALIZED VIEW ww_grp ENGINE=WARP AS SELECT c.region, COUNT(*) AS n, SUM(o.amount) AS s, MAX(o.amount) AS mx FROM wc c JOIN wo o ON o.c_id = c.id GROUP BY c.region;
CREATE MATERIALIZED VIEW ww_ldist ENGINE=WARP AS SELECT c.id AS cid, COUNT(o.id) AS n, COUNT(DISTINCT o.amount) AS d FROM wc c LEFT JOIN wo o ON o.c_id = c.id GROUP BY c.id;
# InnoDB views over WARP tables
CREATE MATERIALIZED VIEW iw_left ENGINE=InnoDB AS SELECT c.id AS cid, c.name, o.id AS oid, o.amount FROM wc c LEFT JOIN wo o ON o.c_id = c.id;
CREATE MATERIALIZED VIEW iw_grp ENGINE=InnoDB AS SELECT c_id, COUNT(*) AS n, SUM(amount) AS s FROM wo GROUP BY c_id;
# WARP views over InnoDB tables
CREATE MATERIALIZED VIEW wi_left ENGINE=WARP AS SELECT c.id AS cid, c.name, o.id AS oid, o.amount FROM ic c LEFT JOIN io o ON o.c_id = c.id;
CREATE MATERIALIZED VIEW wi_grp ENGINE=WARP AS SELECT c_id, COUNT(*) AS n, SUM(amount) AS s FROM io GROUP BY c_id;
