#
# The engine aggregates the rows of a WARP table itself
# (warp_parallel_aggregation): the groups of the rows that pass the
# conditions, SUM, AVG, MIN, MAX, COUNT and the DISTINCT aggregates of
# integers, decimals, floating point numbers and strings.  Every query is
# run against the WARP table (suffix w) and against an InnoDB copy (suffix
# i), and a checksum of the rows is compared.
#
SET SESSION warp_parallel_join_min_rows = 0;
SET SESSION cte_max_recursion_depth = 10000;
CREATE TABLE f_w (id INT, g1 TINYINT, g2 SMALLINT, g3 VARCHAR(8), g4 VARCHAR(8), u INT UNSIGNED, big BIGINT,
d1 DECIMAL(10,2), d2 DECIMAL(18,4), fl FLOAT, db DOUBLE, s VARCHAR(10),
n_i INT NULL, n_d DECIMAL(10,2) NULL, n_s VARCHAR(8) NULL, v INT)
ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO f_w WITH RECURSIVE s(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM s WHERE x < 4000)
SELECT x, x % 7 - 3, x % 50, CONCAT('b', x % 5), ELT(1 + x % 4, 'Aa', 'aA', 'Bb', 'bB'),
x * 3, x * 1000003 - 2000000, (x % 997) / 100 - 3, (x % 1013) / 7 - 20.5,
(x % 64) / 4, (x % 128) * 0.5 - 10, CONCAT('str', x % 13),
IF(x % 5 = 0, NULL, x % 9 - 2), IF(x % 6 = 0, NULL, (x % 40) / 8), IF(x % 4 = 0, NULL, CONCAT('n', x % 6)),
x % 100 - 30
FROM s;
