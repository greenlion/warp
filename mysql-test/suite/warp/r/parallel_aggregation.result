# rows that a transaction can not see are not aggregated
BEGIN;
DELETE FROM f_w WHERE id % 2 = 0;
DELETE FROM f_i WHERE id % 2 = 0;
Warnings:
Warning	6414	Combining the storage engines InnoDB and WARP is deprecated, but the statement or transaction updates both the InnoDB table test.f_i and the WARP table test.f_w.
INSERT INTO f_w VALUES (9000, 1, 1, 'new', 'new', 1, 1, 1.5, 2.25, 1, 1, 'new', 1, 1.5, 'x', 7);
INSERT INTO f_i VALUES (9000, 1, 1, 'new', 'new', 1, 1, 1.5, 2.25, 1, 1, 'new', 1, 1.5, 'x', 7);
7:40007:3931.98
ROLLBACK;
7:78000:7861.02
# the engine aggregates: the table is scanned once and the groups are the rows
EXPLAIN FORMAT=TREE SELECT g1, SUM(d1), COUNT(*) FROM f_w GROUP BY g1;
EXPLAIN
-> Table scan on <temporary>
    -> Aggregate using temporary table
        -> Table scan on f_w, with parallel aggregation

SET SESSION warp_parallel_aggregation = 0;
EXPLAIN FORMAT=TREE SELECT g1, SUM(d1), COUNT(*) FROM f_w GROUP BY g1;
EXPLAIN
-> Table scan on <temporary>
    -> Aggregate using temporary table
        -> Table scan on f_w

SET SESSION warp_parallel_aggregation = 1;
SET SESSION warp_parallel_join_min_rows = DEFAULT;
DROP TABLE f_w, f_i, e_w, e_i;
