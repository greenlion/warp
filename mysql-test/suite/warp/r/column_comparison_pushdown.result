#
# A comparison of two columns of one table (a < b) is evaluated by FastBit,
# for numbers and DATE columns.  Every query is run against the WARP table
# and an InnoDB copy.
#
CREATE TABLE t_w (id INT, i1 INT, i2 INT, u1 INT UNSIGNED, u2 INT UNSIGNED, t1 TINYINT, s1 SMALLINT, y1 YEAR,
f1 FLOAT, f2 FLOAT, d1 DOUBLE, d2 DOUBLE, da1 DATE, da2 DATE, dt1 DATETIME(6), dt2 DATETIME(6),
dc1 DECIMAL(10,2), dc2 DECIMAL(10,2), b1 BIGINT, b2 BIGINT, v1 VARCHAR(5), v2 VARCHAR(5),
n1 INT NULL, n2 INT NULL, nd1 DATE NULL, nd2 DATE NULL) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
SET SESSION cte_max_recursion_depth = 10000;
INSERT INTO t_w WITH RECURSIVE s(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM s WHERE x < 4000)
SELECT x, x % 50, (x * 7) % 50, x % 40, (x * 3) % 40, x % 9, (x * 5) % 9 - 4, 2000 + x % 5,
(x % 30) / 4, ((x * 11) % 30) / 4, (x % 20) / 3, ((x * 13) % 20) / 3,
DATE_ADD('2020-01-01', INTERVAL x % 30 DAY), DATE_ADD('2020-01-01', INTERVAL (x * 7) % 30 DAY),
TIMESTAMP('2020-01-01 00:00:00.000100') + INTERVAL (x % 4) SECOND, TIMESTAMP('2020-01-01 00:00:00.000200') + INTERVAL ((x * 3) % 4) SECOND,
(x % 17) / 3, ((x * 5) % 17) / 3, x % 13, (x * 3) % 13, CONCAT('a', x % 4), CONCAT('a', (x * 3) % 4),
IF(x % 6 = 0, NULL, x % 12), IF(x % 5 = 0, NULL, (x * 5) % 12),
IF(x % 7 = 0, NULL, DATE_ADD('2020-02-01', INTERVAL x % 20 DAY)), IF(x % 4 = 0, NULL, DATE_ADD('2020-02-01', INTERVAL (x * 3) % 20 DAY))
FROM s;
