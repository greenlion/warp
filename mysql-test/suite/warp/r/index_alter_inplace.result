#
# Adding, dropping and renaming an index of a WARP table only changes the
# definition of the table.  The data files are not rewritten.
#
SET SESSION cte_max_recursion_depth = 100000;
CREATE TABLE t1 (id INT NOT NULL, v INT, s VARCHAR(10)) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO t1 WITH RECURSIVE n(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM n WHERE x < 50000)
SELECT x, x % 10, CONCAT('s', x) FROM n;
UPDATE t1 SET v = 99 WHERE id = 7;
DELETE FROM t1 WHERE id = 8;
SELECT COUNT(*), SUM(v) FROM t1;
COUNT(*)	SUM(v)
49999	225084
# the files of the table before the changes
# ALGORITHM=INSTANT, INPLACE and the default are all accepted
ALTER TABLE t1 ADD KEY k_id (id), ALGORITHM=INSTANT;
ALTER TABLE t1 ADD KEY k_v (v), ALGORITHM=INPLACE, LOCK=NONE;
ALTER TABLE t1 ADD KEY k_s (s);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `v` int DEFAULT NULL,
  `s` varchar(10) COLLATE utf8mb4_bin DEFAULT NULL,
  KEY `k_id` (`id`),
  KEY `k_v` (`v`),
  KEY `k_s` (`s`)
) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin
ALTER TABLE t1 RENAME INDEX k_v TO k_value, ALGORITHM=INSTANT;
ALTER TABLE t1 ALTER INDEX k_value INVISIBLE, ALGORITHM=INSTANT;
ALTER TABLE t1 DROP KEY k_s;
ALTER TABLE t1 DROP KEY k_value, ALGORITHM=INSTANT;
ALTER TABLE t1 ADD KEY k_ids (id, v), ALGORITHM=INSTANT;
ALTER TABLE t1 DROP KEY k_ids, ALGORITHM=INSTANT;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `v` int DEFAULT NULL,
  `s` varchar(10) COLLATE utf8mb4_bin DEFAULT NULL,
  KEY `k_id` (`id`)
) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin
# the files of the table after the changes: the same files, not changed
# the data, updated and deleted rows included, is the same
SELECT COUNT(*), SUM(v) FROM t1;
COUNT(*)	SUM(v)
49999	225084
SELECT * FROM t1 FORCE INDEX (k_id) WHERE id IN (7, 8, 9) ORDER BY id;
id	v	s
7	99	s7
9	9	s9
# a connection that reads the table sees the new index
SELECT COUNT(*) FROM t1 FORCE INDEX (k_id) WHERE id BETWEEN 100 AND 199;
COUNT(*)
100
ALTER TABLE t1 ADD KEY k_v (v), ALGORITHM=INSTANT;
SELECT COUNT(*) FROM t1 FORCE INDEX (k_v) WHERE v = 3;
COUNT(*)
5000
# the index is still there after a restart, and the lookups work
# restart
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `v` int DEFAULT NULL,
  `s` varchar(10) COLLATE utf8mb4_bin DEFAULT NULL,
  KEY `k_id` (`id`),
  KEY `k_v` (`v`)
) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin
SELECT COUNT(*) FROM t1 FORCE INDEX (k_v) WHERE v = 3;
COUNT(*)
5000
SELECT COUNT(*), SUM(v) FROM t1;
COUNT(*)	SUM(v)
49999	225084
# what WARP can not index, or what changes the data, is not instant
ALTER TABLE t1 ADD COLUMN extra INT, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t1 ADD UNIQUE KEY u (id), ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t1 ADD KEY kp (s(3)), ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t1 ADD KEY k_new (id), DROP COLUMN s, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
# and the table copy reports the same errors as before
ALTER TABLE t1 ADD UNIQUE KEY u (id);
ERROR HY000: Table storage engine 'WARP' does not support the create option 'UNIQUE or PRIMARY KEY'
ALTER TABLE t1 ADD KEY kp (s(3));
ERROR 42000: The used storage engine can't index column 's'
ALTER TABLE t1 ADD COLUMN extra INT;
SELECT COUNT(*), SUM(v) FROM t1;
COUNT(*)	SUM(v)
49999	225084
SELECT * FROM t1 FORCE INDEX (k_v) WHERE v = 99;
id	v	s	extra
7	99	s7	NULL
DROP TABLE t1;
