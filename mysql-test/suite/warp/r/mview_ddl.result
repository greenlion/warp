ERROR 0A000: CREATE MATERIALIZED VIEW is not allowed in stored procedures
CREATE PROCEDURE p1() REFRESH MATERIALIZED VIEW mv2;
INSERT INTO t1 VALUES (6, 60, 'six');
CALL p1();
DELETE FROM t1 WHERE id = 4;
CALL p1();
SELECT * FROM mv2 ORDER BY x;
x	y
2	two
3	NULL
5	five
6	six
DROP PROCEDURE p1;
# Not in a function: the statement commits
