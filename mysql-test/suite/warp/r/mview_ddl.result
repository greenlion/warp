#
# Materialized views: syntax, checks of the definition, the guard of
# the tables, privileges
#
call mtr.add_suppression("MY-015655");
# REFRESH and SYNCHRONOUS are not reserved words
CREATE TABLE refresh (refresh INT PRIMARY KEY, synchronous INT, manual INT,
materialized INT);
INSERT INTO refresh VALUES (1, 2, 3, 4);
SELECT refresh, synchronous, manual, materialized FROM refresh AS synchronous;
refresh	synchronous	manual	materialized
1	2	3	4
CREATE TABLE synchronous (id INT PRIMARY KEY, refresh INT);
DROP TABLE refresh, synchronous;
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, name VARCHAR(20));
CREATE TABLE t2 (id INT PRIMARY KEY, t1_id INT, b DECIMAL(10,2));
CREATE TABLE nopk (id INT, a INT);
CREATE TABLE uniq (id INT NOT NULL UNIQUE, a INT);
INSERT INTO t1 VALUES (1, 10, 'one'), (2, 20, 'two'), (3, 30, NULL);
INSERT INTO t2 VALUES (1, 1, 1.50), (2, 1, 2.50), (3, 9, 3.50);
CREATE VIEW plain_v AS SELECT id, a FROM t1;
CREATE TEMPORARY TABLE tmp (id INT PRIMARY KEY, a INT);
CREATE FUNCTION f1(x INT) RETURNS INT DETERMINISTIC RETURN x + 1;
#
# Syntax
#
CREATE MATERIALIZED VIEW mv1 AS SELECT id, a FROM t1;
# The default is the default engine and REFRESH SYNCHRONOUS
SHOW CREATE VIEW mv1;
View	Create View	character_set_client	collation_connection
mv1	CREATE MATERIALIZED VIEW `mv1` (`id`, `a`) ENGINE=InnoDB REFRESH SYNCHRONOUS AS select `test`.`t1`.`id` AS `id`,`test`.`t1`.`a` AS `a` from `test`.`t1`	utf8mb4	utf8mb4_0900_ai_ci
CREATE MATERIALIZED VIEW IF NOT EXISTS mv1 AS SELECT id FROM t1;
Warnings:
Note	1050	Table 'mv1' already exists
CREATE MATERIALIZED VIEW mv1 AS SELECT id FROM t1;
ERROR 42S01: Table 'mv1' already exists
CREATE MATERIALIZED VIEW t2 AS SELECT id FROM t1;
ERROR 42S01: Table 't2' already exists
CREATE MATERIALIZED VIEW test.mv2 (x, y) ENGINE = InnoDB REFRESH MANUAL
AS SELECT id, name FROM t1 WHERE a > 10;
CREATE MATERIALIZED VIEW mv3 ENGINE WARP REFRESH SYNCHRONOUS
AS SELECT t1.id, t2.b FROM t1 JOIN t2 ON t2.t1_id = t1.id;
CREATE MATERIALIZED VIEW mv4 REFRESH MANUAL AS SELECT id FROM t1;
SHOW CREATE VIEW mv2;
View	Create View	character_set_client	collation_connection
mv2	CREATE MATERIALIZED VIEW `mv2` (`x`, `y`) ENGINE=InnoDB REFRESH MANUAL AS select `test`.`t1`.`id` AS `id`,`test`.`t1`.`name` AS `name` from `test`.`t1` where (`test`.`t1`.`a` > 10)	utf8mb4	utf8mb4_0900_ai_ci
SHOW CREATE VIEW mv3;
View	Create View	character_set_client	collation_connection
mv3	CREATE MATERIALIZED VIEW `mv3` (`id`, `b`) ENGINE=WARP REFRESH SYNCHRONOUS AS select `test`.`t1`.`id` AS `id`,`test`.`t2`.`b` AS `b` from (`test`.`t1` join `test`.`t2` on((`test`.`t2`.`t1_id` = `test`.`t1`.`id`)))	utf8mb4	utf8mb4_0900_ai_ci
SHOW CREATE VIEW mv4;
View	Create View	character_set_client	collation_connection
mv4	CREATE MATERIALIZED VIEW `mv4` (`id`) ENGINE=InnoDB REFRESH MANUAL AS select `test`.`t1`.`id` AS `id` from `test`.`t1`	utf8mb4	utf8mb4_0900_ai_ci
SELECT * FROM mv2 ORDER BY x;
x	y
2	two
3	NULL
SELECT * FROM mv3 ORDER BY id, b;
id	b
1	1.50
1	2.50
# A materialized view is a table, with invisible columns
SHOW CREATE TABLE mv3;
Table	Create Table
mv3	CREATE TABLE `mv3` (
  `id` int DEFAULT NULL,
  `b` decimal(10,2) DEFAULT NULL,
  `mv$pk1_0` int DEFAULT NULL /*!80023 INVISIBLE */,
  KEY `mv$ix_pk0` (`id`),
  KEY `mv$ix_pk1` (`mv$pk1_0`)
) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT TABLE_NAME, TABLE_TYPE, ENGINE FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE 'mv_' ORDER BY TABLE_NAME;
TABLE_NAME	TABLE_TYPE	ENGINE
mv1	BASE TABLE	InnoDB
mv2	BASE TABLE	InnoDB
mv3	BASE TABLE	WARP
mv4	BASE TABLE	InnoDB
# The default engine
SET default_storage_engine = WARP;
CREATE MATERIALIZED VIEW mv5 AS SELECT id, name FROM t1;
SET default_storage_engine = DEFAULT;
CREATE MATERIALIZED VIEW mv6 AS SELECT id, name FROM t1;
SELECT TABLE_NAME, ENGINE FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('mv5', 'mv6') ORDER BY TABLE_NAME;
TABLE_NAME	ENGINE
mv5	WARP
mv6	InnoDB
# The strings of a WARP table have a collation that WARP stores
SELECT TABLE_NAME, COLUMN_NAME, COLLATION_NAME FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('mv5', 'mv6')
AND COLUMN_NAME = 'name' ORDER BY TABLE_NAME;
TABLE_NAME	COLUMN_NAME	COLLATION_NAME
mv5	name	utf8mb4_bin
mv6	name	utf8mb4_0900_ai_ci
SELECT * FROM mv5 ORDER BY id;
id	name
1	one
2	two
3	NULL
CREATE MATERIALIZED VIEW mv7 ENGINE=no_such_engine AS SELECT id FROM t1;
