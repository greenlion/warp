EXECUTE s;
INSERT INTO t1 VALUES (5, 50, 'five');
EXECUTE s;
DEALLOCATE PREPARE s;
SELECT * FROM mv2 ORDER BY x;
x	y
2	two
3	NULL
4	four
5	five
