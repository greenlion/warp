CREATE DATABASE mvdb;
CREATE TABLE mvdb.b1 (id INT PRIMARY KEY, a INT);
CREATE TABLE mvdb.secret (id INT PRIMARY KEY, s INT);
INSERT INTO mvdb.b1 VALUES (1, 1);
CREATE MATERIALIZED VIEW mvdb.mv_root REFRESH MANUAL AS SELECT id FROM mvdb.b1;
CREATE USER mvuser@localhost;
GRANT SELECT ON mvdb.b1 TO mvuser@localhost;
GRANT SELECT ON mvdb.mv_root TO mvuser@localhost;
# No CREATE, ALTER, DROP privilege
CREATE MATERIALIZED VIEW mvdb.mv8 AS SELECT id FROM mvdb.b1;
ERROR 42000: CREATE command denied to user 'mvuser'@'localhost' for table 'mv8'
REFRESH MATERIALIZED VIEW mvdb.mv_root;
ERROR 42000: ALTER command denied to user 'mvuser'@'localhost' for table 'mv_root'
ALTER MATERIALIZED VIEW mvdb.mv_root REFRESH MANUAL;
ERROR 42000: ALTER command denied to user 'mvuser'@'localhost' for table 'mv_root'
DROP MATERIALIZED VIEW mvdb.mv_root;
ERROR 42000: DROP command denied to user 'mvuser'@'localhost' for table 'mv_root'
GRANT CREATE, ALTER, DROP ON mvdb.* TO mvuser@localhost;
# No SELECT privilege on a base table
CREATE MATERIALIZED VIEW mvdb.mv8 AS SELECT id FROM mvdb.secret;
ERROR 42000: SELECT command denied to user 'mvuser'@'localhost' for table 'secret'
CREATE MATERIALIZED VIEW mvdb.mv8 AS
SELECT b1.id FROM mvdb.b1 AS b1 JOIN mvdb.secret AS secret ON secret.id = b1.id;
ERROR 42000: SELECT command denied to user 'mvuser'@'localhost' for table 'secret'
# CREATE on the schema and SELECT on the base tables
CREATE MATERIALIZED VIEW mvdb.mv8 REFRESH MANUAL AS SELECT id, a FROM mvdb.b1;
CREATE MATERIALIZED VIEW mvdb.mv9 REFRESH MANUAL AS SELECT COUNT(*) AS c FROM mvdb.b1;
# The user who made the view does not read or write it for that
SELECT * FROM mvdb.mv8;
ERROR 42000: SELECT command denied to user 'mvuser'@'localhost' for table 'mv8'
INSERT INTO mvdb.mv8 VALUES (1, 1);
ERROR 42000: INSERT command denied to user 'mvuser'@'localhost' for table 'mv8'
REFRESH MATERIALIZED VIEW mvdb.mv8;
REFRESH MATERIALIZED VIEW mvdb.mv9;
ALTER MATERIALIZED VIEW mvdb.mv8 REFRESH SYNCHRONOUS;
DROP MATERIALIZED VIEW mvdb.mv8, mvdb.mv9;
DROP USER mvuser@localhost;
DROP DATABASE mvdb;
#
# DROP DATABASE drops the materialized views of the database
#
CREATE DATABASE mvdb;
CREATE TABLE mvdb.t (id INT PRIMARY KEY, g INT);
INSERT INTO mvdb.t VALUES (1, 1), (2, 1);
CREATE MATERIALIZED VIEW mvdb.mv_j AS SELECT id FROM mvdb.t;
CREATE MATERIALIZED VIEW mvdb.mv_a ENGINE=WARP AS
SELECT g, COUNT(*) AS c FROM mvdb.t GROUP BY g;
USE mvdb;
SHOW TABLES;
Tables_in_mvdb
mv_a
mv_a$mv_state
mv_j
t
SHOW CREATE VIEW mv_a;
View	Create View	character_set_client	collation_connection
mv_a	CREATE MATERIALIZED VIEW `mv_a` (`g`, `c`) ENGINE=WARP REFRESH SYNCHRONOUS AS select `mvdb`.`t`.`g` AS `g`,count(0) AS `c` from `mvdb`.`t` group by `mvdb`.`t`.`g`	utf8mb4	utf8mb4_0900_ai_ci
SHOW CREATE VIEW test.mv2;
View	Create View	character_set_client	collation_connection
mv2	CREATE MATERIALIZED VIEW `test`.`mv2` (`x`, `y`) ENGINE=InnoDB REFRESH MANUAL AS select `test`.`t1`.`id` AS `id`,`test`.`t1`.`name` AS `name` from `test`.`t1` where (`test`.`t1`.`a` > 10)	utf8mb4	utf8mb4_0900_ai_ci
USE test;
DROP DATABASE mvdb;
# The view of a table that is dropped is not refreshed any more
CREATE TABLE gone (id INT PRIMARY KEY);
CREATE MATERIALIZED VIEW mv9 REFRESH MANUAL AS SELECT id FROM gone;
DROP TABLE gone;
REFRESH MATERIALIZED VIEW mv9;
ERROR 42S02: Table 'test.gone' doesn't exist
SELECT COUNT(*) FROM mv9;
COUNT(*)
0
DROP MATERIALIZED VIEW mv9;
DROP MATERIALIZED VIEW mv1, mv2, mv3;
DROP VIEW plain_v;
DROP FUNCTION f1;
DROP TEMPORARY TABLE tmp;
DROP TABLE t1, t2, nopk, uniq;
