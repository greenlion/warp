--echo #
--echo # 1. A condition whose values are columns (a BETWEEN b AND c, a IN (b, 5), the
--echo #    bounds of a BETWEEN that are columns of another table) is not evaluated by
--echo #    FastBit.  It was pushed as text that FastBit could not parse, and the scan
--echo #    returned every row of the table, also the rows that the other pushed
--echo #    conditions exclude.
--echo # 2. The scan of a table that is joined (inner join) with a derived table or a
--echo #    CTE that MySQL materializes once is limited to the keys of the derived
--echo #    table, and the operands of a UNION that is read by a key are limited to
--echo #    the keys of the table that reads it (warp_semi_key_pushdown, TPC-DS
--echo #    query 54).
--echo # Every query is run against the WARP tables and InnoDB copies.
--echo #

call mtr.add_suppression("MY-015655");
SET SESSION cte_max_recursion_depth = 100000;

CREATE TABLE f_w (id INT, k INT NULL, d INT, v INT) ENGINE=WARP;
CREATE TABLE d_w (id INT PRIMARY KEY, grp INT, a INT) ENGINE=WARP;
CREATE TABLE c_w (k INT NULL, item INT, v INT) ENGINE=WARP;
CREATE TABLE w_w (k INT NULL, item INT, v INT) ENGINE=WARP;
INSERT INTO f_w WITH RECURSIVE x(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM x WHERE i < 30000)
  SELECT i, IF(i % 11 = 0, NULL, 1 + (i * 7) % 3000), 1 + i % 400, i % 23 FROM x;
INSERT INTO d_w WITH RECURSIVE x(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM x WHERE i < 2500)
  SELECT i, i % 40, i % 90 FROM x;
INSERT INTO c_w WITH RECURSIVE x(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM x WHERE i < 9000)
  SELECT IF(i % 13 = 0, NULL, 1 + (i * 3) % 2600), i % 50, i % 7 FROM x;
INSERT INTO w_w WITH RECURSIVE x(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM x WHERE i < 5000)
  SELECT IF(i % 17 = 0, NULL, 1 + (i * 5) % 2700), i % 50, i % 5 FROM x;
CREATE TABLE f_i LIKE f_w;
CREATE TABLE d_i LIKE d_w;
CREATE TABLE c_i LIKE c_w;
CREATE TABLE w_i LIKE w_w;
ALTER TABLE f_i ENGINE=InnoDB;
ALTER TABLE d_i ENGINE=InnoDB;
ALTER TABLE c_i ENGINE=InnoDB;
ALTER TABLE w_i ENGINE=InnoDB;
INSERT INTO f_i SELECT * FROM f_w;
INSERT INTO d_i SELECT * FROM d_w;
INSERT INTO c_i SELECT * FROM c_w;
INSERT INTO w_i SELECT * FROM w_w;

CREATE TABLE queries (i INT, q TEXT);
INSERT INTO queries VALUES
 (1, 'SELECT COUNT(*), SUM(f.id) FROM f_# f, (SELECT 5 lo, 300 hi) x WHERE f.k BETWEEN x.lo AND x.hi AND f.v = 7'),
 (2, 'SELECT COUNT(*), SUM(f.id) FROM f_# f, (SELECT MIN(id) lo, MAX(id) hi FROM d_# WHERE grp = 3 GROUP BY grp) x WHERE f.k BETWEEN x.lo AND x.hi AND f.v = 7'),
 (3, 'SELECT COUNT(*), SUM(f.id) FROM f_# f WHERE f.k BETWEEN f.v AND f.d'),
 (4, 'SELECT COUNT(*), SUM(f.id) FROM f_# f WHERE f.k BETWEEN f.v AND f.d AND f.v = 7'),
 (5, 'SELECT COUNT(*), SUM(f.id) FROM f_# f WHERE f.v IN (f.d, 5)'),
 (6, 'SELECT COUNT(*), SUM(f.id) FROM f_# f WHERE f.k BETWEEN 10 AND f.d'),
 (7, 'SELECT COUNT(*), SUM(f.id) FROM f_# f WHERE f.k NOT BETWEEN f.v AND f.d'),
 (8, 'SELECT COUNT(*), SUM(f.id) FROM f_# f WHERE 7 < f.v AND 20 >= f.v'),
 (9, 'SELECT COUNT(*), SUM(f.id) FROM f_# f, d_# d WHERE f.k = d.id AND d.a BETWEEN f.v AND f.d AND d.grp < 9'),
 (10, 'WITH c AS (SELECT DISTINCT d.id k, d.a FROM d_# d, c_# s WHERE s.k = d.id AND d.grp = 3 AND s.item = 4) SELECT COUNT(*), SUM(f.id), SUM(c.a) FROM f_# f, c WHERE f.k = c.k'),
 (11, 'WITH c AS (SELECT DISTINCT d.id k, d.a FROM d_# d, c_# s WHERE s.k = d.id AND d.grp = 3 AND s.item = 4) SELECT /*+ JOIN_ORDER(f, c) NO_BNL(c) */ COUNT(*), SUM(f.id), SUM(c.a) FROM f_# f, c WHERE f.k = c.k'),
 (12, 'WITH c AS (SELECT DISTINCT d.id k, d.a FROM d_# d, c_# s WHERE s.k = d.id AND d.grp = 3 AND s.item = 4) SELECT /*+ JOIN_ORDER(c, f) */ COUNT(*), SUM(f.id), SUM(c.a) FROM f_# f, c WHERE f.k = c.k AND f.v < 12'),
 (13, 'WITH c AS (SELECT DISTINCT s.k, s.item FROM c_# s WHERE s.item < 3) SELECT COUNT(*), SUM(f.id) FROM f_# f, c WHERE f.k <=> c.k AND f.v = c.item'),
 (14, 'WITH c AS (SELECT DISTINCT s.k, s.item FROM c_# s WHERE s.item < 3) SELECT /*+ JOIN_ORDER(f, c) NO_BNL(c) */ COUNT(*), SUM(f.id) FROM f_# f, c WHERE f.k <=> c.k'),
 (15, 'WITH c AS (SELECT DISTINCT d.id k FROM d_# d, c_# s WHERE s.k = d.id AND d.grp = 3 AND s.item = 4) SELECT COUNT(*), SUM(f.id), COUNT(c.k) FROM f_# f LEFT JOIN c ON f.k = c.k WHERE f.v = 2'),
 (16, 'WITH c AS (SELECT DISTINCT d.id k FROM d_# d, c_# s WHERE s.k = d.id AND d.grp = 3 AND s.item = 4) SELECT COUNT(*), SUM(f.id) FROM f_# f, c, d_# d2 WHERE f.k = c.k AND d2.id = f.d AND d2.grp = 1'),
 (17, 'WITH c AS (SELECT DISTINCT d.id k FROM d_# d, c_# s WHERE s.k = d.id AND d.grp = 3 AND s.item = 4) SELECT (SELECT COUNT(*) FROM f_# f, c WHERE f.k = c.k), (SELECT COUNT(*) FROM c), (SELECT SUM(f.id) FROM f_# f, c WHERE f.d = c.k)'),
 (18, 'WITH c AS (SELECT DISTINCT d.id k FROM d_# d, c_# s WHERE s.k = d.id AND d.grp = 99) SELECT COUNT(*), SUM(f.id) FROM f_# f, c WHERE f.k = c.k'),
 (19, 'SELECT /*+ JOIN_ORDER(d, u) NO_BNL(u) */ COUNT(*), SUM(u.v), SUM(d.a) FROM d_# d JOIN (SELECT k, item, v FROM c_# UNION ALL SELECT k, item, v FROM w_#) u ON u.k = d.id WHERE d.grp = 3'),
 (20, 'SELECT /*+ JOIN_ORDER(d, u) NO_BNL(u) */ COUNT(*), SUM(u.v), SUM(d.a) FROM d_# d JOIN (SELECT k, item, v FROM c_# UNION SELECT k, item, v FROM w_#) u ON u.k = d.id WHERE d.grp = 3'),
 (21, 'SELECT /*+ JOIN_ORDER(d, u) NO_BNL(u) */ COUNT(*), SUM(u.v), SUM(d.a) FROM d_# d JOIN (SELECT k, item, v FROM c_# WHERE item < 30 UNION ALL SELECT k, item, v FROM w_# UNION ALL SELECT k, MAX(item), SUM(v) FROM w_# GROUP BY k) u ON u.k = d.id WHERE d.grp IN (3, 4)'),
 (22, 'SELECT /*+ JOIN_ORDER(d, u) NO_BNL(u) */ COUNT(*), SUM(u.v), SUM(d.a) FROM d_# d JOIN ((SELECT k, item, v FROM c_# ORDER BY k, item, v LIMIT 300) UNION ALL SELECT k, item, v FROM w_#) u ON u.k = d.id WHERE d.grp = 3'),
 (23, 'SELECT /*+ JOIN_ORDER(d, u) NO_BNL(u) */ COUNT(*), SUM(u.v), SUM(d.a) FROM d_# d JOIN (SELECT k, item, v FROM c_# UNION ALL SELECT k, item, v FROM w_# ORDER BY k, item, v LIMIT 300) u ON u.k = d.id WHERE d.grp = 3'),
 (24, 'WITH u AS (SELECT k, item, v FROM c_# UNION ALL SELECT k, item, v FROM w_#) SELECT (SELECT /*+ JOIN_ORDER(d, u) NO_BNL(u) */ COUNT(*) FROM d_# d JOIN u ON u.k = d.id WHERE d.grp = 3) AS c1, (SELECT COUNT(*) FROM u) AS c2, (SELECT SUM(v) FROM u WHERE item = 2) AS c3'),
 (25, 'SELECT /*+ JOIN_ORDER(d, u) NO_BNL(u) */ COUNT(*), SUM(u.v), SUM(d.a) FROM d_# d JOIN (SELECT k, item, v FROM c_# EXCEPT SELECT k, item, v FROM w_#) u ON u.k = d.id WHERE d.grp = 3'),
 (26, 'WITH mc AS (SELECT DISTINCT d.id k, d.a FROM (SELECT k, item FROM c_# UNION ALL SELECT k, item FROM w_#) s, d_# d, d_# dd WHERE s.k = d.id AND dd.id = s.item AND dd.grp = 4 AND d.grp < 8), rev AS (SELECT mc.k, SUM(f.v) r FROM mc, f_# f, d_# d2, d_# d3 WHERE mc.a = d2.id AND d2.a = d3.a AND d2.grp = d3.grp AND f.k = mc.k AND d3.id BETWEEN (SELECT DISTINCT grp + 1 FROM d_# WHERE grp = 3) AND (SELECT DISTINCT grp + 30 FROM d_# WHERE grp = 3) GROUP BY mc.k) SELECT CAST(r / 5 AS SIGNED) seg, COUNT(*) n FROM rev GROUP BY seg ORDER BY seg, n');

--let $invalid_before = query_get_value(SHOW GLOBAL STATUS LIKE 'Warp_invalid_pushed_conditions', Value, 1)
--let $pass = 1
while ($pass <= 2)
{
  if ($pass == 1)
  {
    SET SESSION optimizer_switch = 'subquery_to_derived=on';
  }
  if ($pass == 2)
  {
    SET SESSION optimizer_switch = 'subquery_to_derived=off';
    SET SESSION warp_adjust_table_stats_for_joins = ON;
  }
  --let $i = 1
  while ($i <= 26)
  {
    --let $w = `SELECT REPLACE(q, '#', 'w') FROM queries WHERE i = $i`
    --let $n = `SELECT REPLACE(q, '#', 'i') FROM queries WHERE i = $i`
    --echo # query $i
    --disable_query_log
    SET SESSION warp_semi_key_pushdown = ON;
    eval CREATE TABLE r_on ENGINE=InnoDB AS $w;
    SET SESSION warp_semi_key_pushdown = OFF;
    eval CREATE TABLE r_off ENGINE=InnoDB AS $w;
    eval CREATE TABLE r_i ENGINE=InnoDB AS $n;
    --enable_query_log
    SELECT (SELECT COUNT(*) FROM r_on) = (SELECT COUNT(*) FROM r_i) AS same_rows_on,
           (SELECT COUNT(*) FROM r_off) = (SELECT COUNT(*) FROM r_i) AS same_rows_off;
    SELECT COUNT(*) AS different_rows FROM
      ((SELECT * FROM r_on EXCEPT SELECT * FROM r_i) UNION ALL (SELECT * FROM r_i EXCEPT SELECT * FROM r_on)
       UNION ALL (SELECT * FROM r_off EXCEPT SELECT * FROM r_i) UNION ALL (SELECT * FROM r_i EXCEPT SELECT * FROM r_off)) d;
    DROP TABLE r_on, r_off, r_i;
    --inc $i
  }
  --inc $pass
}
SET SESSION warp_adjust_table_stats_for_joins = DEFAULT;
SET SESSION optimizer_switch = DEFAULT;

--echo # the scans are limited to the keys (Warp_semi_key_scans grows), and no
--echo # condition that FastBit can not parse was made by the queries of the test
SET SESSION warp_semi_key_pushdown = ON;
--disable_query_log
--disable_result_log
--let $before = query_get_value(SHOW GLOBAL STATUS LIKE 'Warp_semi_key_scans', Value, 1)
--let $q = `SELECT REPLACE(q, '#', 'w') FROM queries WHERE i = 10`
--eval $q
--let $after = query_get_value(SHOW GLOBAL STATUS LIKE 'Warp_semi_key_scans', Value, 1)
--let $used_cte = `SELECT $after > $before`
--let $before = $after
--let $q = `SELECT REPLACE(q, '#', 'w') FROM queries WHERE i = 19`
--eval $q
--let $after = query_get_value(SHOW GLOBAL STATUS LIKE 'Warp_semi_key_scans', Value, 1)
--let $used_union = `SELECT $after >= $before + 2`
--let $invalid_after = query_get_value(SHOW GLOBAL STATUS LIKE 'Warp_invalid_pushed_conditions', Value, 1)
--let $invalid = `SELECT $invalid_after - $invalid_before`
--enable_result_log
--enable_query_log
--echo # join with a CTE: $used_cte
--echo # both operands of the UNION ALL: $used_union
--echo # conditions that FastBit could not parse: $invalid

SET SESSION warp_semi_key_pushdown = DEFAULT;
DROP TABLE queries, f_w, d_w, c_w, w_w, f_i, d_i, c_i, w_i;
