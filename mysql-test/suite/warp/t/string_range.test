--echo #
--echo # Comparisons of string columns with string constants (<, <=, >, >= and
--echo # BETWEEN) are evaluated by FastBit.  MySQL compares utf8mb4_bin strings byte
--echo # by byte and ignores the spaces at the end of a string (PAD SPACE), FastBit
--echo # must give the same results.  Every condition is also run against an
--echo # identical InnoDB table and the results must match.
--echo #
--echo # Regression test: BETWEEN and the other comparisons of strings were not
--echo # pushed down, MySQL evaluated them for every row (SSB query 2.2).
--echo #

SET SESSION cte_max_recursion_depth = 100000;

CREATE TABLE pool (k INT, s VARCHAR(20)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO pool VALUES
  (1, ''),
  (2, ' '),
  (3, 'a'),
  (4, 'a '),
  (5, 'a  '),
  (6, 'a	'),
  (7, 'a	b'),
  (8, 'A'),
  (9, 'ab'),
  (10, 'abc'),
  (11, 'abc '),
  (12, 'abd'),
  (13, 'b'),
  (14, 'b '),
  (15, 'B'),
  (16, 'MFGR#2221'),
  (17, 'MFGR#2222'),
  (18, 'MFGR#2228'),
  (19, 'MFGR#2229'),
  (20, 'MFGR#22'),
  (21, 'MFGR#2230'),
  (22, 'é'),
  (23, 'été'),
  (24, '中'),
  (25, 'z'),
  (26, 'zz'),
  (27, 'a b'),
  (28, 'a  b'),
  (29, 'a!'),
  (30, '~'),
  (31, '!'),
  (32, 'a\''),
  (33, 'a\\');

CREATE TABLE w (id INT, v VARCHAR(20), c CHAR(10), n VARCHAR(20) NULL, p INT)
  ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO w WITH RECURSIVE seq(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM seq WHERE x < 6000)
  SELECT x, pool.s, pool.s, IF(x % 5 = 0, NULL, pool.s), x % 100
  FROM seq JOIN pool ON pool.k = 1 + (x * 7) % 33;
CREATE TABLE i LIKE w;
ALTER TABLE i ENGINE=InnoDB;
INSERT INTO i SELECT * FROM w;
SELECT COUNT(*), COUNT(n), COUNT(DISTINCT v) FROM w;

let $checked = 0;
let $wrong = 0;
let $n = 0;
while ($n < 221)
{
  inc $n;
  if ($n == 1) { let $cond = v < 'a'; }
  if ($n == 2) { let $cond = v <= 'a'; }
  if ($n == 3) { let $cond = v > 'a'; }
  if ($n == 4) { let $cond = v >= 'a'; }
