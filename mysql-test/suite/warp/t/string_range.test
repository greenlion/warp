  if ($n == 181) { let $cond = n BETWEEN 'a' AND 'b'; }
  if ($n == 182) { let $cond = n BETWEEN 'a ' AND 'a  '; }
  if ($n == 183) { let $cond = n BETWEEN 'MFGR#2221' AND 'MFGR#2228'; }
  if ($n == 184) { let $cond = n BETWEEN '' AND ' '; }
  if ($n == 185) { let $cond = n BETWEEN 'b' AND 'a'; }
  if ($n == 186) { let $cond = n BETWEEN 'abc' AND 'abd'; }
  if ($n == 187) { let $cond = n BETWEEN 'é' AND '中'; }
  if ($n == 188) { let $cond = n BETWEEN 'a' AND 'a'; }
  if ($n == 189) { let $cond = n BETWEEN 'a	' AND 'a b'; }
  if ($n == 190) { let $cond = n BETWEEN 'a' AND 'b' AND p < 50; }
  if ($n == 191) { let $cond = n BETWEEN 'a' AND 'b' OR p = 7; }
  if ($n == 192) { let $cond = n BETWEEN 'a' AND 'b' OR n IS NULL; }
  if ($n == 193) { let $cond = NOT (n BETWEEN 'a' AND 'b'); }
  if ($n == 194) { let $cond = n NOT BETWEEN 'a' AND 'b'; }
  if ($n == 195) { let $cond = NOT (n < 'abc'); }
  if ($n == 196) { let $cond = 'abc' < n; }
  if ($n == 197) { let $cond = 'abc' >= n; }
  if ($n == 198) { let $cond = n >= 'a' AND n < 'b'; }
  if ($n == 199) { let $cond = v < 'abc' COLLATE utf8mb4_0900_ai_ci; }
  if ($n == 200) { let $cond = v COLLATE utf8mb4_0900_ai_ci BETWEEN 'a' AND 'b'; }
  if ($n == 201) { let $cond = v COLLATE utf8mb4_0900_bin BETWEEN 'a' AND 'b'; }
  if ($n == 202) { let $cond = v BETWEEN _utf8mb4 0x61 AND _utf8mb4 0x62; }
  if ($n == 203) { let $cond = v BETWEEN 'a' AND 'b' AND c BETWEEN 'A' AND 'B'; }
  if ($n == 204) { let $cond = v BETWEEN c AND 'b'; }
  if ($n == 205) { let $cond = v < c; }
  if ($n == 206) { let $cond = v = 'a'; }
  if ($n == 207) { let $cond = v = 'a '; }
  if ($n == 208) { let $cond = v = 'a  '; }
  if ($n == 209) { let $cond = v = ''; }
  if ($n == 210) { let $cond = v = ' '; }
  if ($n == 211) { let $cond = c = 'a'; }
  if ($n == 212) { let $cond = c = 'a  '; }
  if ($n == 213) { let $cond = c = ''; }
  if ($n == 214) { let $cond = n = 'a'; }
  if ($n == 215) { let $cond = n = 'a  '; }
  if ($n == 216) { let $cond = 'a ' = v; }
  if ($n == 217) { let $cond = v <> 'a'; }
  if ($n == 218) { let $cond = v = 'a' OR v = 'b '; }
  if ($n == 219) { let $cond = v = 'abc ' AND p < 60; }
  if ($n == 220) { let $cond = v IN ('a', 'b'); }
  if ($n == 221) { let $cond = v <=> 'a '; }
  let $w = `SELECT CONCAT(COUNT(*), ':', IFNULL(SUM(id), 0)) FROM w WHERE $cond`;
  let $i = `SELECT CONCAT(COUNT(*), ':', IFNULL(SUM(id), 0)) FROM i WHERE $cond`;
  inc $checked;
  if ($w != $i)
  {
    inc $wrong;
    --echo MISMATCH for WHERE $cond: WARP $w, InnoDB $i
  }
}
--echo $checked conditions checked, $wrong mismatches

--echo # The conditions that FastBit evaluates have no Filter in the plan, the others do
--replace_regex /\(cost=[^)]*\)//
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE v BETWEEN 'a' AND 'b';
--replace_regex /\(cost=[^)]*\)//
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE v < 'abc';
--replace_regex /\(cost=[^)]*\)//
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE n >= 'a';
--replace_regex /\(cost=[^)]*\)//
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE 'abc' < c;
--replace_regex /\(cost=[^)]*\)//
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE c BETWEEN 'MFGR#2221' AND 'MFGR#2228' AND p < 10;
--replace_regex /\(cost=[^)]*\)//
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE v NOT BETWEEN 'a' AND 'b';
--replace_regex /\(cost=[^)]*\)//
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE v COLLATE utf8mb4_0900_ai_ci BETWEEN 'a' AND 'b';
--replace_regex /\(cost=[^)]*\)//
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM w WHERE v BETWEEN c AND 'b';

DROP TABLE w, i, pool;
