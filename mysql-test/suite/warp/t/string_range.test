  if ($n == 87) { let $cond = c < ' '; }
  if ($n == 88) { let $cond = c <= ' '; }
  if ($n == 89) { let $cond = c > ' '; }
  if ($n == 90) { let $cond = c >= ' '; }
  if ($n == 91) { let $cond = c < 'z'; }
  if ($n == 92) { let $cond = c <= 'z'; }
  if ($n == 93) { let $cond = c > 'z'; }
  if ($n == 94) { let $cond = c >= 'z'; }
  if ($n == 95) { let $cond = c < 'é'; }
  if ($n == 96) { let $cond = c <= 'é'; }
  if ($n == 97) { let $cond = c > 'é'; }
  if ($n == 98) { let $cond = c >= 'é'; }
  if ($n == 99) { let $cond = c < 'zzz'; }
  if ($n == 100) { let $cond = c <= 'zzz'; }
  if ($n == 101) { let $cond = c > 'zzz'; }
  if ($n == 102) { let $cond = c >= 'zzz'; }
  if ($n == 103) { let $cond = c < 'B'; }
  if ($n == 104) { let $cond = c <= 'B'; }
  if ($n == 105) { let $cond = c > 'B'; }
  if ($n == 106) { let $cond = c >= 'B'; }
  if ($n == 107) { let $cond = c < 'a	'; }
  if ($n == 108) { let $cond = c <= 'a	'; }
  if ($n == 109) { let $cond = c > 'a	'; }
  if ($n == 110) { let $cond = c >= 'a	'; }
  if ($n == 111) { let $cond = c < 'a  b'; }
  if ($n == 112) { let $cond = c <= 'a  b'; }
  if ($n == 113) { let $cond = c > 'a  b'; }
  if ($n == 114) { let $cond = c >= 'a  b'; }
  if ($n == 115) { let $cond = c BETWEEN 'a' AND 'b'; }
  if ($n == 116) { let $cond = c BETWEEN 'a ' AND 'a  '; }
  if ($n == 117) { let $cond = c BETWEEN 'MFGR#2221' AND 'MFGR#2228'; }
  if ($n == 118) { let $cond = c BETWEEN '' AND ' '; }
  if ($n == 119) { let $cond = c BETWEEN 'b' AND 'a'; }
  if ($n == 120) { let $cond = c BETWEEN 'abc' AND 'abd'; }
  if ($n == 121) { let $cond = c BETWEEN 'é' AND '中'; }
  if ($n == 122) { let $cond = c BETWEEN 'a' AND 'a'; }
  if ($n == 123) { let $cond = c BETWEEN 'a	' AND 'a b'; }
  if ($n == 124) { let $cond = c BETWEEN 'a' AND 'b' AND p < 50; }
  if ($n == 125) { let $cond = c BETWEEN 'a' AND 'b' OR p = 7; }
  if ($n == 126) { let $cond = c BETWEEN 'a' AND 'b' OR c IS NULL; }
  if ($n == 127) { let $cond = NOT (c BETWEEN 'a' AND 'b'); }
  if ($n == 128) { let $cond = c NOT BETWEEN 'a' AND 'b'; }
  if ($n == 129) { let $cond = NOT (c < 'abc'); }
  if ($n == 130) { let $cond = 'abc' < c; }
  if ($n == 131) { let $cond = 'abc' >= c; }
  if ($n == 132) { let $cond = c >= 'a' AND c < 'b'; }
  if ($n == 133) { let $cond = n < 'a'; }
  if ($n == 134) { let $cond = n <= 'a'; }
  if ($n == 135) { let $cond = n > 'a'; }
  if ($n == 136) { let $cond = n >= 'a'; }
  if ($n == 137) { let $cond = n < 'a '; }
  if ($n == 138) { let $cond = n <= 'a '; }
  if ($n == 139) { let $cond = n > 'a '; }
  if ($n == 140) { let $cond = n >= 'a '; }
  if ($n == 141) { let $cond = n < 'abc'; }
  if ($n == 142) { let $cond = n <= 'abc'; }
  if ($n == 143) { let $cond = n > 'abc'; }
  if ($n == 144) { let $cond = n >= 'abc'; }
  if ($n == 145) { let $cond = n < 'MFGR#2225'; }
  if ($n == 146) { let $cond = n <= 'MFGR#2225'; }
  if ($n == 147) { let $cond = n > 'MFGR#2225'; }
  if ($n == 148) { let $cond = n >= 'MFGR#2225'; }
  if ($n == 149) { let $cond = n < ''; }
  if ($n == 150) { let $cond = n <= ''; }
