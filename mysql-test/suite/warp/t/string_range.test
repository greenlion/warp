  if ($n == 27) { let $cond = v > 'z'; }
  if ($n == 28) { let $cond = v >= 'z'; }
  if ($n == 29) { let $cond = v < 'é'; }
  if ($n == 30) { let $cond = v <= 'é'; }
  if ($n == 31) { let $cond = v > 'é'; }
  if ($n == 32) { let $cond = v >= 'é'; }
  if ($n == 33) { let $cond = v < 'zzz'; }
  if ($n == 34) { let $cond = v <= 'zzz'; }
  if ($n == 35) { let $cond = v > 'zzz'; }
  if ($n == 36) { let $cond = v >= 'zzz'; }
  if ($n == 37) { let $cond = v < 'B'; }
  if ($n == 38) { let $cond = v <= 'B'; }
  if ($n == 39) { let $cond = v > 'B'; }
  if ($n == 40) { let $cond = v >= 'B'; }
  if ($n == 41) { let $cond = v < 'a	'; }
  if ($n == 42) { let $cond = v <= 'a	'; }
  if ($n == 43) { let $cond = v > 'a	'; }
  if ($n == 44) { let $cond = v >= 'a	'; }
  if ($n == 45) { let $cond = v < 'a  b'; }
  if ($n == 46) { let $cond = v <= 'a  b'; }
  if ($n == 47) { let $cond = v > 'a  b'; }
  if ($n == 48) { let $cond = v >= 'a  b'; }
  if ($n == 49) { let $cond = v BETWEEN 'a' AND 'b'; }
  if ($n == 50) { let $cond = v BETWEEN 'a ' AND 'a  '; }
  if ($n == 51) { let $cond = v BETWEEN 'MFGR#2221' AND 'MFGR#2228'; }
  if ($n == 52) { let $cond = v BETWEEN '' AND ' '; }
  if ($n == 53) { let $cond = v BETWEEN 'b' AND 'a'; }
  if ($n == 54) { let $cond = v BETWEEN 'abc' AND 'abd'; }
  if ($n == 55) { let $cond = v BETWEEN 'é' AND '中'; }
  if ($n == 56) { let $cond = v BETWEEN 'a' AND 'a'; }
  if ($n == 57) { let $cond = v BETWEEN 'a	' AND 'a b'; }
  if ($n == 58) { let $cond = v BETWEEN 'a' AND 'b' AND p < 50; }
  if ($n == 59) { let $cond = v BETWEEN 'a' AND 'b' OR p = 7; }
  if ($n == 60) { let $cond = v BETWEEN 'a' AND 'b' OR v IS NULL; }
  if ($n == 61) { let $cond = NOT (v BETWEEN 'a' AND 'b'); }
  if ($n == 62) { let $cond = v NOT BETWEEN 'a' AND 'b'; }
  if ($n == 63) { let $cond = NOT (v < 'abc'); }
  if ($n == 64) { let $cond = 'abc' < v; }
  if ($n == 65) { let $cond = 'abc' >= v; }
  if ($n == 66) { let $cond = v >= 'a' AND v < 'b'; }
  if ($n == 67) { let $cond = c < 'a'; }
  if ($n == 68) { let $cond = c <= 'a'; }
