--echo #
--echo # MVIEW_REWRITE and common table expressions: the query expression of
--echo # a common table expression is rewritten as if it were a statement of
--echo # its own, in the text of the statement; the rest of the statement is
--echo # as it was.  Every statement is run with and without the plugin and
--echo # must give the same rows.
--echo #

--let $q_check = suite/warp/include/mview_rewrite_check.inc

CREATE TABLE customer (c_custkey INT PRIMARY KEY, c_name VARCHAR(25) NOT NULL,
  c_nation INT NOT NULL);
CREATE TABLE orders (o_orderkey INT PRIMARY KEY, o_custkey INT NOT NULL,
  o_status CHAR(1) NOT NULL, o_price DECIMAL(12,2) NOT NULL,
  o_date DATE NOT NULL,
  FOREIGN KEY (o_custkey) REFERENCES customer (c_custkey));
CREATE TABLE returned (r_orderkey INT NOT NULL, r_amount DECIMAL(12,2));
INSERT INTO customer
  WITH RECURSIVE s (k) AS (SELECT 1 UNION ALL SELECT k + 1 FROM s WHERE k < 30)
  SELECT k, CONCAT('Customer#', k), k % 5 FROM s;
INSERT INTO orders
  WITH RECURSIVE s (k) AS (SELECT 1 UNION ALL SELECT k + 1 FROM s WHERE k < 200)
  SELECT k, (k * 7 % 30) + 1, ELT(k % 3 + 1, 'F', 'O', 'P'),
         (k * 13 % 500) + 0.25, DATE'2025-01-01' + INTERVAL (k * 3 % 365) DAY
  FROM s;
INSERT INTO returned SELECT o_orderkey, o_price / 2 FROM orders
  WHERE o_orderkey % 4 = 0;

SET SESSION mview_rewrite_use_manual_views = ON;

CREATE MATERIALIZED VIEW by_cust REFRESH MANUAL AS
  SELECT o_custkey, o_status, COUNT(*) AS n, SUM(o_price) AS total
  FROM orders GROUP BY o_custkey, o_status;
CREATE MATERIALIZED VIEW by_nation REFRESH MANUAL AS
  SELECT c_nation, YEAR(o_date) AS y, COUNT(*) AS n, SUM(o_price) AS total
  FROM orders, customer WHERE o_custkey = c_custkey
  GROUP BY c_nation, YEAR(o_date);

--echo #
--echo # One common table expression, read twice (as in TPC-DS query 1)
--echo #
--let $mvr_query = WITH t AS (SELECT o_custkey AS k, o_status AS s, SUM(o_price) AS total FROM orders GROUP BY o_custkey, o_status) SELECT t1.k, t1.s, t1.total FROM t t1 WHERE t1.total > (SELECT AVG(t2.total) * 1.2 FROM t t2 WHERE t2.s = t1.s) ORDER BY 1, 2
--source $q_check

--echo # with a join to a table in the statement, and coarser groups
--let $mvr_query = WITH t AS (SELECT o_custkey, COUNT(*) AS n FROM orders GROUP BY o_custkey) SELECT c_name, n FROM t, customer WHERE o_custkey = c_custkey AND n > 6 ORDER BY c_name
--source $q_check

--echo # a list of column names
--let $mvr_query = WITH t (k, cnt, amount) AS (SELECT o_custkey, COUNT(*), SUM(o_price) FROM orders WHERE o_status = 'F' GROUP BY o_custkey) SELECT k, cnt, amount FROM t WHERE cnt > 2
--source $q_check

--echo #
--echo # Several common table expressions: each one on its own
--echo #
--echo # two that are rewritten, to two views
--let $mvr_query = WITH a AS (SELECT o_custkey, SUM(o_price) AS total FROM orders GROUP BY o_custkey), b AS (SELECT c_nation, SUM(o_price) AS total FROM orders, customer WHERE o_custkey = c_custkey AND YEAR(o_date) = 2025 GROUP BY c_nation) SELECT c_name, a.total, b.total FROM a, b, customer WHERE a.o_custkey = c_custkey AND b.c_nation = customer.c_nation AND c_custkey < 6
--source $q_check

--echo # one that is rewritten and one that is not (no view of returned)
--let $mvr_query = WITH a AS (SELECT o_custkey, COUNT(*) AS n FROM orders GROUP BY o_custkey), r AS (SELECT o_custkey, SUM(r_amount) AS back FROM returned, orders WHERE r_orderkey = o_orderkey GROUP BY o_custkey) SELECT a.o_custkey, n, back FROM a LEFT JOIN r ON a.o_custkey = r.o_custkey WHERE n > 7
--source $q_check

--echo # one that reads another: the other is rewritten
--let $mvr_query = WITH a AS (SELECT o_custkey, COUNT(*) AS n FROM orders GROUP BY o_custkey), b AS (SELECT MAX(n) AS most FROM a) SELECT o_custkey, n FROM a, b WHERE n = most
--source $q_check

--echo # one that is not read stays as it is (the parser leaves it out)
--let $mvr_query = WITH a AS (SELECT o_custkey, COUNT(*) AS n FROM orders GROUP BY o_custkey), b AS (SELECT o_status, COUNT(*) AS n FROM orders GROUP BY o_status) SELECT * FROM b
--source $q_check

--echo #
--echo # The name of a base table that a view has is the name of a common
--echo # table expression: it is not the base table
--echo #
--let $mvr_query = WITH orders AS (SELECT c_custkey AS o_custkey, 'F' AS o_status, 1.00 AS o_price FROM customer WHERE c_custkey < 4), t AS (SELECT o_custkey, COUNT(*) AS n, SUM(o_price) AS total FROM orders GROUP BY o_custkey) SELECT * FROM t
--source $q_check
--echo # with the schema it is the base table
--let $mvr_query = WITH orders AS (SELECT c_custkey AS o_custkey FROM customer WHERE c_custkey < 4), t AS (SELECT o_custkey, COUNT(*) AS n, SUM(o_price) AS total FROM test.orders GROUP BY o_custkey) SELECT t.* FROM t, orders WHERE t.o_custkey = orders.o_custkey
--source $q_check

--echo #
--echo # The rest of the statement is kept: subqueries, set operations,
--echo # outer joins, window functions, comments, EXPLAIN
--echo #
--let $mvr_query = WITH t AS (SELECT o_custkey, o_status, COUNT(*) AS n FROM orders GROUP BY o_custkey, o_status) SELECT c_name FROM customer WHERE c_custkey IN (SELECT o_custkey FROM t WHERE n > 4) UNION ALL SELECT CONCAT('status ', o_status) FROM t GROUP BY o_status HAVING SUM(n) > 60
--source $q_check
--let $mvr_query = WITH t AS (SELECT o_custkey, SUM(o_price) AS total FROM orders GROUP BY o_custkey) SELECT o_custkey, total, RANK() OVER (ORDER BY total DESC) AS r FROM t ORDER BY r LIMIT 5
--source $q_check
--let $mvr_query = /* a (comment) */ WITH /* t ( */ t AS /* ) */ ( /* in */ SELECT o_custkey, COUNT(*) AS `n ()` FROM orders /* ) ( */ WHERE o_status <> ')' GROUP BY o_custkey ) /* after ) */ SELECT 'ü (', t.* FROM t WHERE `n ()` > 7
--source $q_check
--let $mvr_query = WITH t AS ((SELECT o_custkey, COUNT(*) AS n FROM orders GROUP BY o_custkey ORDER BY n DESC, o_custkey LIMIT 3)) SELECT * FROM t
--source $q_check
# (the notes of EXPLAIN FORMAT=TREE are not the same in every version)
--disable_warnings
--replace_regex /cost=[0-9.e+-]*/cost=#/ /rows=[0-9.e+-]*/rows=#/
EXPLAIN FORMAT=TREE WITH t AS (SELECT o_custkey, COUNT(*) AS n FROM orders GROUP BY o_custkey) SELECT * FROM t WHERE n > 7;
--enable_warnings

--echo #
--echo # Not rewritten: set operations in the common table expression, a
--echo # recursive one, one that reads a column of the statement
--echo #
--let $mvr_query = WITH t AS (SELECT o_custkey, COUNT(*) AS n FROM orders GROUP BY o_custkey UNION ALL SELECT o_custkey, COUNT(*) FROM orders GROUP BY o_custkey) SELECT COUNT(*), SUM(n) FROM t
--source $q_check
--let $mvr_query = WITH RECURSIVE t (k, n) AS (SELECT o_custkey, COUNT(*) FROM orders GROUP BY o_custkey UNION ALL SELECT k + 100, n FROM t WHERE k < 100) SELECT COUNT(*), SUM(n) FROM t
--source $q_check
--let $mvr_query = SELECT c_name, (WITH t AS (SELECT COUNT(*) AS n FROM orders WHERE o_custkey = c_custkey) SELECT n FROM t) AS n FROM customer WHERE c_custkey < 4
--source $q_check

--echo # a WITH clause that is not the one of the statement (see also
--echo # mview_rewrite_subquery.test)
--let $mvr_query = SELECT * FROM (WITH t AS (SELECT o_custkey, COUNT(*) AS n FROM orders GROUP BY o_custkey) SELECT COUNT(*), SUM(n) FROM t) d
--source $q_check
--echo # in a recursive WITH clause the ones that are not recursive are
--let $mvr_query = WITH RECURSIVE s (k) AS (SELECT 1 UNION ALL SELECT k + 1 FROM s WHERE k < 3), t AS (SELECT o_custkey, COUNT(*) AS n FROM orders GROUP BY o_custkey) SELECT k, n FROM s, t WHERE k = o_custkey
--source $q_check

--echo #
--echo # The notes of the trace name the common table expression
--echo #
SET SESSION mview_rewrite_trace = ON;
--disable_result_log
WITH a AS (SELECT o_custkey, COUNT(*) AS n FROM orders GROUP BY o_custkey),
     r AS (SELECT r_orderkey, r_amount FROM returned UNION SELECT 1, 1)
SELECT * FROM a, r WHERE r_orderkey = o_custkey;
--enable_result_log
--replace_regex /positions: .*/positions: #/
SHOW WARNINGS;
SET SESSION mview_rewrite_trace = OFF;

--echo # INSERT ... SELECT is not rewritten, with or without WITH
CREATE TABLE copy (k INT, n INT);
INSERT INTO copy WITH t AS (SELECT o_custkey, COUNT(*) AS n FROM orders GROUP BY o_custkey) SELECT * FROM t;
SELECT COUNT(*), SUM(n) FROM copy;

DROP TABLE copy;
DROP MATERIALIZED VIEW by_cust;
DROP MATERIALIZED VIEW by_nation;
DROP TABLE returned, orders, customer;
