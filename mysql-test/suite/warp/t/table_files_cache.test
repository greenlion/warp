--echo #
--echo # The FastBit cache keeps the files of a table that was scanned between
--echo # statements.  A table that is created with the name of a table that was
--echo # dropped, renamed, truncated or rebuilt must not see the old files.
--echo #

--echo # DROP and CREATE with the same name
CREATE TABLE t1 (k INT, v VARCHAR(8)) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO t1 VALUES (1,'a'),(2,'b'),(3,'c'),(4,'d'),(5,'e');
SELECT COUNT(*), SUM(k) FROM t1;
DROP TABLE t1;
CREATE TABLE t1 (k INT, v VARCHAR(8)) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO t1 VALUES (10,'x'),(20,'y');
SELECT COUNT(*), SUM(k) FROM t1;
SELECT * FROM t1 ORDER BY k;
DROP TABLE t1;

--echo # TRUNCATE
CREATE TABLE t1 (k INT, v VARCHAR(8)) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO t1 VALUES (1,'a'),(2,'b'),(3,'c');
SELECT COUNT(*), SUM(k) FROM t1;
TRUNCATE TABLE t1;
SELECT COUNT(*) FROM t1;
INSERT INTO t1 VALUES (7,'z');
SELECT COUNT(*), SUM(k) FROM t1;
DROP TABLE t1;

--echo # RENAME: the old name is reused by another table
CREATE TABLE t1 (k INT) ENGINE=WARP;
INSERT INTO t1 VALUES (1),(2),(3),(4);
SELECT COUNT(*), SUM(k) FROM t1;
RENAME TABLE t1 TO t2;
CREATE TABLE t1 (k INT) ENGINE=WARP;
INSERT INTO t1 VALUES (100);
SELECT COUNT(*), SUM(k) FROM t1;
SELECT COUNT(*), SUM(k) FROM t2;
DROP TABLE t1, t2;

--echo # ALTER TABLE after rows were deleted and updated
CREATE TABLE t1 (k INT, v VARCHAR(8)) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO t1 VALUES (1,'A'),(2,'B'),(3,'C'),(9,'D');
UPDATE t1 SET v = 'XX' WHERE k IN (2, 9);
DELETE FROM t1 WHERE k = 3;
SELECT * FROM t1 ORDER BY k;
ALTER TABLE t1 ADD KEY k_t1 (k);
SELECT * FROM t1 ORDER BY k;
ALTER TABLE t1 ADD COLUMN extra INT;
SELECT * FROM t1 ORDER BY k;
ALTER TABLE t1 DROP KEY k_t1;
SELECT COUNT(*), SUM(k) FROM t1;
DROP TABLE t1;
