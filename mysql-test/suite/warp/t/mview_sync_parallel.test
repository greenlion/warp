--echo #
--echo # WARP_MVIEW daemon: a batch that changed many rows of one WARP table is
--echo # applied to the aggregate views by several sessions
--echo # (warp_mview_apply_threads).  Every session loads batches of the
--echo # changed rows into a delta table of its own and computes its part of
--echo # the change of the groups; the views are not refreshed.
--echo #
--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc
call mtr.add_suppression("WARP_MVIEW");
SHOW GLOBAL VARIABLES LIKE 'warp_mview_apply_threads';
--let $full_refreshes_before = query_get_value(SHOW GLOBAL STATUS LIKE 'Warp_mview_full_refreshes', Value, 1)
--let $parallel_before = query_get_value(SHOW GLOBAL STATUS LIKE 'Warp_mview_parallel_applies', Value, 1)

--let $wopt = ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin
eval CREATE TABLE pd (id INT NOT NULL, region VARCHAR(10), PRIMARY KEY (id)) $wopt;
eval CREATE TABLE pf (id INT NOT NULL, d_id INT, amount INT) $wopt;
INSERT INTO pd VALUES (0, 'north'), (1, 'south'), (2, 'east'), (3, NULL), (4, 'west'), (5, 'north'), (6, 'south');

--let $sel_join = SELECT d.region, COUNT(*) AS n, SUM(f.amount) AS s, COUNT(f.amount) AS c FROM pf f JOIN pd d ON f.d_id = d.id WHERE d.id <> 6 GROUP BY d.region
--let $sel_minmax = SELECT d.region, MIN(f.amount) AS mn, MAX(f.amount) AS mx FROM pf f JOIN pd d ON f.d_id = d.id GROUP BY d.region
--let $sel_one = SELECT d_id, COUNT(*) AS n, SUM(amount) AS s FROM pf GROUP BY d_id
--let $sel_nog = SELECT COUNT(*) AS n, SUM(amount) AS s FROM pf
eval CREATE MATERIALIZED VIEW p_join ENGINE=WARP REFRESH SYNCHRONOUS AS $sel_join;
eval CREATE MATERIALIZED VIEW p_minmax ENGINE=WARP REFRESH SYNCHRONOUS AS $sel_minmax;
eval CREATE MATERIALIZED VIEW p_one ENGINE=WARP REFRESH SYNCHRONOUS AS $sel_one;
eval CREATE MATERIALIZED VIEW p_nog ENGINE=InnoDB REFRESH SYNCHRONOUS AS $sel_nog;

--let $check = suite/warp/include/mview_sync_parallel_check.inc
--source $check

--echo # 250000 rows are inserted by one statement
SET SESSION cte_max_recursion_depth = 1000000;
INSERT INTO pf WITH RECURSIVE n(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM n WHERE x < 250000) SELECT x, x MOD 8, IF(x MOD 11 = 0, NULL, x MOD 1000) FROM n;
--source $check
--echo # 250000 rows are updated: an old and a new image of every row
UPDATE pf SET amount = amount + 7, d_id = (d_id + 1) MOD 8;
--source $check
--echo # a few rows: the daemon applies them alone
INSERT INTO pf VALUES (300001, 2, 5000), (300002, 3, -5);
--source $check
--echo # 225000 rows are deleted, with the largest and the smallest amounts
DELETE FROM pf WHERE id > 25000;
--source $check
--echo # many rows of the dimension table too: both tables changed
INSERT INTO pf WITH RECURSIVE n(x) AS (SELECT 400001 UNION ALL SELECT x + 1 FROM n WHERE x < 620000) SELECT x, x MOD 8, x MOD 100 FROM n;
UPDATE pd SET region = 'south' WHERE id = 2;
--source $check

--disable_query_log
eval SELECT VARIABLE_VALUE - $full_refreshes_before AS full_refreshes FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Warp_mview_full_refreshes';
eval SELECT VARIABLE_VALUE - $parallel_before > 0 AS applied_by_several_sessions FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Warp_mview_parallel_applies';
--enable_query_log
SELECT VARIABLE_VALUE AS apply_errors FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Warp_mview_apply_errors';

--echo # one session: the daemon applies the rows alone
SET GLOBAL warp_mview_apply_threads = 1;
--let $parallel_before = query_get_value(SHOW GLOBAL STATUS LIKE 'Warp_mview_parallel_applies', Value, 1)
UPDATE pf SET amount = amount - 3;
--source $check
--disable_query_log
eval SELECT VARIABLE_VALUE - $parallel_before AS applied_by_several_sessions FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Warp_mview_parallel_applies';
--enable_query_log
SET GLOBAL warp_mview_apply_threads = DEFAULT;

DROP MATERIALIZED VIEW p_join;
DROP MATERIALIZED VIEW p_minmax;
DROP MATERIALIZED VIEW p_one;
DROP MATERIALIZED VIEW p_nog;
DROP TABLE pf, pd;
