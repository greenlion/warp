--echo #
--echo # UNIQUE and PRIMARY KEY.  A row may not have the key of a row that
--echo # exists (committed or written by the transaction, and not deleted).
--echo # The key is locked before it is looked for, so two transactions can
--echo # not insert it at the same time.  NULL is not equal to NULL.
--echo #

CREATE TABLE t (id INT NOT NULL, u VARCHAR(10), v INT, PRIMARY KEY (id), UNIQUE KEY (u))
  ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
SHOW CREATE TABLE t;
INSERT INTO t VALUES (1, 'a', 10), (2, 'b', 20), (3, NULL, 30), (4, NULL, 40);
--error ER_DUP_ENTRY
INSERT INTO t VALUES (1, 'z', 0);
--error ER_DUP_ENTRY
INSERT INTO t VALUES (9, 'a', 0);
--echo # PAD SPACE: 'a ' is 'a' in utf8mb4_bin
--error ER_DUP_ENTRY
INSERT INTO t VALUES (9, 'a ', 0);
--echo # a duplicate within the statement, nothing of the statement is inserted
--error ER_DUP_ENTRY
INSERT INTO t VALUES (5, 'e', 50), (6, 'f', 60), (5, 'g', 70);
SELECT * FROM t ORDER BY id;
INSERT IGNORE INTO t VALUES (1, 'x', 0), (5, 'e', 50), (6, 'b', 60), (7, NULL, 70);
SELECT * FROM t ORDER BY id;
REPLACE INTO t VALUES (2, 'bb', 22), (8, 'a', 88);
SELECT * FROM t ORDER BY id;
INSERT INTO t VALUES (8, 'h', 0) ON DUPLICATE KEY UPDATE v = v + 1, u = 'h';
INSERT INTO t VALUES (9, 'h', 99) ON DUPLICATE KEY UPDATE v = v + 100;
INSERT INTO t VALUES (10, 'j', 100) ON DUPLICATE KEY UPDATE v = 0;
SELECT * FROM t ORDER BY id;
--echo # updates
--error ER_DUP_ENTRY
UPDATE t SET id = 2 WHERE id = 5;
--error ER_DUP_ENTRY
UPDATE t SET u = 'bb' WHERE id = 10;
UPDATE t SET v = v + 1 WHERE id = 5;
UPDATE t SET u = 'a ' WHERE u = 'a';
UPDATE t SET id = id + 100 WHERE id > 7;
UPDATE t SET u = NULL WHERE id IN (1, 5);
SELECT * FROM t ORDER BY id;
--echo # a deleted key can be inserted again
DELETE FROM t WHERE id = 2;
INSERT INTO t VALUES (2, 'bb', 2);
SELECT * FROM t ORDER BY id;
--echo # the lookups through the keys
SELECT * FROM t WHERE id = 108;
SELECT * FROM t WHERE u = 'h';
SELECT id FROM t FORCE INDEX (PRIMARY) WHERE id BETWEEN 2 AND 7 ORDER BY id;

--echo #
--echo # In a transaction: the statement that fails is rolled back, the others
--echo # stay
--echo #
BEGIN;
INSERT INTO t VALUES (20, 't20', 0);
--error ER_DUP_ENTRY
INSERT INTO t VALUES (21, 't21', 0), (22, 't22', 0), (20, 'dup', 0);
INSERT INTO t VALUES (21, 't21', 1);
--error ER_DUP_ENTRY
UPDATE t SET id = 2 WHERE id = 21;
DELETE FROM t WHERE id = 20;
INSERT INTO t VALUES (20, 't20b', 2);
REPLACE INTO t VALUES (30, 't30', 0), (31, 't30', 0), (30, 'x', 0), (32, 'bb', 0), (33, 'h', 0), (34, NULL, 0), (35, 'h', 0), (35, 'q', 0), (36, 'h', 0), (35, 'x', 0) ;
SELECT * FROM t WHERE id >= 20 ORDER BY id;
COMMIT;
SELECT * FROM t WHERE id >= 20 ORDER BY id;
BEGIN;
INSERT INTO t VALUES (40, 't40', 0);
ROLLBACK;
INSERT INTO t VALUES (40, 't40', 1);
SELECT * FROM t WHERE id = 40;

--echo #
--echo # Two transactions: the second insert of a key waits for the first one,
--echo # which committed (duplicate) or rolled back (no duplicate)
--echo #
connect (con1, localhost, root,,);
connect (con2, localhost, root,,);
connection con1;
BEGIN;
INSERT INTO t VALUES (50, 'c50', 0);
connection con2;
send INSERT INTO t VALUES (50, 'c50b', 1);
connection con1;
--sleep 0.5
COMMIT;
connection con2;
--error ER_DUP_ENTRY
reap;
connection con1;
BEGIN;
INSERT INTO t VALUES (51, 'c51', 0);
connection con2;
send INSERT INTO t VALUES (51, 'c51b', 1);
connection con1;
--sleep 0.5
ROLLBACK;
connection con2;
reap;
SELECT * FROM t WHERE id IN (50, 51) ORDER BY id;
--echo # a key that an open transaction deletes is free once it commits
connection con1;
BEGIN;
DELETE FROM t WHERE id = 51;
connection con2;
send INSERT INTO t VALUES (51, 'c51c', 2);
connection con1;
--sleep 0.5
COMMIT;
connection con2;
reap;
SELECT * FROM t WHERE id = 51;
--echo # the lock wait times out
connection con1;
BEGIN;
INSERT INTO t VALUES (52, 'c52', 0);
connection con2;
SET SESSION warp_lock_wait_timeout = 1;
--error ER_LOCK_WAIT_TIMEOUT
INSERT INTO t VALUES (52, 'c52b', 1);
connection con1;
COMMIT;
--echo # REPEATABLE READ: a key that another transaction committed after the
--echo # snapshot is a duplicate, though the row is not visible
connection con1;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
BEGIN;
SELECT COUNT(*) FROM t;
connection con2;
INSERT INTO t VALUES (53, 'c53', 0);
connection con1;
SELECT COUNT(*) FROM t WHERE id = 53;
--error ER_DUP_ENTRY
INSERT INTO t VALUES (53, 'c53b', 0);
COMMIT;
disconnect con1;
disconnect con2;
connection default;

--echo #
--echo # Keys of several columns, of other types, and of other collations
--echo #
CREATE TABLE m (a INT, b DATE, c VARCHAR(10) COLLATE utf8mb4_0900_as_cs, d BIGINT,
  UNIQUE KEY ab (a, b), UNIQUE KEY c (c), PRIMARY KEY (d)) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO m VALUES (1, '2020-01-01', 'a', 1), (1, '2020-01-02', 'A', 2), (2, '2020-01-01', 'a ', 3), (NULL, '2020-01-01', NULL, 4), (NULL, '2020-01-01', NULL, 5);
--error ER_DUP_ENTRY
INSERT INTO m VALUES (1, '2020-01-01', 'q', 6);
--error ER_DUP_ENTRY
INSERT INTO m VALUES (7, '2020-01-01', 'A', 7);
--error ER_DUP_ENTRY
INSERT INTO m VALUES (7, '2020-01-01', 'r', 9223372036854775807), (8, '2020-01-01', 's', 9223372036854775807);
SELECT * FROM m ORDER BY d;

--echo #
--echo # Many rows: the keys of the rows that are not written yet are checked
--echo # too, and a long load
--echo #
SET SESSION cte_max_recursion_depth = 100000;
CREATE TABLE big (id INT PRIMARY KEY, k INT, UNIQUE KEY (k)) ENGINE=WARP;
INSERT INTO big WITH RECURSIVE seq(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM seq WHERE x < 5000)
  SELECT x, x * 2 FROM seq;
--error ER_DUP_ENTRY
INSERT INTO big WITH RECURSIVE seq(x) AS (SELECT 6000 UNION ALL SELECT x + 1 FROM seq WHERE x < 7000)
  SELECT x, IF(x = 6999, 10, x * 2) FROM seq;
--error ER_DUP_ENTRY
INSERT INTO big WITH RECURSIVE seq(x) AS (SELECT 6000 UNION ALL SELECT x + 1 FROM seq WHERE x < 7000)
  SELECT IF(x = 6500, 6001, x), x * 2 FROM seq;
SELECT COUNT(*), MIN(id), MAX(id) FROM big;
INSERT INTO big WITH RECURSIVE seq(x) AS (SELECT 6000 UNION ALL SELECT x + 1 FROM seq WHERE x < 7000)
  SELECT x, x * 2 FROM seq;
SELECT COUNT(*), COUNT(DISTINCT id), COUNT(DISTINCT k) FROM big;

--echo #
--echo # ALTER TABLE: a new UNIQUE or PRIMARY KEY checks the rows, dropping one
--echo # does not
--echo #
CREATE TABLE a (id INT, k INT) ENGINE=WARP;
INSERT INTO a VALUES (1, 1), (2, 2), (3, 2);
--error ER_DUP_ENTRY
ALTER TABLE a ADD UNIQUE KEY (k);
ALTER TABLE a ADD PRIMARY KEY (id);
--error ER_DUP_ENTRY
INSERT INTO a VALUES (1, 5);
ALTER TABLE a DROP PRIMARY KEY, ALGORITHM=INPLACE;
INSERT INTO a VALUES (1, 5);
ALTER TABLE a ADD INDEX (k), ALGORITHM=INPLACE;
SELECT * FROM a ORDER BY id, k;

--echo #
--echo # Partitioned tables: the keys contain the columns of the partitioning
--echo #
CREATE TABLE p (id INT, d DATE, s VARCHAR(10), PRIMARY KEY (id, d), UNIQUE KEY (s, d))
  ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin
  PARTITION BY RANGE (YEAR(d)) (PARTITION p2020 VALUES LESS THAN (2021), PARTITION pmax VALUES LESS THAN MAXVALUE);
INSERT INTO p VALUES (1, '2020-01-01', 'a'), (1, '2021-01-01', 'a'), (2, '2020-05-05', 'b');
--error ER_DUP_ENTRY
INSERT INTO p VALUES (1, '2021-01-01', 'z');
--error ER_DUP_ENTRY
INSERT INTO p VALUES (3, '2020-01-01', 'a');
INSERT INTO p VALUES (1, '2020-01-01', 'q') ON DUPLICATE KEY UPDATE s = 'aa';
REPLACE INTO p VALUES (2, '2020-05-05', 'bb');
--error ER_DUP_ENTRY
UPDATE p SET d = '2021-01-01' WHERE id = 1 AND d = '2020-01-01';
SELECT * FROM p ORDER BY id, d;
--error ER_UNIQUE_KEY_NEED_ALL_FIELDS_IN_PF
CREATE TABLE bad (id INT PRIMARY KEY, d DATE) ENGINE=WARP PARTITION BY RANGE (YEAR(d)) (PARTITION p VALUES LESS THAN MAXVALUE);

--echo # The keys are checked after a restart
--source include/restart_mysqld.inc
--error ER_DUP_ENTRY
INSERT INTO t VALUES (3, 'new', 0);
--error ER_DUP_ENTRY
INSERT INTO p VALUES (1, '2021-01-01', 'z');
--error ER_DUP_ENTRY
INSERT INTO big VALUES (6500, 1);
SELECT COUNT(*) FROM t;

DROP TABLE t, m, big, a, p;
