--echo #
--echo # A partition holds at most warp_partition_max_rows rows.  When the rows
--echo # that are buffered for a write (warp_write_cache_size) are more than that,
--echo # the rows that did not fit in a partition were lost.
--echo #

SET @save_max = @@global.warp_partition_max_rows;
SET GLOBAL warp_partition_max_rows = 64000;
SET SESSION cte_max_recursion_depth = 400000;

CREATE TABLE t (a INT, b INT) ENGINE=WARP;
INSERT INTO t WITH RECURSIVE s(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM s WHERE x < 300000)
  SELECT x, x % 7 FROM s;
SELECT COUNT(*), COUNT(DISTINCT a), MIN(a), MAX(a), SUM(b) FROM t;

--echo # the same in two statements, and with a delete
INSERT INTO t WITH RECURSIVE s(x) AS (SELECT 300001 UNION ALL SELECT x + 1 FROM s WHERE x < 400000)
  SELECT x, x % 7 FROM s;
DELETE FROM t WHERE a % 1000 = 0;
SELECT COUNT(*), COUNT(DISTINCT a), MIN(a), MAX(a), SUM(b) FROM t;

DROP TABLE t;
SET GLOBAL warp_partition_max_rows = @save_max;
SET SESSION cte_max_recursion_depth = DEFAULT;
