--echo #
--echo # A constant that is an expression (0.06 - 0.01, 12 * 2, -5) is the number that it
--echo # has: the condition is pushed down to FastBit like one with a literal.  Every
--echo # condition is run against the WARP table and an InnoDB copy.
--echo #

CREATE TABLE t_w (id INT, i INT, u INT UNSIGNED, b BIGINT, d DECIMAL(10,2), f DOUBLE, ti TINYINT, n INT NULL, v VARCHAR(10)) ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO t_w WITH RECURSIVE x(k) AS (SELECT 1 UNION ALL SELECT k + 1 FROM x WHERE k < 400)
  SELECT k, (k % 41) - 20, k % 37, (k - 200) * 1000003, ((k % 61) - 30) / 4, ((k % 53) - 26) / 3, (k % 17) - 8, IF(k % 7 = 0, NULL, (k % 29) - 14), CONCAT('s', k % 9) FROM x;
CREATE TABLE t_i LIKE t_w;
ALTER TABLE t_i ENGINE=InnoDB;
INSERT INTO t_i SELECT * FROM t_w;

CREATE TABLE preds (i INT, p VARCHAR(200));
INSERT INTO preds VALUES
 (1, 'd BETWEEN 0.06 - 0.01 AND 0.06 + 0.01'), (2, 'd BETWEEN 1 - 5 AND 2 + 3'), (3, 'i < 12 * 2'), (4, 'i > -5'), (5, 'i >= -(5)'),
 (6, 'i < 3 - 10'), (7, 'i = 2 * 3 - 4'), (8, 'i IN (5, -5)'), (9, 'i IN (-5, 5)'), (10, 'i IN (-7, -5)'), (11, 'i IN (-5, 5, 0)'),
 (12, 'i IN (1 + 1, 2 * 2, -3)'), (13, 'u < 10 + 5'), (14, 'u > 40 - 10'), (15, 'b < 1000 * 1000'), (16, 'b > -(1000 * 1000)'),
 (17, 'f < 1.5 + 1.5'), (18, 'f >= -2.5 * 2'), (19, 'd < 5.25 * 2'), (20, 'd >= 1.1 + 1.1'), (21, 'd = 0.25 + 0.25'), (22, 'd <> 1.0 + 0.5'),
 (23, 'ti BETWEEN -1 - 1 AND 1 + 1'), (24, 'ti NOT IN (1 + 1, -3)'), (25, 'n > 5 - 10'), (26, 'n IN (3, -3)'), (27, 'n BETWEEN 2 * -1 AND 2'),
 (28, '5 - 3 > i'), (29, '-5 < i AND i < 10 / 2'), (30, 'i < 10 DIV 3'), (31, 'i < 7 MOD 4'), (32, 'd > ABS(-2) / 4'),
 (33, 'i < 100 OR d > 2 + 2'), (34, 'NOT (i < 3 + 2)'), (35, 'i < (SELECT 5)'), (36, 'i < RAND() * 0 + 5'), (37, 'v = CONCAT(''s'', 3)'),
 (38, 'f < 1.0e1 / 4'), (39, 'u < 4294967295 - 4294967290'), (40, 'b < 9223372036854775807 - 9223372036854775800');

--let $i = 1
while ($i <= 40)
{
  --let $p = `SELECT p FROM preds WHERE i = $i`
  --disable_query_log
  --let $rows = `SELECT COUNT(*) FROM t_w WHERE $p`
  --let $same = `SELECT (SELECT CONCAT(COUNT(*), '/', COALESCE(SUM(id), 0)) FROM t_w WHERE $p) = (SELECT CONCAT(COUNT(*), '/', COALESCE(SUM(id), 0)) FROM t_i WHERE $p)`
  --enable_query_log
  --echo # $p: $rows rows, same as InnoDB: $same
  --inc $i
}

--echo # the conditions with a constant that is an expression are not left to MySQL
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM t_w WHERE d BETWEEN 0.06 - 0.01 AND 0.06 + 0.01 AND i < 12 * 2;
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM t_w WHERE i IN (5, -5);

DROP TABLE t_w, t_i, preds;
