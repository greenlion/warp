--echo #
--echo # LOCK TABLES keeps a table open past the statements that read it: the
--echo # statements are over before the table is unlocked, and the pushdown
--echo # information of the table is cleaned up when the lock is released.
--echo # Its key was made from the table reference of the statement that
--echo # stored the information, and that reference is gone then: it must
--echo # not be read (a connection that failed while it held the locks of a
--echo # WARP table, like mysqldump, crashed the server when it was dropped).
--echo #


call mtr.add_suppression("MY-015655");
CREATE TABLE t1 (id INT NOT NULL, cat VARCHAR(10), val DECIMAL(10,2))
  ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE t2 (id INT NOT NULL, cat VARCHAR(10), val DECIMAL(10,2))
  ENGINE=WARP DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
INSERT INTO t1 VALUES (1,'a',1.25), (2,'b',2.50), (3,'a',4.00),
                      (4,'b',0.75), (5,'a',NULL);
INSERT INTO t2 VALUES (1,'a',10.00), (2,'b',20.00);

--echo # a pushdown query stores pushdown information under the alias key
SELECT cat, COUNT(*), SUM(val) FROM t1 GROUP BY cat ORDER BY cat;
SELECT COUNT(*) FROM t1 JOIN t2 ON t1.id = t2.id;

--echo # lock, read, error, unlock: the cleanup runs when the lock is released
LOCK TABLES t1 READ, t2 READ;
SELECT cat, COUNT(*), SUM(val) FROM t1 GROUP BY cat ORDER BY cat;
--error ER_TABLE_NOT_LOCKED
SELECT * FROM t1, t2, t1 AS x;
UNLOCK TABLES;
SELECT cat, COUNT(*), SUM(val) FROM t1 GROUP BY cat ORDER BY cat;

--echo # a connection that disconnects while it holds the locks
connect (con1,localhost,root,,);
LOCK TABLES t1 READ, t2 READ;
SELECT cat, COUNT(*), SUM(val) FROM t1 GROUP BY cat ORDER BY cat;
--error ER_TABLE_NOT_LOCKED
SELECT * FROM t1, t2, t1 AS x;
--echo # the locks are released when the connection is dropped
disconnect con1;
--sleep 1
connection default;
SELECT COUNT(*) FROM t1 JOIN t2 ON t1.id = t2.id;

--echo # a failed statement inside the locks of another connection
connect (con2,localhost,root,,);
LOCK TABLES t1 WRITE;
--error ER_TABLE_NOT_LOCKED
SELECT * FROM t2;
--echo # the write lock is released when the connection is dropped
disconnect con2;
--sleep 1
connection default;
SELECT COUNT(*) FROM t1;

DROP TABLE t1, t2;
--echo # end
