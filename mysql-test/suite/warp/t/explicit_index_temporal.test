--echo #
--echo # Indexes on date and time columns: lookups through a WARP index return
--echo # the same rows as InnoDB (TIMESTAMP values are in the time zone of the
--echo # session).
--echo #

SET SESSION time_zone = '+05:00';

CREATE TABLE w (id INT NOT NULL, d DATE, dt DATETIME, dt3 DATETIME(3), ts TIMESTAMP NULL, t TIME, t3 TIME(3), y YEAR, KEY d_idx (d), KEY dt_idx (dt), KEY dt3_idx (dt3), KEY ts_idx (ts), KEY t_idx (t), KEY t3_idx (t3), KEY y_idx (y), KEY dd_idx (d, t)) ENGINE=WARP;
CREATE TABLE i (id INT NOT NULL, d DATE, dt DATETIME, dt3 DATETIME(3), ts TIMESTAMP NULL, t TIME, t3 TIME(3), y YEAR, KEY d_idx (d), KEY dt_idx (dt), KEY dt3_idx (dt3), KEY ts_idx (ts), KEY t_idx (t), KEY t3_idx (t3), KEY y_idx (y), KEY dd_idx (d, t)) ENGINE=InnoDB;

SHOW CREATE TABLE w;

INSERT INTO w VALUES
 (1,'2024-02-29','2024-02-29 12:30:45','2024-02-29 12:30:45.123','2024-02-29 12:30:45','12:30:45','12:30:45.500',2024),
 (2,'1000-01-01','1000-01-01 00:00:00','1000-01-01 00:00:00.000',NULL,'-838:59:59','-00:00:00.500',1901),
 (3,NULL,NULL,NULL,NULL,NULL,NULL,NULL),
 (4,'2000-01-01','2000-01-01 00:00:00','2000-01-01 00:00:00.001','2000-01-01 00:00:01','00:00:00','00:00:00.000',2000),
 (5,'2024-02-29','2024-02-29 12:30:46','2024-02-29 12:30:45.124','2024-03-01 00:00:00','838:59:59','00:00:00.500',2155),
 (6,'0001-01-01','0001-01-01 00:00:00','2024-02-29 12:30:45.123',NULL,'-01:00:00','-12:00:00.000',0),
 (7,'2024-02-29','2024-02-29 12:30:45','2024-02-29 12:30:45.122','2024-02-29 12:30:45','12:30:45','12:30:45.500',2024),
 (8,'2023-12-31','2024-01-01 00:00:00','2023-12-31 23:59:59.999','2000-01-01 00:00:00','-12:00:00','-00:00:01.000',1999);
INSERT INTO i SELECT * FROM w;

let $q = 0;
while ($q < 36)
{
  inc $q;
  if ($q == 1)
  {
    let $where = d = '2024-02-29';
  }
  if ($q == 2)
  {
    let $where = d IS NULL;
  }
  if ($q == 3)
  {
    let $where = d <=> NULL;
  }
  if ($q == 4)
  {
    let $where = d > '2024-01-01';
  }
  if ($q == 5)
  {
    let $where = d >= '2000-01-01' AND d < '2024-02-29';
  }
  if ($q == 6)
  {
    let $where = d BETWEEN '1000-01-01' AND '2024-01-01';
  }
  if ($q == 7)
  {
    let $where = d < '0001-01-01';
  }
  if ($q == 8)
  {
    let $where = dt = '2024-02-29 12:30:45';
  }
  if ($q == 9)
  {
    let $where = dt > '2024-02-29 12:30:45';
  }
  if ($q == 10)
  {
    let $where = dt <= '2024-02-29 12:30:45';
  }
  if ($q == 11)
  {
    let $where = dt IS NULL;
  }
  if ($q == 12)
  {
    let $where = dt BETWEEN '2000-01-01 00:00:00' AND '2024-02-29 12:30:45';
  }
  if ($q == 13)
  {
    let $where = dt3 = '2024-02-29 12:30:45.123';
  }
  if ($q == 14)
  {
    let $where = dt3 > '2024-02-29 12:30:45.123';
  }
  if ($q == 15)
  {
    let $where = dt3 < '2024-02-29 12:30:45.124';
  }
  if ($q == 16)
  {
    let $where = ts = '2024-02-29 12:30:45';
  }
  if ($q == 17)
  {
    let $where = ts > '2000-01-01 00:00:00';
  }
  if ($q == 18)
  {
    let $where = ts IS NULL;
  }
  if ($q == 19)
  {
    let $where = ts <= '2024-02-29 12:30:45';
  }
  if ($q == 20)
  {
    let $where = t = '12:30:45';
  }
  if ($q == 21)
  {
    let $where = t < '00:00:00';
  }
  if ($q == 22)
  {
    let $where = t > '-01:00:00';
  }
  if ($q == 23)
  {
    let $where = t >= '838:59:59';
  }
  if ($q == 24)
  {
    let $where = t <= '-838:59:59';
  }
  if ($q == 25)
  {
    let $where = t IS NULL;
  }
  if ($q == 26)
  {
    let $where = t BETWEEN '-12:00:00' AND '12:30:45';
  }
  if ($q == 27)
  {
    let $where = t3 = '12:30:45.500';
  }
  if ($q == 28)
  {
    let $where = t3 < '00:00:00.000';
  }
  if ($q == 29)
  {
    let $where = t3 > '-00:00:00.500';
  }
  if ($q == 30)
  {
    let $where = y = 2024;
  }
  if ($q == 31)
  {
    let $where = y > 2000;
  }
  if ($q == 32)
  {
    let $where = y IS NULL;
  }
  if ($q == 33)
  {
    let $where = y BETWEEN 1901 AND 2024;
  }
  if ($q == 34)
  {
    let $where = d = '2024-02-29' AND t = '12:30:45';
  }
  if ($q == 35)
  {
    let $where = dt = '2024-02-29 12:30:45' AND d > '2000-01-01';
  }
  if ($q == 36)
  {
    let $where = dt IN ('2024-02-29 12:30:45', '1000-01-01 00:00:00');
  }
  let $got = `SELECT IFNULL(GROUP_CONCAT(id ORDER BY id), '') FROM w FORCE INDEX (d_idx, dt_idx, dt3_idx, ts_idx, t_idx, t3_idx, y_idx, dd_idx) WHERE $where`;
  let $want = `SELECT IFNULL(GROUP_CONCAT(id ORDER BY id), '') FROM i IGNORE INDEX (d_idx, dt_idx, dt3_idx, ts_idx, t_idx, t3_idx, y_idx, dd_idx) WHERE $where`;
  if ($got != $want)
  {
    --echo MISMATCH for $where: WARP $got, InnoDB $want
  }
}
--echo # the lookups were compared

--echo # the lookups find rows
SELECT id FROM w FORCE INDEX (dt_idx) WHERE dt = '2024-02-29 12:30:45' ORDER BY id;
SELECT id FROM w FORCE INDEX (ts_idx) WHERE ts = '2024-02-29 12:30:45' ORDER BY id;
SELECT id FROM w FORCE INDEX (t_idx) WHERE t < '00:00:00' ORDER BY id;
SELECT id FROM w FORCE INDEX (y_idx) WHERE y = 2024 ORDER BY id;

--echo # a join through the index
CREATE TABLE dd (k DATETIME, v INT) ENGINE=WARP;
INSERT INTO dd VALUES ('2024-02-29 12:30:45', 1), ('2000-01-01 00:00:00', 2), (NULL, 3);
SELECT dd.v, GROUP_CONCAT(w.id ORDER BY w.id) FROM dd JOIN w FORCE INDEX (dt_idx) ON w.dt = dd.k
  GROUP BY dd.v ORDER BY dd.v;

DROP TABLE w, i, dd;
