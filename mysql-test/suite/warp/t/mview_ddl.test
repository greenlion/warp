--echo #
--echo # Materialized views: syntax, checks of the definition, the guard of
--echo # the tables, privileges
--echo #
call mtr.add_suppression("MY-015655");

--echo # REFRESH and SYNCHRONOUS are not reserved words
CREATE TABLE refresh (refresh INT PRIMARY KEY, synchronous INT, manual INT,
                      materialized INT);
INSERT INTO refresh VALUES (1, 2, 3, 4);
SELECT refresh, synchronous, manual, materialized FROM refresh AS synchronous;
CREATE TABLE synchronous (id INT PRIMARY KEY, refresh INT);
DROP TABLE refresh, synchronous;

CREATE TABLE t1 (id INT PRIMARY KEY, a INT, name VARCHAR(20));
CREATE TABLE t2 (id INT PRIMARY KEY, t1_id INT, b DECIMAL(10,2));
CREATE TABLE nopk (id INT, a INT);
CREATE TABLE uniq (id INT NOT NULL UNIQUE, a INT);
INSERT INTO t1 VALUES (1, 10, 'one'), (2, 20, 'two'), (3, 30, NULL);
INSERT INTO t2 VALUES (1, 1, 1.50), (2, 1, 2.50), (3, 9, 3.50);
CREATE VIEW plain_v AS SELECT id, a FROM t1;
CREATE TEMPORARY TABLE tmp (id INT PRIMARY KEY, a INT);
CREATE FUNCTION f1(x INT) RETURNS INT DETERMINISTIC RETURN x + 1;

--echo #
--echo # Syntax
--echo #
CREATE MATERIALIZED VIEW mv1 AS SELECT id, a FROM t1;
--echo # The default is the default engine and REFRESH SYNCHRONOUS
SHOW CREATE VIEW mv1;
CREATE MATERIALIZED VIEW IF NOT EXISTS mv1 AS SELECT id FROM t1;
--error ER_TABLE_EXISTS_ERROR
CREATE MATERIALIZED VIEW mv1 AS SELECT id FROM t1;
--error ER_TABLE_EXISTS_ERROR
CREATE MATERIALIZED VIEW t2 AS SELECT id FROM t1;
CREATE MATERIALIZED VIEW test.mv2 (x, y) ENGINE = InnoDB REFRESH MANUAL
  AS SELECT id, name FROM t1 WHERE a > 10;
CREATE MATERIALIZED VIEW mv3 ENGINE WARP REFRESH SYNCHRONOUS
  AS SELECT t1.id, t2.b FROM t1 JOIN t2 ON t2.t1_id = t1.id;
CREATE MATERIALIZED VIEW mv4 REFRESH MANUAL AS SELECT id FROM t1;
SHOW CREATE VIEW mv2;
SHOW CREATE VIEW mv3;
SHOW CREATE VIEW mv4;
SELECT * FROM mv2 ORDER BY x;
SELECT * FROM mv3 ORDER BY id, b;
--echo # A materialized view is a table, with invisible columns
SHOW CREATE TABLE mv3;
SELECT TABLE_NAME, TABLE_TYPE, ENGINE FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE 'mv_' ORDER BY TABLE_NAME;

--echo # The default engine
SET default_storage_engine = WARP;
CREATE MATERIALIZED VIEW mv5 AS SELECT id, name FROM t1;
SET default_storage_engine = DEFAULT;
CREATE MATERIALIZED VIEW mv6 AS SELECT id, name FROM t1;
SELECT TABLE_NAME, ENGINE FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('mv5', 'mv6') ORDER BY TABLE_NAME;
--echo # The strings of a WARP table have a collation that WARP stores
SELECT TABLE_NAME, COLUMN_NAME, COLLATION_NAME FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('mv5', 'mv6')
  AND COLUMN_NAME = 'name' ORDER BY TABLE_NAME;
SELECT * FROM mv5 ORDER BY id;
--error ER_UNKNOWN_STORAGE_ENGINE
CREATE MATERIALIZED VIEW mv7 ENGINE=no_such_engine AS SELECT id FROM t1;

--echo # Clauses of views that a materialized view does not have
--error ER_MVIEW_UNSUPPORTED_CLAUSE
CREATE OR REPLACE MATERIALIZED VIEW mv1 AS SELECT id FROM t1;
--error ER_MVIEW_UNSUPPORTED_CLAUSE
CREATE ALGORITHM=MERGE MATERIALIZED VIEW mv7 AS SELECT id FROM t1;
--error ER_MVIEW_UNSUPPORTED_CLAUSE
CREATE MATERIALIZED DEFINER=root@localhost VIEW mv7 AS SELECT id FROM t1;
--error ER_MVIEW_UNSUPPORTED_CLAUSE
CREATE MATERIALIZED SQL SECURITY INVOKER VIEW mv7 AS SELECT id FROM t1;
--error ER_MVIEW_UNSUPPORTED_CLAUSE
CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM t1 WITH CHECK OPTION;
--error ER_MVIEW_ALTER_DEFINITION
ALTER MATERIALIZED VIEW mv1 AS SELECT id FROM t1;
--error ER_PARSE_ERROR
CREATE VIEW v7 ENGINE=InnoDB AS SELECT id FROM t1;
--error ER_PARSE_ERROR
CREATE VIEW v7 REFRESH MANUAL AS SELECT id FROM t1;
--error ER_PARSE_ERROR
ALTER VIEW plain_v REFRESH MANUAL;
--error ER_PARSE_ERROR
ALTER MATERIALIZED VIEW mv1;
--error ER_PARSE_ERROR
ALTER MATERIALIZED VIEW mv1 ENGINE=InnoDB REFRESH MANUAL;
--error ER_PARSE_ERROR
REFRESH MATERIALIZED VIEW;
--error ER_PARSE_ERROR
REFRESH VIEW mv1;

--echo # Plain views are as they were
CREATE OR REPLACE ALGORITHM=MERGE VIEW plain_v AS SELECT id, a, name FROM t1;
ALTER VIEW plain_v AS SELECT id, name FROM t1;
SHOW CREATE VIEW plain_v;
SELECT * FROM plain_v ORDER BY id;

--echo #
--echo # ALTER MATERIALIZED VIEW ... REFRESH
--echo #
ALTER MATERIALIZED VIEW mv1 REFRESH MANUAL;
SHOW CREATE VIEW mv1;
ALTER MATERIALIZED VIEW test.mv1 REFRESH SYNCHRONOUS;
SHOW CREATE VIEW mv1;
--error ER_MVIEW_NOT_A_MVIEW
ALTER MATERIALIZED VIEW t1 REFRESH MANUAL;
--error ER_MVIEW_NOT_A_MVIEW
ALTER MATERIALIZED VIEW plain_v REFRESH MANUAL;
--error ER_MVIEW_NOT_A_MVIEW
ALTER MATERIALIZED VIEW no_such REFRESH MANUAL;
--error ER_MVIEW_NOT_A_MVIEW
REFRESH MATERIALIZED VIEW t1;
--error ER_MVIEW_NOT_A_MVIEW
REFRESH MATERIALIZED VIEW plain_v;
--error ER_MVIEW_NOT_A_MVIEW
REFRESH MATERIALIZED VIEW no_such;

--echo #
--echo # Definitions that are not supported
--echo #
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM t1 UNION SELECT id FROM t2;
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM t1 INTERSECT SELECT id FROM t2;
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM t1 EXCEPT SELECT id FROM t2;
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS
  SELECT id FROM t1 WHERE id IN (SELECT t1_id FROM t2);
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS
  SELECT id, (SELECT MAX(b) FROM t2) AS m FROM t1;
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS
  SELECT t1.id FROM t1 JOIN t2 ON t2.t1_id = t1.id AND EXISTS (SELECT 1 FROM t2);
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS SELECT d.id FROM (SELECT id FROM t1) AS d;
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS
  WITH c AS (SELECT id FROM t1) SELECT id FROM c;
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS
  SELECT j.x FROM t1, JSON_TABLE('[1]', '$[*]' COLUMNS (x INT PATH '$')) AS j;
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS SELECT 1 AS one;
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM t1 LIMIT 2;
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM t1 ORDER BY id;
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM t1 FOR UPDATE;
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM t1 FOR SHARE;
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM t1 FORCE INDEX (PRIMARY);
--error ER_VIEW_SELECT_CLAUSE
CREATE MATERIALIZED VIEW mv7 AS SELECT id INTO @x FROM t1;
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS
  SELECT id, ROW_NUMBER() OVER (ORDER BY id) AS rn FROM t1;
--echo # Functions that do not give the same value every time
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS SELECT id, RAND() AS r FROM t1;
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM t1 WHERE a < UNIX_TIMESTAMP();
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS SELECT id, NOW() AS n FROM t1;
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS SELECT id, UUID() AS u FROM t1;
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS
  SELECT t1.id FROM t1 JOIN t2 ON t2.t1_id = t1.id AND t2.b > RAND();
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS SELECT id, CURRENT_USER() AS u FROM t1;
--error ER_MVIEW_UNSUPPORTED_DEFINITION
CREATE MATERIALIZED VIEW mv7 AS SELECT id, f1(a) AS f FROM t1;
--error ER_VIEW_SELECT_VARIABLE
CREATE MATERIALIZED VIEW mv7 AS SELECT id, @uv AS v FROM t1;
--error ER_VIEW_SELECT_VARIABLE
CREATE MATERIALIZED VIEW mv7 AS SELECT id, @@sort_buffer_size AS v FROM t1;
--echo # Tables that are not base tables with a primary key
--error ER_MVIEW_UNSUPPORTED_TABLE
CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM plain_v;
--error ER_MVIEW_UNSUPPORTED_TABLE
CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM tmp;
--error ER_MVIEW_UNSUPPORTED_TABLE
CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM mv1;
--error ER_MVIEW_UNSUPPORTED_TABLE
CREATE MATERIALIZED VIEW mv7 AS
  SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES;
--error ER_MVIEW_UNSUPPORTED_TABLE
CREATE MATERIALIZED VIEW mv7 AS
  SELECT THREAD_ID FROM performance_schema.threads;
--error ER_MVIEW_UNSUPPORTED_TABLE
CREATE MATERIALIZED VIEW mv7 AS SELECT Help_topic_id FROM mysql.help_topic;
--error ER_MVIEW_NO_PRIMARY_KEY
CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM nopk;
--error ER_MVIEW_NO_PRIMARY_KEY
CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM uniq;
--error ER_MVIEW_NO_PRIMARY_KEY
CREATE MATERIALIZED VIEW mv7 AS
  SELECT t1.id FROM t1 LEFT JOIN nopk ON nopk.id = t1.id;
--error ER_NO_SUCH_TABLE
CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM no_such_table;
--error ER_NO_SUCH_TABLE
CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM mv7;
--echo # Names
CREATE DATABASE mvdb2;
CREATE TABLE mvdb2.t1 (id INT PRIMARY KEY);
--echo # Two tables with one alias cannot be told apart by the alias
--error ER_NONUNIQ_TABLE
CREATE MATERIALIZED VIEW mv7 AS
  SELECT test.t1.id FROM test.t1 JOIN mvdb2.t1 ON TRUE;
DROP DATABASE mvdb2;
--error ER_WRONG_COLUMN_NAME
CREATE MATERIALIZED VIEW mv7 AS SELECT id AS `mv$x` FROM t1;
--error ER_WRONG_COLUMN_NAME
CREATE MATERIALIZED VIEW mv7 (`MV$y`) AS SELECT id FROM t1;
--error ER_VIEW_WRONG_LIST
CREATE MATERIALIZED VIEW mv7 (x) AS SELECT id, a FROM t1;
--error ER_DUP_FIELDNAME
CREATE MATERIALIZED VIEW mv7 AS SELECT id, id FROM t1;
--error ER_DUP_FIELDNAME
CREATE MATERIALIZED VIEW mv7 (x, X) AS SELECT id, a FROM t1;
--echo # Nothing is left of a statement that failed
SHOW TABLES LIKE 'mv7%';
--echo # An expression without a name gets one
CREATE MATERIALIZED VIEW mv7 AS SELECT id, '' FROM t1;
SHOW CREATE VIEW mv7;
DROP MATERIALIZED VIEW mv7;
--echo # A statement that fails while the view is filled leaves nothing
SET sql_mode = '';
CREATE TABLE big (id INT PRIMARY KEY, v BIGINT UNSIGNED);
INSERT INTO big VALUES (1, 18446744073709551615);
--error ER_DATA_OUT_OF_RANGE
CREATE MATERIALIZED VIEW mv7 AS SELECT id, v + 1 AS w FROM big;
SET sql_mode = DEFAULT;
SHOW TABLES LIKE 'mv7%';
DROP TABLE big;

--echo #
--echo # Prepared statements and stored programs
--echo #
--error ER_UNSUPPORTED_PS
PREPARE s FROM 'CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM t1';
PREPARE s FROM 'REFRESH MATERIALIZED VIEW mv2';
INSERT INTO t1 VALUES (4, 40, 'four');
EXECUTE s;
INSERT INTO t1 VALUES (5, 50, 'five');
EXECUTE s;
DEALLOCATE PREPARE s;
SELECT * FROM mv2 ORDER BY x;
--error ER_SP_BADSTATEMENT
CREATE PROCEDURE p1() CREATE MATERIALIZED VIEW mv7 AS SELECT id FROM t1;
CREATE PROCEDURE p1() REFRESH MATERIALIZED VIEW mv2;
INSERT INTO t1 VALUES (6, 60, 'six');
CALL p1();
DELETE FROM t1 WHERE id = 4;
CALL p1();
SELECT * FROM mv2 ORDER BY x;
DROP PROCEDURE p1;
--echo # Not in a function: the statement commits
--delimiter |
--error ER_COMMIT_NOT_ALLOWED_IN_SF_OR_TRG
CREATE FUNCTION f2() RETURNS INT
BEGIN REFRESH MATERIALIZED VIEW mv2; RETURN 1; END|
--delimiter ;
--echo # REFRESH commits the transaction of the session
BEGIN;
INSERT INTO t1 VALUES (7, 70, 'seven');
REFRESH MATERIALIZED VIEW mv2;
ROLLBACK;
SELECT * FROM mv2 ORDER BY x;
--echo # Not under LOCK TABLES
LOCK TABLES t1 READ;
--error ER_LOCK_OR_ACTIVE_TRANSACTION
REFRESH MATERIALIZED VIEW mv2;
UNLOCK TABLES;

--echo #
--echo # The tables of materialized views are not changed directly
--echo #
--error ER_MVIEW_IS_READ_ONLY
INSERT INTO mv2 VALUES (100, 'x');
--error ER_MVIEW_IS_READ_ONLY
INSERT INTO mv2 SELECT id, name FROM t1;
--error ER_MVIEW_IS_READ_ONLY
REPLACE INTO mv2 VALUES (100, 'x');
--error ER_MVIEW_IS_READ_ONLY
UPDATE mv2 SET y = 'x';
--error ER_MVIEW_IS_READ_ONLY
UPDATE mv2, t2 SET mv2.y = 'x' WHERE mv2.x = t2.id;
--error ER_MVIEW_IS_READ_ONLY
DELETE FROM mv2;
--error ER_MVIEW_IS_READ_ONLY
DELETE mv2 FROM mv2, t2 WHERE mv2.x = t2.id;
--error ER_MVIEW_IS_READ_ONLY
DELETE FROM mv3 WHERE id = 1;
--error ER_MVIEW_IS_READ_ONLY
TRUNCATE TABLE mv2;
--error ER_MVIEW_IS_READ_ONLY
TRUNCATE TABLE mv3;
--error ER_MVIEW_IS_READ_ONLY
ALTER TABLE mv2 ADD COLUMN z INT;
--error ER_MVIEW_IS_READ_ONLY
ALTER TABLE mv2 RENAME TO mv2_renamed;
--error ER_MVIEW_IS_READ_ONLY
ALTER TABLE mv3 ENGINE=InnoDB;
--error ER_MVIEW_IS_READ_ONLY
CREATE INDEX ix ON mv2 (x);
--error ER_MVIEW_IS_READ_ONLY
DROP INDEX `mv$ix_pk0` ON mv2;
--error ER_MVIEW_IS_READ_ONLY
RENAME TABLE mv2 TO mv2_renamed;
--error ER_MVIEW_IS_READ_ONLY
DROP TABLE mv2;
--error ER_MVIEW_IS_READ_ONLY
DROP TABLE IF EXISTS t2, mv3;
--error ER_MVIEW_USE_DROP_MVIEW
DROP VIEW mv2;
--error ER_MVIEW_USE_DROP_MVIEW
DROP VIEW IF EXISTS mv2;
--error ER_MVIEW_IS_READ_ONLY
LOCK TABLES mv2 WRITE;
--error ER_MVIEW_IS_READ_ONLY
LOAD DATA INFILE 'no_such_file' INTO TABLE mv2;
--echo # A trigger or a function of another statement does not write either
CREATE TRIGGER trg AFTER INSERT ON t2 FOR EACH ROW
  INSERT INTO mv2 VALUES (NEW.id, 'trg');
--error ER_MVIEW_IS_READ_ONLY
INSERT INTO t2 VALUES (50, 1, 1.00);
DROP TRIGGER trg;
--delimiter |
CREATE FUNCTION f3() RETURNS INT BEGIN DELETE FROM mv2; RETURN 1; END|
--delimiter ;
--error ER_MVIEW_IS_READ_ONLY
SELECT f3();
DROP FUNCTION f3;
--echo # Reading is not restricted
SELECT COUNT(*) FROM mv2;
SELECT x FROM mv2 WHERE x = 2 FOR UPDATE;
SELECT x FROM mv2 WHERE x = 2 FOR SHARE;
LOCK TABLES mv2 READ;
SELECT COUNT(*) FROM mv2;
UNLOCK TABLES;
CREATE TABLE copy_of_mv2 AS SELECT * FROM mv2;
CREATE TABLE like_mv2 LIKE mv2;
INSERT INTO like_mv2 (x, y) VALUES (1, 'plain table');
ANALYZE TABLE mv2;
DROP TABLE copy_of_mv2, like_mv2;
--echo # The tables are as they were
SELECT * FROM mv2 ORDER BY x;
SELECT * FROM t2 ORDER BY id;
--echo # The base tables are changed and dropped freely
ALTER TABLE t2 ADD COLUMN c INT;
ALTER TABLE t2 DROP COLUMN c;

--echo #
--echo # DROP MATERIALIZED VIEW
--echo #
--error ER_MVIEW_NOT_A_MVIEW
DROP MATERIALIZED VIEW t1;
--error ER_MVIEW_NOT_A_MVIEW
DROP MATERIALIZED VIEW plain_v;
--error ER_MVIEW_NOT_A_MVIEW
DROP MATERIALIZED VIEW no_such;
--error ER_MVIEW_NOT_A_MVIEW
DROP MATERIALIZED VIEW IF EXISTS t1;
--echo # Nothing is dropped if a name is wrong
--error ER_MVIEW_NOT_A_MVIEW
DROP MATERIALIZED VIEW mv4, no_such;
SELECT COUNT(*) FROM mv4;
DROP MATERIALIZED VIEW IF EXISTS mv4, no_such, test.mv5;
DROP MATERIALIZED VIEW mv6;
SHOW TABLES;

--echo #
--echo # Privileges
--echo #
CREATE DATABASE mvdb;
CREATE TABLE mvdb.b1 (id INT PRIMARY KEY, a INT);
CREATE TABLE mvdb.secret (id INT PRIMARY KEY, s INT);
INSERT INTO mvdb.b1 VALUES (1, 1);
CREATE MATERIALIZED VIEW mvdb.mv_root REFRESH MANUAL AS SELECT id FROM mvdb.b1;
CREATE USER mvuser@localhost;
GRANT SELECT ON mvdb.b1 TO mvuser@localhost;
GRANT SELECT ON mvdb.mv_root TO mvuser@localhost;
connect (con_mv, localhost, mvuser,, test);
--echo # No CREATE, ALTER, DROP privilege
--error ER_TABLEACCESS_DENIED_ERROR
CREATE MATERIALIZED VIEW mvdb.mv8 AS SELECT id FROM mvdb.b1;
--error ER_TABLEACCESS_DENIED_ERROR
REFRESH MATERIALIZED VIEW mvdb.mv_root;
--error ER_TABLEACCESS_DENIED_ERROR
ALTER MATERIALIZED VIEW mvdb.mv_root REFRESH MANUAL;
--error ER_TABLEACCESS_DENIED_ERROR
DROP MATERIALIZED VIEW mvdb.mv_root;
connection default;
GRANT CREATE, ALTER, DROP ON mvdb.* TO mvuser@localhost;
connection con_mv;
--echo # No SELECT privilege on a base table
--error ER_TABLEACCESS_DENIED_ERROR
CREATE MATERIALIZED VIEW mvdb.mv8 AS SELECT id FROM mvdb.secret;
--error ER_TABLEACCESS_DENIED_ERROR
CREATE MATERIALIZED VIEW mvdb.mv8 AS
  SELECT b1.id FROM mvdb.b1 AS b1 JOIN mvdb.secret AS secret ON secret.id = b1.id;
--echo # CREATE on the schema and SELECT on the base tables
CREATE MATERIALIZED VIEW mvdb.mv8 REFRESH MANUAL AS SELECT id, a FROM mvdb.b1;
CREATE MATERIALIZED VIEW mvdb.mv9 REFRESH MANUAL AS SELECT COUNT(*) AS c FROM mvdb.b1;
--echo # The user who made the view does not read or write it for that
--error ER_TABLEACCESS_DENIED_ERROR
SELECT * FROM mvdb.mv8;
--error ER_TABLEACCESS_DENIED_ERROR
INSERT INTO mvdb.mv8 VALUES (1, 1);
REFRESH MATERIALIZED VIEW mvdb.mv8;
REFRESH MATERIALIZED VIEW mvdb.mv9;
ALTER MATERIALIZED VIEW mvdb.mv8 REFRESH SYNCHRONOUS;
DROP MATERIALIZED VIEW mvdb.mv8, mvdb.mv9;
connection default;
disconnect con_mv;
DROP USER mvuser@localhost;
DROP DATABASE mvdb;

--echo #
--echo # DROP DATABASE drops the materialized views of the database
--echo #
CREATE DATABASE mvdb;
CREATE TABLE mvdb.t (id INT PRIMARY KEY, g INT);
INSERT INTO mvdb.t VALUES (1, 1), (2, 1);
CREATE MATERIALIZED VIEW mvdb.mv_j AS SELECT id FROM mvdb.t;
CREATE MATERIALIZED VIEW mvdb.mv_a ENGINE=WARP AS
  SELECT g, COUNT(*) AS c FROM mvdb.t GROUP BY g;
USE mvdb;
SHOW TABLES;
SHOW CREATE VIEW mv_a;
SHOW CREATE VIEW test.mv2;
USE test;
DROP DATABASE mvdb;

--echo # The view of a table that is dropped is not refreshed any more
CREATE TABLE gone (id INT PRIMARY KEY);
CREATE MATERIALIZED VIEW mv9 REFRESH MANUAL AS SELECT id FROM gone;
DROP TABLE gone;
--error ER_NO_SUCH_TABLE
REFRESH MATERIALIZED VIEW mv9;
SELECT COUNT(*) FROM mv9;
DROP MATERIALIZED VIEW mv9;

DROP MATERIALIZED VIEW mv1, mv2, mv3;
DROP VIEW plain_v;
DROP FUNCTION f1;
DROP TEMPORARY TABLE tmp;
DROP TABLE t1, t2, nopk, uniq;
