--echo #
--echo # A table of a subquery is scanned again for every row of the query
--echo # around it.  The condition that was pushed down for it (and removed from
--echo # the filter of MySQL) must be applied by every scan, not only by the
--echo # first one, a subquery that uses the same table names as the query
--echo # around it must not share its conditions with it, and the join pushdown
--echo # (which scans every table once) must not be used in it.  Every query is
--echo # also run against InnoDB.
--echo #

CREATE TABLE pt (partkey INT, size INT) ENGINE=WARP
  DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE ps (partkey INT, suppkey INT, cost INT) ENGINE=WARP
  DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE su (suppkey INT, region INT) ENGINE=WARP
  DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE pt_i LIKE pt;
ALTER TABLE pt_i ENGINE=InnoDB;
CREATE TABLE ps_i LIKE ps;
ALTER TABLE ps_i ENGINE=InnoDB;
CREATE TABLE su_i LIKE su;
ALTER TABLE su_i ENGINE=InnoDB;

INSERT INTO pt VALUES (10, 15), (20, 15), (30, 15), (40, 7);
INSERT INTO su VALUES (1, 1), (2, 1), (3, 2), (4, 2), (5, 1);
INSERT INTO ps VALUES
  (10, 1, 500), (10, 3, 100), (10, 5, 300),
  (20, 2, 700), (20, 4, 50),
  (30, 1, 200), (30, 2, 200), (30, 3, 10),
  (40, 1, 5);
INSERT INTO pt_i SELECT * FROM pt;
INSERT INTO ps_i SELECT * FROM ps;
INSERT INTO su_i SELECT * FROM su;

--echo # the cheapest offer of every part among the suppliers of region 1
--echo # (the subquery reads ps and su, like the query around it)
--sorted_result
SELECT pt.partkey, ps.suppkey, ps.cost
  FROM pt, ps, su
 WHERE pt.partkey = ps.partkey AND ps.suppkey = su.suppkey
   AND su.region = 1 AND pt.size = 15
   AND ps.cost = (SELECT MIN(ps.cost) FROM ps, su
                   WHERE pt.partkey = ps.partkey AND ps.suppkey = su.suppkey
                     AND su.region = 1);
--sorted_result
SELECT pt_i.partkey, ps_i.suppkey, ps_i.cost
  FROM pt_i, ps_i, su_i
 WHERE pt_i.partkey = ps_i.partkey AND ps_i.suppkey = su_i.suppkey
   AND su_i.region = 1 AND pt_i.size = 15
   AND ps_i.cost = (SELECT MIN(ps_i.cost) FROM ps_i, su_i
                     WHERE pt_i.partkey = ps_i.partkey AND ps_i.suppkey = su_i.suppkey
                       AND su_i.region = 1);

--echo # a subquery that is evaluated once for every row of the query around it
--sorted_result
SELECT pt.partkey, (SELECT COUNT(*) FROM ps WHERE ps.partkey = pt.partkey AND ps.cost > 100) AS expensive
  FROM pt;
--sorted_result
SELECT pt_i.partkey, (SELECT COUNT(*) FROM ps_i WHERE ps_i.partkey = pt_i.partkey AND ps_i.cost > 100) AS expensive
  FROM pt_i;

--echo # an outer value that is NULL matches nothing
INSERT INTO pt VALUES (NULL, 15);
INSERT INTO pt_i VALUES (NULL, 15);
--sorted_result
SELECT pt.partkey, (SELECT COUNT(*) FROM ps WHERE ps.partkey = pt.partkey) AS offers FROM pt;
--sorted_result
SELECT pt_i.partkey, (SELECT COUNT(*) FROM ps_i WHERE ps_i.partkey = pt_i.partkey) AS offers FROM pt_i;

DROP TABLE pt, ps, su, pt_i, ps_i, su_i;
