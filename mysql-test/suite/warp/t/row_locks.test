--echo #
--echo # Row locks of reads: a transaction that holds a lock on a row and asks for
--echo # another kind of lock on it keeps the stronger one (it used to crash the
--echo # server), the locks of other transactions still conflict.
--echo #

call mtr.add_suppression("lock wait timeout");

CREATE TABLE t1 (id INT NOT NULL, v INT) ENGINE=WARP;
INSERT INTO t1 VALUES (1, 10), (2, 20), (3, 30), (4, 40);

--echo # FOR UPDATE, then LOCK IN SHARE MODE on the same rows
BEGIN;
SELECT * FROM t1 WHERE id <= 2 ORDER BY id FOR UPDATE;
SELECT * FROM t1 WHERE id <= 2 ORDER BY id LOCK IN SHARE MODE;
SELECT * FROM t1 WHERE id <= 2 ORDER BY id FOR UPDATE;
COMMIT;

--echo # LOCK IN SHARE MODE, then FOR UPDATE, then LOCK IN SHARE MODE
BEGIN;
SELECT * FROM t1 WHERE id >= 3 ORDER BY id LOCK IN SHARE MODE;
SELECT * FROM t1 WHERE id >= 3 ORDER BY id FOR UPDATE;
SELECT * FROM t1 WHERE id >= 3 ORDER BY id LOCK IN SHARE MODE;
COMMIT;

--echo # the same row is read twice by one statement
BEGIN;
SELECT a.id, b.id FROM t1 a JOIN t1 b ON a.id = b.id WHERE a.id = 1 FOR UPDATE;
COMMIT;

--echo # a locked row can be updated and deleted by the transaction
BEGIN;
SELECT * FROM t1 WHERE id = 1 FOR UPDATE;
SELECT * FROM t1 WHERE id = 1 LOCK IN SHARE MODE;
UPDATE t1 SET v = 11 WHERE id = 1;
SELECT * FROM t1 WHERE id = 2 LOCK IN SHARE MODE;
DELETE FROM t1 WHERE id = 2;
COMMIT;
SELECT * FROM t1 ORDER BY id;

--echo # Locks of other transactions
connect (other, localhost, root,,);
connection default;
BEGIN;
SELECT * FROM t1 WHERE id = 3 FOR UPDATE;

connection other;
SET SESSION warp_lock_wait_timeout = 1;
--echo # a row that is locked by the first transaction
--error ER_GET_ERRNO
SELECT * FROM t1 WHERE id = 3 FOR UPDATE;
--error ER_GET_ERRNO
SELECT * FROM t1 WHERE id = 3 LOCK IN SHARE MODE;
--echo # other rows are not locked
SELECT * FROM t1 WHERE id = 4 FOR UPDATE;
SELECT * FROM t1 WHERE id = 1 LOCK IN SHARE MODE;

connection default;
COMMIT;
connection other;
--echo # the lock is gone with the transaction
SELECT * FROM t1 WHERE id = 3 FOR UPDATE;
COMMIT;

--echo # shared locks of two transactions do not conflict
connection default;
BEGIN;
SELECT * FROM t1 WHERE id = 4 LOCK IN SHARE MODE;
connection other;
BEGIN;
SELECT * FROM t1 WHERE id = 4 LOCK IN SHARE MODE;
COMMIT;
connection default;
COMMIT;
disconnect other;

DROP TABLE t1;
